# 生产环境变量模板。真实文件 .env.prod 只保存在服务器上（已在 .gitignore 里排除），
# 绝不提交进仓库。docker-compose.prod.yml 里 api/ai-service/mysql/redis 四个容器共用
# 这一份文件，各自只会读取自己认识的变量名，互不影响。
#
# 不想手工填这些值：直接跑 scripts/deploy.sh，它会自动生成所有密钥/密码并交互式询问
# 业务相关的几项（租户名/门店名/管理员账号），生成好的 .env.prod 会自动落在这里。
# 完整的申请渠道/操作步骤见 docs/环境与密钥管理手册.md，这里只列变量本身。

# ---- 自建 MySQL（免费，容器跑在这台服务器上，不购买腾讯云托管数据库） ----
# 生产密码必须是随机生成的长字符串，不能用弱密码。生成方式：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=banyuexuan_prod
MYSQL_USER=banyuexuan
MYSQL_PASSWORD=

# ---- 自建 Redis（免费，同上） ----
REDIS_PASSWORD=

# ---- apps/api ----
PORT=3000
# 连接的是同一个docker网络里的 mysql/redis 服务名，不是公网地址。
# 注意：这里必须填写和上面 MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE/REDIS_PASSWORD
# 完全一致的实际值（不能写 ${MYSQL_USER} 这种引用——docker compose 的 env_file 不会展开
# 同一个文件内的变量引用，写引用语法会导致api连不上数据库）。scripts/deploy.sh 生成
# .env.prod 时会自动把这两行换成算好的真实值，你不用手工对齐。
DATABASE_URL=mysql://<和MYSQL_USER一致>:<和MYSQL_PASSWORD一致>@mysql:3306/<和MYSQL_DATABASE一致>
REDIS_URL=redis://:<和REDIS_PASSWORD一致>@redis:6379

# 生产密钥必须是随机生成的长字符串，不能沿用开发环境的 change-me
# 生成方式：openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL_DAYS=14

# 生产环境不使用 seed.ts 的演示账号体系，此变量在生产不生效/不需要设置
# SEED_DEV_PASSWORD=

# 首次上线建管理员账号用（见 docs/生产数据库迁移与种子数据策略.md）。
# scripts/deploy.sh 会交互式询问这几项并自动写在这里，方便你后续重新跑seed时不用再手填。
# 六个变量缺一个都不行；SEED_ADMIN_PASSWORD 长度必须≥12位且不能是开发默认密码。
SEED_TENANT_CODE=
SEED_TENANT_NAME=
SEED_STORE_CODE=
SEED_STORE_NAME=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# 同网络内 ai-service 的服务名地址（docker-compose 内部DNS，不是公网地址）
AI_GATEWAY_BASE_URL=http://ai-service:8000
# 服务间共享密钥：api 和 ai-service 这一项必须填相同的值，且生产环境不能留空
# （留空=不校验，等同于对内网任何能访问到ai-service:8000的调用方都放行）
AI_GATEWAY_INTERNAL_API_KEY=

# 生产环境明确禁用 Swagger 接口文档对外暴露（见 main.ts 里对 NODE_ENV 的判断）
NODE_ENV=production

# 允许跨域访问的前端源，逗号分隔；留空=不启用CORS（默认架构是web容器nginx同源反代到api，
# 不需要CORS）。只有当你把前端部署在与api不同的域名/端口下时才需要填
CORS_ALLOWED_ORIGINS=

# ---- apps/ai-service ----
# production 时若 INTERNAL_API_KEY 留空，服务会拒绝启动（见 main.py 的启动校验）
ENVIRONMENT=production
# 与上面 AI_GATEWAY_INTERNAL_API_KEY 保持完全一致
INTERNAL_API_KEY=

# 取值 volcengine / minimax / deepseek，只会用到已经配了对应Key的供应商——
# 某个供应商Key留空就自动跳过，不用三个都配全，配一个能用的就行。
PRIMARY_PROVIDER=volcengine
FALLBACK_PROVIDER=deepseek

# 火山引擎方舟(Ark)：母婴健康数据不允许出境，只接入境内合规供应商
# 留空也能正常部署——AI客服/异常预警建议会优雅降级提示"服务暂时不可用"，不影响其他功能。
# 想用上AI功能再回来填，填完 docker compose --env-file .env.prod up -d 重启一下ai-service即可生效。
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_ENDPOINT_ID=
VOLCENGINE_EMBEDDING_ENDPOINT_ID=
# 方舟“按量计费”下读图/读视频用的模型（推理接入点 ID ep-xxxx 或模型名称，要选支持图片理解的多模态模型）。
# 配好后拍照识别（合同/护理表格）优先走这里，不再用下面的 Agent Plan；视频模型不填则与读图同一个。
VOLCENGINE_VISION_MODEL=
VOLCENGINE_VIDEO_MODEL=

# MiniMax（备用供应商）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=abab6.5s-chat
MINIMAX_EMBEDDING_MODEL=embo-01

# DeepSeek（备用供应商，只提供对话模型，没有embedding接口——RAG知识库检索还是要靠
# 火山引擎/MiniMax，AI客服/护理异常建议这类纯对话场景用DeepSeek完全没问题）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 读图识别（合同照片、护理评估表/日常记录单/用药委托书拍照识别）走火山引擎 Agent Plan 专属通道，
# 与上面 VOLCENGINE_API_KEY 是两套不同的密钥。留空 = 拍照识别功能不可用（页面提示“AI 服务暂时不可用”），
# 手工录入、其余功能完全不受影响。注意：Agent Plan 官方定位是编程工具套餐，正式长期使用建议换成方舟按量计费密钥。
VOLCENGINE_PLAN_API_KEY=
VOLCENGINE_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
VOLCENGINE_PLAN_MODEL=doubao-seed-2-0-code-preview-260215
