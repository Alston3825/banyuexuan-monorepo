# 生产环境变量模板。真实文件 .env.prod 只保存在服务器上（已在 .gitignore 里排除），
# 绝不提交进仓库。docker-compose.prod.yml 里 api 和 ai-service 两个容器共用这一份文件，
# 各自只会读取自己认识的变量名，互不影响。
#
# 完整的申请渠道/操作步骤见 docs/环境与密钥管理手册.md，这里只列变量本身。

# ---- apps/api ----
PORT=3000
# 腾讯云数据库 MySQL 内网连接串（同地域VPC内网访问，不要用公网地址+公网密码）
DATABASE_URL=mysql://<db_user>:<db_password>@<mysql内网地址>:3306/banyuexuan_prod
# 腾讯云 Redis 内网连接串
REDIS_URL=redis://:<redis_password>@<redis内网地址>:6379

# 生产密钥必须是随机生成的长字符串，不能沿用开发环境的 change-me
# 生成方式：openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL_DAYS=14

# 生产环境不使用 seed.ts 的演示账号体系，此变量在生产不生效/不需要设置
# SEED_DEV_PASSWORD=

# 同网络内 ai-service 的服务名地址（docker-compose 内部DNS，不是公网地址）
AI_GATEWAY_BASE_URL=http://ai-service:8000
# 服务间共享密钥：api 和 ai-service 这一项必须填相同的值，且生产环境不能留空
# （留空=不校验，等同于对内网任何能访问到ai-service:8000的调用方都放行）
AI_GATEWAY_INTERNAL_API_KEY=

# 生产环境明确禁用 Swagger 接口文档对外暴露（见 main.ts 里对 NODE_ENV 的判断）
NODE_ENV=production

# 允许跨域访问的前端源，逗号分隔；留空=不启用CORS（默认架构是web容器nginx同源反代到api，
# 不需要CORS）。只有当你把前端部署在与api不同的域名/端口下时才需要填
CORS_ALLOWED_ORIGINS=

# ---- apps/ai-service ----
# production 时若 INTERNAL_API_KEY 留空，服务会拒绝启动（见 main.py 的启动校验）
ENVIRONMENT=production
# 与上面 AI_GATEWAY_INTERNAL_API_KEY 保持完全一致
INTERNAL_API_KEY=

PRIMARY_PROVIDER=volcengine
FALLBACK_PROVIDER=minimax

# 火山引擎方舟(Ark)：母婴健康数据不允许出境，只接入境内合规供应商
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_ENDPOINT_ID=
VOLCENGINE_EMBEDDING_ENDPOINT_ID=

# MiniMax（备用供应商）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=abab6.5s-chat
MINIMAX_EMBEDDING_MODEL=embo-01
