// 伴月轩月子中心管理系统 — P0 平台底座数据模型
// 命名约定：Prisma 侧用 camelCase，通过 @map/@@map 落到 snake_case 列名，
// 遵循《新系统开发文档》"关键原则"：tenant_id/store_id/created_by/created_at/updated_at/version。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 平台域 ====================

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// 租户：伴月轩当前只有一个租户，不建管理 CRUD API，仅由 seed 脚本创建。
model Tenant {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  @@map("tenants")
}

enum CommonStatus {
  ACTIVE
  INACTIVE
}

model Region {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  code      String
  name      String
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  stores Store[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("regions")
}

enum StoreStatus {
  PENDING
  ACTIVE
  CLOSED
}

model Store {
  id        String      @id @default(cuid())
  tenantId  String      @map("tenant_id")
  regionId  String      @map("region_id")
  code      String
  name      String
  address   String?
  /// 工号规则：该门店员工工号必须以此开头（如 高新店 1、枣园店 2）；空 = 不限制
  employeeNoPrefix String? @map("employee_no_prefix")
  status    StoreStatus @default(PENDING)
  createdBy String      @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  version   Int         @default(0)

  region                  Region                   @relation(fields: [regionId], references: [id])
  departments             Department[]
  teams                   Team[]
  accounts                Account[]
  customers               Customer[]
  leads                   Lead[]
  contracts               Contract[]
  rooms                   Room[]
  roomOccupancies         RoomOccupancy[]
  payments                Payment[]
  motherProfiles          MotherProfile[]
  babyProfiles            BabyProfile[]
  carePlans               CarePlan[]
  careRecords             CareRecord[]
  careAbnormalities       CareAbnormality[]
  roomCalls               RoomCall[]
  roomOutings             RoomOuting[]
  roomServiceRequisitions RoomServiceRequisition[]
  dinerProfiles           DinerProfile[]
  mealRecords             MealRecord[]
  customerServicePackages CustomerServicePackage[]
  therapists              Therapist[]
  serviceAppointments     ServiceAppointment[]
  warehouses              Warehouse[]
  purchaseOrders          PurchaseOrder[]
  purchaseRequests        PurchaseRequest[]
  goodsReceipts           GoodsReceipt[]
  stockIssues             StockIssue[]
  stockCounts             StockCount[]
  shiftDefinitions        ShiftDefinition[]
  scheduleEntries         ScheduleEntry[]
  commissionRecords       CommissionRecord[]
  payrollRecords          PayrollRecord[]
  leaveRequests           LeaveRequest[]
  expenseClaims           ExpenseClaim[]
  generalMemos            GeneralMemo[]
  vehicleBookings         VehicleBooking[]
  utilityExpenses         UtilityExpense[]
  aiSuggestions           AiSuggestion[]
  devices                 Device[]
  deviceEvents            DeviceEvent[]
  deviceConnectionLogs    DeviceConnectionLog[]
  careOutreachPlans       CareOutreachPlan[]
  careOutreachTasks       CareOutreachTask[]

  @@unique([tenantId, code])
  @@index([tenantId, regionId])
  @@map("stores")
}

model Department {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  storeId   String?      @map("store_id") // null = 总部/跨店部门
  parentId  String?      @map("parent_id")
  code      String
  name      String
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  store    Store?       @relation(fields: [storeId], references: [id])
  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children Department[] @relation("DeptTree")
  teams    Team[]
  accounts Account[]

  @@unique([tenantId, code])
  @@index([tenantId, storeId])
  @@map("departments")
}

model Team {
  id           String       @id @default(cuid())
  tenantId     String       @map("tenant_id")
  storeId      String?      @map("store_id") // 从部门冗余，便于按店查询
  departmentId String       @map("department_id")
  code         String
  name         String
  status       CommonStatus @default(ACTIVE)
  createdBy    String       @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  version      Int          @default(0)

  store      Store?     @relation(fields: [storeId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  accounts   Account[]

  @@unique([departmentId, code])
  @@index([tenantId, storeId])
  @@map("teams")
}

model Position {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  code      String
  name      String
  rank      Int?
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  accounts Account[]

  @@unique([tenantId, code])
  @@map("positions")
}

enum AccountStatus {
  ACTIVE
  DISABLED
  LOCKED
}

model Account {
  id                 String        @id @default(cuid())
  tenantId           String        @map("tenant_id")
  storeId            String?       @map("store_id") // 主门店，总部账号可为空
  departmentId       String?       @map("department_id")
  teamId             String?       @map("team_id")
  positionId         String?       @map("position_id")
  username           String
  phone              String? // 敏感字段，见 FieldMaskInterceptor
  email              String?
  passwordHash       String        @map("password_hash")
  /// 电子签名图（PNG 的 data URL，员工自己在“我的电子签名”里录入一次，护理档案签字时选用）
  signatureData      String?       @map("signature_data") @db.MediumText
  signatureUpdatedAt DateTime?     @map("signature_updated_at")
  realName           String        @map("real_name")
  status             AccountStatus @default(ACTIVE)
  lastLoginAt        DateTime?     @map("last_login_at")
  createdBy          String        @map("created_by")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  version            Int           @default(0)

  store                  Store?                  @relation(fields: [storeId], references: [id])
  department             Department?             @relation(fields: [departmentId], references: [id])
  team                   Team?                   @relation(fields: [teamId], references: [id])
  position               Position?               @relation(fields: [positionId], references: [id])
  roleAssignments        AccountRoleAssignment[]
  refreshTokens          RefreshToken[]
  assignedCustomers      Customer[]              @relation("CustomerStoreSales")
  phoneSalesCustomers    Customer[]              @relation("CustomerPhoneSales")
  assignedLeads          Lead[]
  assignedOpportunities  SalesOpportunity[]
  employeeProfile        EmployeeProfile?
  expenseClaims          ExpenseClaim[]
  generalMemos           GeneralMemo[]
  vehicleBookings        VehicleBooking[]
  acceptedAiSuggestions  AiSuggestion[]
  examAttempts           ExamAttempt[]           @relation("ExamAttemptAccount")
  gradedExamAttempts     ExamAttempt[]           @relation("ExamAttemptGradedBy")
  signedContracts        Contract[]              @relation("ContractSigner")
  completedOutreachTasks CareOutreachTask[]
  devices                StaffDevice[]
  careDailySignatures    CareDailySignature[]
  nursedMotherProfiles   MotherProfile[]         @relation("MotherPrimaryNurse")

  @@unique([tenantId, username])
  @@unique([tenantId, phone])
  @@index([tenantId, storeId])
  @@map("accounts")
}

model Role {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  code        String
  name        String
  description String?
  isSystem    Boolean      @default(false) @map("is_system") // 内置角色不可删除
  status      CommonStatus @default(ACTIVE)
  createdBy   String       @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  version     Int          @default(0)

  permissions RoleOnPermission[]
  assignments AccountRoleAssignment[]

  @@unique([tenantId, code])
  @@map("roles")
}

enum PermissionPointType {
  MODULE
  PAGE
  BUTTON
  FIELD
}

/// RBAC 四级权限目录：模块/页面/按钮/字段，全局系统目录（非租户隔离），由 seed 脚本维护。
model PermissionPoint {
  id            String              @id @default(cuid())
  applicationId String?             @map("application_id")
  parentId      String?             @map("parent_id")
  type          PermissionPointType
  code          String              @unique
  name          String
  isSensitive   Boolean             @default(false) @map("is_sensitive")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  application Application?       @relation(fields: [applicationId], references: [id])
  parent      PermissionPoint?   @relation("PermTree", fields: [parentId], references: [id])
  children    PermissionPoint[]  @relation("PermTree")
  roles       RoleOnPermission[]

  @@map("permission_points")
}

model RoleOnPermission {
  id                String   @id @default(cuid())
  roleId            String   @map("role_id")
  permissionPointId String   @map("permission_point_id")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  role            Role            @relation(fields: [roleId], references: [id])
  permissionPoint PermissionPoint @relation(fields: [permissionPointId], references: [id])

  @@unique([roleId, permissionPointId])
  @@map("role_permissions")
}

enum DataScopeType {
  TENANT
  REGION
  STORE
  DEPARTMENT
  TEAM
  SELF
}

/// 数据范围授权：账号-角色绑定携带 scope，跨店查询/执行需要独立的一条授权记录。
model AccountRoleAssignment {
  id        String        @id @default(cuid())
  tenantId  String        @map("tenant_id")
  accountId String        @map("account_id")
  roleId    String        @map("role_id")
  scopeType DataScopeType @map("scope_type")
  scopeId   String?       @map("scope_id") // TENANT/SELF 时为空
  grantedBy String        @map("granted_by")
  grantedAt DateTime      @default(now()) @map("granted_at")
  expiresAt DateTime?     @map("expires_at")
  revokedAt DateTime?     @map("revoked_at")

  account Account @relation(fields: [accountId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@index([accountId])
  @@index([tenantId, scopeType, scopeId])
  @@map("account_role_assignments")
}

enum ApplicationType {
  WEB
  MOBILE
  OPENAPI
}

model Application {
  id        String          @id @default(cuid())
  tenantId  String?         @map("tenant_id") // null = 平台级应用
  code      String          @unique
  name      String
  type      ApplicationType
  status    CommonStatus    @default(ACTIVE)
  createdBy String          @map("created_by")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  version   Int             @default(0)

  permissionPoints PermissionPoint[]

  @@map("applications")
}

model Tag {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  color     String?
  category  String?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(0)

  bindings TagBinding[]

  @@unique([tenantId, name])
  @@map("tags")
}

/// 多态挂接：标签可打在任意未来实体上（entityType + entityId）。
model TagBinding {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  tagId      String    @map("tag_id")
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  // 换标签时不物理删除旧绑定、只标记撤销时间——客户分类/类型标签这类"会随时间变化、
  // 且需要能汇总统计变动记录"的场景（业务规则确认记录"客户标签设计"一节）依赖这个字段
  // 重建历史：null=当前生效，非null=这条绑定在什么时候被换掉了。通用的一次性打标场景
  // （不需要历史）可以继续硬删，两种用法并存，不强制。
  revokedAt  DateTime? @map("revoked_at")

  tag Tag @relation(fields: [tagId], references: [id])

  // 之前这里有 @@unique([tagId, entityType, entityId])：加了revokedAt保留历史之后就不能再
  // 用了——同一个标签换出去再换回来（比如客户从A类改成B类，之后又改回A类）会撞到这个唯一
  // 约束（旧的那条A类绑定revokedAt非空但tuple没变）。改成应用层保证"同一分类同一时刻只有
  // 一条revokedAt为null的生效绑定"，见 TagService.setExclusiveTag()。
  @@index([entityType, entityId])
  @@index([tagId, entityType, entityId, revokedAt])
  @@map("tag_bindings")
}

enum ParameterValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model Parameter {
  id          String             @id @default(cuid())
  tenantId    String?            @map("tenant_id") // null = 全局系统默认值
  storeId     String?            @map("store_id") // 非空覆盖到店级
  key         String
  value       String             @db.Text
  valueType   ParameterValueType @default(STRING) @map("value_type")
  description String?
  isSystem    Boolean            @default(false) @map("is_system")
  createdBy   String             @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  version     Int                @default(0)

  // 注意：MySQL 唯一索引中 NULL 不互斥，(tenantId=X, storeId=NULL, key=K) 理论上可重复插入；
  // ParameterService 在应用层做"先查后插"兜底校验，不完全依赖数据库唯一约束。
  @@unique([tenantId, storeId, key])
  @@map("parameters")
}

// ==================== 审计 ====================

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  CREATE
  UPDATE
  DELETE
  VOID
  STATE_TRANSITION
  APPROVE
  REJECT
  WITHDRAW
  REASSIGN
  ADD_APPROVER
  CC
  ARCHIVE
  SENSITIVE_QUERY
  EXPORT
  PRINT
}

/// 只增不改：不提供 update/delete 方法，关键记录只允许冲正/作废，符合审计总则。
model AuditLog {
  id            String      @id @default(cuid())
  tenantId      String?     @map("tenant_id") // 登录失败等无租户上下文场景可为空
  storeId       String?     @map("store_id")
  accountId     String?     @map("account_id")
  action        AuditAction
  entityType    String      @map("entity_type")
  entityId      String?     @map("entity_id")
  beforeData    Json?       @map("before_data")
  afterData     Json?       @map("after_data")
  changedFields Json?       @map("changed_fields")
  ip            String?
  userAgent     String?     @map("user_agent")
  requestId     String?     @map("request_id")
  result        String      @default("SUCCESS")
  remark        String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([accountId, createdAt])
  @@map("audit_logs")
}

// ==================== 工作流引擎骨架 ====================

enum WorkflowDefStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

model WorkflowDefinition {
  id        String            @id @default(cuid())
  tenantId  String            @map("tenant_id")
  code      String // 业务场景 key，如 "DEMO_APPROVAL"
  name      String
  version   Int               @default(1)
  status    WorkflowDefStatus @default(PUBLISHED)
  createdBy String            @map("created_by")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  nodes     WorkflowNode[]
  instances WorkflowInstance[]

  @@unique([tenantId, code, version])
  @@map("workflow_definitions")
}

enum WorkflowNodeApproverType {
  ROLE
  ACCOUNT
}

/// 节点审批方式：ALL=会签（节点上所有审批人都通过才进入下一节点）；ANY=或签（任意一人通过即可）
enum WorkflowApprovalMode {
  ALL
  ANY
}

/// 顺序审批节点定义。
model WorkflowNode {
  id                   String                   @id @default(cuid())
  workflowDefinitionId String                   @map("workflow_definition_id")
  seq                  Int
  name                 String
  approverType         WorkflowNodeApproverType @map("approver_type")
  approverRoleId       String?                  @map("approver_role_id")
  /// 指定多个角色：角色 id 数组（角色成员 + 指定员工 都算审批人）；approverRoleId 存第一个，兼容旧数据
  approverRoleIds      Json?                    @map("approver_role_ids")
  approverAccountId    String?                  @map("approver_account_id")
  /// 指定多位员工（或签选 2~3 人、会签几人都要过）：员工 id 数组；approverAccountId 存第一位，兼容旧数据
  approverAccountIds   Json?                    @map("approver_account_ids")
  approvalMode         WorkflowApprovalMode     @default(ALL) @map("approval_mode")
  /// 处理时限（小时）：审批人收到待办后超过这个时间算“超时”，在待办里标红提醒；空=不限时
  timeoutHours         Int?                     @map("timeout_hours")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  definition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])

  @@unique([workflowDefinitionId, seq])
  @@map("workflow_nodes")
}

enum WorkflowInstanceStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  ARCHIVED
}

/// businessType/businessId 泛化挂接任意业务单据，P1+ 真实单据复用同一引擎无需改动。
model WorkflowInstance {
  id                   String                 @id @default(cuid())
  tenantId             String                 @map("tenant_id")
  storeId              String?                @map("store_id")
  workflowDefinitionId String                 @map("workflow_definition_id")
  businessType         String                 @map("business_type")
  businessId           String                 @map("business_id")
  title                String
  status               WorkflowInstanceStatus @default(DRAFT)
  currentNodeSeq       Int?                   @map("current_node_seq")
  initiatorId          String                 @map("initiator_id")
  submittedAt          DateTime?              @map("submitted_at")
  finishedAt           DateTime?              @map("finished_at")
  createdBy            String                 @map("created_by")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  version              Int                    @default(0)

  definition WorkflowDefinition         @relation(fields: [workflowDefinitionId], references: [id])
  approvers  WorkflowInstanceApprover[]
  actions    WorkflowActionLog[]

  @@index([tenantId, businessType, businessId])
  @@index([status])
  @@map("workflow_instances")
}

enum WorkflowApproverRole {
  APPROVER
  ADDED_APPROVER
  CC
}

enum WorkflowApproverStatus {
  PENDING
  APPROVED
  REJECTED
  REASSIGNED
  SKIPPED
  NOTIFIED
}

/// 单表覆盖：普通审批人 / 加签 / 抄送 / 转交链（reassignedFromId 指向被转交的原记录）。
model WorkflowInstanceApprover {
  id                 String                 @id @default(cuid())
  workflowInstanceId String                 @map("workflow_instance_id")
  nodeSeq            Int                    @map("node_seq")
  accountId          String                 @map("account_id")
  role               WorkflowApproverRole   @default(APPROVER)
  status             WorkflowApproverStatus @default(PENDING)
  comment            String?                @db.Text
  actedAt            DateTime?              @map("acted_at")
  reassignedFromId   String?                @map("reassigned_from_id")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  instance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id])

  @@index([workflowInstanceId, nodeSeq])
  @@index([accountId, status])
  @@map("workflow_instance_approvers")
}

enum WorkflowAction {
  SUBMIT
  APPROVE
  REJECT
  WITHDRAW
  REASSIGN
  ADD_APPROVER
  CC
  ARCHIVE
  URGE
}

/// 审批时间线，供后续 UI 展示；每次动作同时写一份摘要进 AuditLog。
model WorkflowActionLog {
  id                 String         @id @default(cuid())
  workflowInstanceId String         @map("workflow_instance_id")
  nodeSeq            Int?           @map("node_seq")
  actorId            String         @map("actor_id")
  action             WorkflowAction
  comment            String?        @db.Text
  createdAt          DateTime       @default(now()) @map("created_at")

  instance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id])

  @@index([workflowInstanceId, createdAt])
  @@map("workflow_action_logs")
}

// ==================== 认证 ====================

model RefreshToken {
  id        String    @id @default(cuid())
  accountId String    @map("account_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("refresh_tokens")
}

// ==================== 工作流引擎示例业务实体 ====================

/// P0 专用最小审批业务实体，仅用于验证工作流引擎骨架端到端可用；
/// P1+ 真实单据（合同/收款等）复用同一 WorkflowEngineService，不需要为每种业务再写一套状态机。
model DemoApprovalRequest {
  id          String                 @id @default(cuid())
  tenantId    String                 @map("tenant_id")
  storeId     String?                @map("store_id")
  title       String
  content     String                 @db.Text
  amount      Int? // 最小货币单位（分）
  applicantId String                 @map("applicant_id")
  status      WorkflowInstanceStatus @default(DRAFT)
  createdBy   String                 @map("created_by")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  version     Int                    @default(0)

  @@map("demo_approval_requests")
}

// ==================== CRM：客户与线索管理 ====================

enum CustomerSource {
  WALK_IN // 自然到店
  REFERRAL // 转介绍
  ONLINE_AD // 线上广告投放
  SOCIAL_MEDIA // 社交媒体/私域
  PARTNER // 渠道合作
  OTHER
}

enum LeadStatus {
  NEW
  ASSIGNED
  FOLLOWING
  CONVERTED
  LOST
}

enum OpportunityStage {
  FOLLOWING
  QUOTED
  WON
  LOST
}

enum FollowUpType {
  PHONE_CALL
  WECHAT
  SMS
  ON_SITE_VISIT
  INVITATION // 邀约到店
  OTHER
}

/// 客户主数据：租户全局共享，不做门店级数据隔离（已与业务方确认）。
/// primaryStoreId 仅用于展示/报表（首次建档门店），不参与任何权限范围过滤。
/// 字段保持最小化——合同/收款/房态预订等 P1 后续切片会引用 Customer.id，
/// 但不因为它们而预先在这里加字段，那些模块的专属数据放在各自的表里。
model Customer {
  id                       String         @id @default(cuid())
  tenantId                 String         @map("tenant_id")
  customerNo               String         @map("customer_no")
  name                     String
  phone                    String // 敏感字段，见 FieldMaskInterceptor + SENSITIVE_FIELD_REGISTRY.Customer
  source                   CustomerSource @default(WALK_IN)
  primaryStoreId           String?        @map("primary_store_id") // 首次建档门店，仅展示/报表用途
  assignedToId             String?        @map("assigned_to_id") // 当前归属销售，无保护期/锁定机制
  // 以下几项是"新建客户表格内容不完整"这轮补的（业务规则确认记录"客户档案表单扩展"一节）：
  // 参考了行业同类系统的建档字段，但没有照单全收——身份证号/HIS登记号/亲属信息/客户分配
  // 这类字段本轮没加，理由见确认记录。客户分类标签(A-E)/客户类型标签(鹰派萌派等)不在这里，
  // 走的是已有的 Tag/TagBinding 多态标签系统（后台"标签管理"可配置，变更历史靠
  // TagBinding.revokedAt 保留，不是这个表的字段）。
  wechat                   String?        @map("wechat") // 同手机号，二者不能同时为空由应用层校验
  serviceTypes             Json?          @map("service_types") // 客户类型(多选)：月子房/月嫂上户/月子餐外送/产康/宝宝托管，见CUSTOMER_SERVICE_TYPES
  hospital                 String?        @map("hospital") // 建卡/产检医院
  idCardNo                 String?        @map("id_card_no") // 身份证号（来自纸质合同，测试阶段按普通信息处理，不打码）
  emergencyContactName     String?        @map("emergency_contact_name")
  emergencyContactRelation String?        @map("emergency_contact_relation")
  emergencyContactPhone    String?        @map("emergency_contact_phone")
  // —— 2026-10 "新建客户页面按行业系统改版"新增的字段 ——
  birthday                 DateTime?      @map("birthday") @db.Date // 妈妈生日，填身份证时自动算出，可手改
  zone                     String?        @map("zone") // 片区（如 陆家嘴、世博小区），先用自由文本，以后可升级成基础资料
  hisNo                    String?        @map("his_no") // HIS 登记号（医院信息系统）
  passportNo               String?        @map("passport_no") // 国际证件号（护照等，没有身份证的外籍/港澳台客户）
  registeredAt             DateTime       @default(now()) @map("registered_at") // 添加时间：默认当前，可手改（补录历史客户时用），和 createdAt（记录入库时间）分开
  ccAccountIds             Json?          @map("cc_account_ids") // 抄送人（员工账号 id 数组）；系统暂无站内通知，目前只记录和展示
  channelTypeId            String?        @map("channel_type_id") // 渠道类型（可自定义，见 CustomerChannelType）；上面的 source 是它的"旧版 6 类"归并值，自定义类型一律记 OTHER
  channelId                String?        @map("channel_id") // 具体渠道，属于 channelTypeId 这个类型
  referrerType             ReferrerType?  @map("referrer_type")
  referrerId               String?        @map("referrer_id") // 推荐人：老客户或员工，按 referrerType 指向 Customer / Account（多态，不建外键）
  phoneSalesId             String?        @map("phone_sales_id") // 电话销售员；门店销售员沿用 assignedToId（归属销售）
  expectedDueDate          DateTime?      @map("expected_due_date") // 预产期
  region                   String?        @map("region") // 地区，自由文本（省市区），暂不做级联下拉
  address                  String?        @db.Text
  remark                   String?        @db.Text
  /// 归档：用过的客户（有合同/入住/收款等）不能删，只能归档——列表默认隐藏、不能再新建预订/合同，可随时恢复
  archivedAt               DateTime?      @map("archived_at")
  archivedBy               String?        @map("archived_by")
  archiveReason            String?        @map("archive_reason")
  createdBy                String         @map("created_by")
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")
  version                  Int            @default(0)

  primaryStore            Store?                   @relation(fields: [primaryStoreId], references: [id])
  assignedTo              Account?                 @relation("CustomerStoreSales", fields: [assignedToId], references: [id])
  phoneSales              Account?                 @relation("CustomerPhoneSales", fields: [phoneSalesId], references: [id])
  channelType             CustomerChannelType?     @relation(fields: [channelTypeId], references: [id])
  channel                 CustomerChannel?         @relation(fields: [channelId], references: [id])
  leads                   Lead[]
  opportunities           SalesOpportunity[]
  contracts               Contract[]
  roomOccupancies         RoomOccupancy[]
  payments                Payment[]
  motherProfiles          MotherProfile[]
  babyProfiles            BabyProfile[]
  dinerProfiles           DinerProfile[]
  customerServicePackages CustomerServicePackage[]
  serviceAppointments     ServiceAppointment[]
  account                 CustomerAccount?

  @@unique([tenantId, customerNo])
  @@index([tenantId, assignedToId])
  @@index([tenantId, primaryStoreId])
  @@index([tenantId, phone])
  @@index([tenantId, channelId])
  @@index([tenantId, channelTypeId])
  @@index([tenantId, phoneSalesId])
  @@map("customers")
}

enum ReferrerType {
  CUSTOMER
  ACCOUNT
}

/// 渠道类型（可自定义）。系统初始带 6 个内置类型（legacySource 记着它对应旧枚举，线索转客户、
/// 报表等沿用旧枚举的地方靠它换算），用户可以再加自己的类型、给任何类型改名/停用。
model CustomerChannelType {
  id           String          @id @default(cuid())
  tenantId     String          @map("tenant_id")
  name         String
  legacySource CustomerSource? @map("legacy_source") // 内置类型才有；自定义类型为空
  sortOrder    Int             @default(0) @map("sort_order")
  status       CommonStatus    @default(ACTIVE)
  createdBy    String          @map("created_by")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  version      Int             @default(0)

  channels  CustomerChannel[]
  customers Customer[]

  @@unique([tenantId, name])
  @@unique([tenantId, legacySource])
  @@map("customer_channel_types")
}

/// 具体渠道（某个渠道类型下面可维护的渠道，如 线上广告 > 小红书 / 渠道合作 > 某医院）。
/// 客户通过 channelId 指向这里。
model CustomerChannel {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  typeId    String       @map("type_id")
  name      String
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  type      CustomerChannelType @relation(fields: [typeId], references: [id])
  customers Customer[]

  @@unique([tenantId, typeId, name])
  @@map("customer_channels")
}

/// 线索：NEW -> ASSIGNED -> FOLLOWING -> CONVERTED；LOST 可从 NEW/ASSIGNED/FOLLOWING 到达。
/// 同时承载"客户预约"登记：客户从登记到跟进的流程节点统计需要的字段（预约类型、到店时间、
/// 处理状态、处理结果等）都挂在这张表上，见下面 appointment 开头和 process 开头的那些字段——
/// 跟 status（NEW/ASSIGNED 等）是两套互不干扰的状态：status 管线索转化生命周期，
/// processed/processResults 管这条预约有没有人工跟进处理过、处理出了什么结果。
model Lead {
  id           String         @id @default(cuid())
  tenantId     String         @map("tenant_id")
  leadNo       String         @map("lead_no")
  name         String
  phone        String
  source       CustomerSource @default(WALK_IN)
  storeId      String?        @map("store_id") // 线索录入门店，仅展示用途，不做范围过滤
  status       LeadStatus     @default(NEW)
  assignedToId String?        @map("assigned_to_id") // 处理人/母婴顾问
  customerId   String?        @map("customer_id") // 关联客户：转化时自动回填，也允许人工提前关联到已有客户档案
  lostReason   String?        @map("lost_reason") @db.Text
  remark       String?        @db.Text

  appointmentType LeadAppointmentType? @map("appointment_type") // 预约类型：预约参观/预约试餐
  appointmentTime DateTime?            @map("appointment_time") // 预约到店时间
  appointmentNote String?              @map("appointment_note") @db.Text // 预约说明
  processed       Boolean              @default(false) @map("processed") // 处理状态：未处理(false,红)/已处理(true,绿)
  processResults  Json?                @map("process_results") // 处理结果，多选：见 LEAD_PROCESS_RESULTS 常量
  handleRemark    String?              @map("handle_remark") @db.Text // 处理说明

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(0)

  store         Store?             @relation(fields: [storeId], references: [id])
  assignedTo    Account?           @relation(fields: [assignedToId], references: [id])
  customer      Customer?          @relation(fields: [customerId], references: [id])
  opportunities SalesOpportunity[]

  @@unique([tenantId, leadNo])
  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@index([tenantId, storeId])
  @@map("leads")
}

enum LeadAppointmentType {
  VISIT // 预约参观
  TRIAL_MEAL // 预约试餐
}

/// 销售机会：FOLLOWING -> QUOTED -> WON；LOST 可从 FOLLOWING/QUOTED 到达，WON 为终态不可转 LOST。
/// leadId 可空——允许无原始线索的机会（如老客户加购/转介绍直接开单）。
model SalesOpportunity {
  id            String           @id @default(cuid())
  tenantId      String           @map("tenant_id")
  opportunityNo String           @map("opportunity_no")
  customerId    String           @map("customer_id")
  leadId        String?          @map("lead_id")
  stage         OpportunityStage @default(FOLLOWING)
  amount        Int? // 意向金额，最小货币单位（分）
  assignedToId  String?          @map("assigned_to_id")
  lostReason    String?          @map("lost_reason") @db.Text
  remark        String?          @db.Text
  createdBy     String           @map("created_by")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  version       Int              @default(0)

  customer   Customer   @relation(fields: [customerId], references: [id])
  lead       Lead?      @relation(fields: [leadId], references: [id])
  assignedTo Account?   @relation(fields: [assignedToId], references: [id])
  contracts  Contract[]

  @@unique([tenantId, opportunityNo])
  @@index([tenantId, stage])
  @@index([tenantId, customerId])
  @@index([tenantId, assignedToId])
  @@map("sales_opportunities")
}

/// 跟进/邀约记录：多态挂接（businessType/businessId），镜像 WorkflowInstance 的
/// businessType/businessId 命名与设计——不建三个可空外键，未来新增可跟进的实体
/// （如合同回访）无需改表结构。这是只增不改的日志类实体（没有 version/updatedAt），
/// 与 WorkflowActionLog 保持同一建模风格，而非套用"每个业务模型都有 version"的模板。
model FollowUpRecord {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  businessType   String       @map("business_type") // 'LEAD' | 'OPPORTUNITY' | 'CUSTOMER'
  businessId     String       @map("business_id")
  type           FollowUpType
  content        String       @db.Text
  nextFollowUpAt DateTime?    @map("next_follow_up_at")
  createdBy      String       @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([tenantId, businessType, businessId])
  @@index([tenantId, createdAt])
  @@map("follow_up_records")
}

// ==================== 合同管理 ====================

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  VOIDED
  /// 纸质合同已上传（AI 已识别或待手工录入），等销售核对确认
  PENDING_REVIEW
}

/// AI 识别进度：NONE=没走识别（手工录入）；PENDING=排队中；RUNNING=识别中；DONE=完成；FAILED=失败（可重试）
enum ContractExtractStatus {
  NONE
  PENDING
  RUNNING
  DONE
  FAILED
}

enum CareMode {
  ONE_TO_ONE
  ONE_TO_TWO
}

enum ContractOrientation {
  SOUTH
  NORTH
  BOTH
}

enum ContractFileKind {
  /// 用户上传的原始文件（PDF/照片），永久保留
  ORIGINAL
  /// 由原始文件渲染出的逐页图片，核对页/查看用
  PAGE
}

enum ContractItemKind {
  GIFT
  ADDON
}

/// 合同 = 纸质合同的数据台账 + 原件存档（2026-09-20 改造）：销售线下签完纸质合同后拍照/传 PDF，
/// AI 识别出核心数据，销售在核对页确认后入库；系统里不再保存合同正文、不做电子签署、不走审批。
/// 状态：PENDING_REVIEW(待核对) -> ACTIVE(已确认；有没有排房看 RoomOccupancy.contractId) -> VOIDED(作废)。
/// 合同上只写房型不写房号、也没有入住日期：入住/离店日期是销售按预产期推后几天"预估"的，
/// 客户实际入住当天才确定（行业惯例），所以 estimatedCheckIn/Out 只是预估值，房态以预订记录为准。
/// 租户全局可见，不做门店级数据隔离（同 Customer）。
model Contract {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  contractNo    String         @map("contract_no") // 系统内部流水号（CT...），纸质合同上的编号是 paperNo
  customerId    String?        @map("customer_id") // 核对确认前可能还没匹配/新建客户
  opportunityId String?        @map("opportunity_id")
  storeId       String         @map("store_id")
  title         String         @default("母婴护理服务协议")
  content       String?        @db.Text // 历史遗留：电子合同正文，纸质合同不再使用（TEXT 列不能有默认值，所以可空）
  amount        Int            @default(0) // 套餐金额，最小货币单位（分）
  startDate     DateTime?      @map("start_date") // 历史遗留，新流程用 estimatedCheckIn/Out
  endDate       DateTime?      @map("end_date")
  status        ContractStatus @default(PENDING_REVIEW)
  voidReason    String?        @map("void_reason") @db.Text
  createdBy     String         @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  version       Int            @default(0)

  // —— 纸质合同信息 ——
  paperNo           String?               @map("paper_no") // 纸质合同封面编号，如 2026-08-363
  signedDate        DateTime?             @map("signed_date") @db.Date
  signerId          String?               @map("signer_id") // 签单人（销售账号），默认上传人
  // 客户信息快照（合同签订时填写的内容）。确认时匹配/新建 Customer 并把空缺字段补进去
  clientName        String?               @map("client_name")
  clientPhone       String?               @map("client_phone")
  clientIdCardNo    String?               @map("client_id_card_no")
  clientHospital    String?               @map("client_hospital")
  clientAddress     String?               @map("client_address") @db.Text
  emergencyName     String?               @map("emergency_name")
  emergencyRelation String?               @map("emergency_relation")
  emergencyPhone    String?               @map("emergency_phone")
  fetus             String? // single / twin / multi
  dueDate           DateTime?             @map("due_date") @db.Date // 合同上的预产期（签约时快照）
  // —— 套餐 ——
  roomTypeText      String?               @map("room_type_text") // 合同上手写的房型原文，如 至臻(2间房-南-北)
  roomTypeId        String?               @map("room_type_id") // 匹配到系统里的房型
  orientation       ContractOrientation?
  careMode          CareMode?             @map("care_mode")
  inHouseDays       Int?                  @map("in_house_days") // N+N 的第一个 N：所内入住天数（房态只用这个）
  homeServiceDays   Int                   @default(0) @map("home_service_days") // 第二个 N：出所后到家服务天数
  daysText          String?               @map("days_text") // 合同上的原文，如 28+28
  // —— 预估入住（合同上没有，销售预估，实际入住当天才确定）——
  estimatedCheckIn  DateTime?             @map("estimated_check_in") @db.Date
  estimatedCheckOut DateTime?             @map("estimated_check_out") @db.Date
  // —— 定金 ——
  depositAmount     Int?                  @map("deposit_amount") // 分
  depositPaid       Boolean               @default(false) @map("deposit_paid")
  depositMethod     PaymentMethod?        @map("deposit_method")
  depositPaidAt     DateTime?             @map("deposit_paid_at") @db.Date
  depositPaymentId  String?               @map("deposit_payment_id") // 确认时生成的收款记录
  // —— AI 识别 ——
  extractStatus     ContractExtractStatus @default(NONE) @map("extract_status")
  extractError      String?               @map("extract_error") @db.Text
  extractWarnings   Json?                 @map("extract_warnings") // 需要人工核对的提醒清单
  extractedAt       DateTime?             @map("extracted_at")
  confirmedAt       DateTime?             @map("confirmed_at")
  confirmedById     String?               @map("confirmed_by_id")

  customer        Customer?            @relation(fields: [customerId], references: [id])
  opportunity     SalesOpportunity?    @relation(fields: [opportunityId], references: [id])
  store           Store                @relation(fields: [storeId], references: [id])
  signer          Account?             @relation("ContractSigner", fields: [signerId], references: [id])
  roomType        RoomType?            @relation(fields: [roomTypeId], references: [id])
  roomOccupancies RoomOccupancy[]
  payments        Payment[]
  files           ContractFile[]
  items           ContractItem[]
  extractions     ContractExtraction[]

  @@unique([tenantId, contractNo])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, paperNo])
  @@map("contracts")
}

/// 合同原件与逐页图片。文件本体存在服务器磁盘（CONTRACT_STORAGE_DIR），这里只记路径。
model ContractFile {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  contractId  String           @map("contract_id")
  kind        ContractFileKind
  fileName    String           @map("file_name")
  storagePath String           @map("storage_path") // 相对 CONTRACT_STORAGE_DIR 的路径
  mimeType    String           @map("mime_type")
  sizeBytes   Int              @map("size_bytes")
  pageNo      Int?             @map("page_no")
  pageKind    String?          @map("page_kind") // AI 判断的页面类型：cover/body_1/body_2/body_sign/attachment…
  createdBy   String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_files")
}

/// 合同约定的赠送/加购项目（手写内容，AI 识别后可人工修改）。
model ContractItem {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  contractId  String           @map("contract_id")
  kind        ContractItemKind @default(GIFT)
  name        String
  quantity    String?
  needsReview Boolean          @default(false) @map("needs_review") // AI 没看清，提醒销售核对
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_items")
}

/// AI 每次识别的完整原始结果，留痕用（排查为什么识别错、评估模型准确度）。
model ContractExtraction {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  contractId String   @map("contract_id")
  model      String?
  latencyMs  Int?     @map("latency_ms")
  result     Json
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_extractions")
}

// ==================== 房态预订（住店运营域） ====================

enum RoomOccupancyStatus {
  RESERVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model RoomType {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  code          String
  name          String
  description   String?      @db.Text
  standardPrice Int?         @map("standard_price") // 参考价，最小货币单位（分），可空——非强制定价
  status        CommonStatus @default(ACTIVE)
  createdBy     String       @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  version       Int          @default(0)

  rooms     Room[]
  contracts Contract[]

  @@unique([tenantId, code])
  @@map("room_types")
}

/// 房间：不存房态枚举，房态由 RoomOccupancy 实时计算得出（见 RoomService.computeStatus）。
/// underMaintenance/needsCleaning 是独立于占用记录的标志位（沿用开发文档"维修为独立标志"的设计）。
model Room {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  storeId          String   @map("store_id")
  roomTypeId       String   @map("room_type_id")
  roomNo           String   @map("room_no")
  floor            String // 允许 "1F"/"B1" 等标签，不做纯数字假设
  underMaintenance Boolean  @default(false) @map("under_maintenance")
  maintenanceNote  String?  @map("maintenance_note") @db.Text
  needsCleaning    Boolean  @default(false) @map("needs_cleaning")
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(0)

  store       Store           @relation(fields: [storeId], references: [id])
  roomType    RoomType        @relation(fields: [roomTypeId], references: [id])
  occupancies RoomOccupancy[]
  devices     Device[]

  @@unique([tenantId, storeId, roomNo])
  @@index([tenantId, storeId])
  @@map("rooms")
}

/// 占房记录：预订/入住/离店/取消的状态机主体。合同可选（弱关联，仿照 Contract.opportunityId）。
model RoomOccupancy {
  id               String              @id @default(cuid())
  tenantId         String              @map("tenant_id")
  occupancyNo      String              @map("occupancy_no")
  roomId           String              @map("room_id")
  storeId          String              @map("store_id") // 冗余存储，便于按店过滤，仿照 Contract.storeId
  customerId       String              @map("customer_id")
  contractId       String?             @map("contract_id")
  status           RoomOccupancyStatus @default(RESERVED)
  plannedCheckIn   DateTime            @map("planned_check_in")
  plannedCheckOut  DateTime            @map("planned_check_out")
  actualCheckInAt  DateTime?           @map("actual_check_in_at")
  actualCheckOutAt DateTime?           @map("actual_check_out_at")
  cancelReason     String?             @map("cancel_reason") @db.Text
  remark           String?             @db.Text
  createdBy        String              @map("created_by")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  version          Int                 @default(0)

  room                    Room                     @relation(fields: [roomId], references: [id])
  store                   Store                    @relation(fields: [storeId], references: [id])
  customer                Customer                 @relation(fields: [customerId], references: [id])
  contract                Contract?                @relation(fields: [contractId], references: [id])
  motherProfiles          MotherProfile[]
  roomCalls               RoomCall[]
  roomOutings             RoomOuting[]
  roomServiceRequisitions RoomServiceRequisition[]
  dinerProfiles           DinerProfile[]

  @@unique([tenantId, occupancyNo])
  @@index([tenantId, roomId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("room_occupancies")
}

// ==================== 收款管理（交易与供应域） ====================

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  WECHAT
  ALIPAY
  POS_CARD
  OTHER
}

enum PaymentStatus {
  RECORDED
  PENDING_REFUND
  REFUNDED
}

/// 收款记录：只做"收款"（客户付钱给中心），不做应付/付款。
/// 退款不新增独立冲正单据，是同一条记录上的状态迁移（见 PaymentRecordService 注释），
/// 与 Contract.void() 的处理口径一致，为控制本轮范围做的取舍。
model Payment {
  id           String        @id @default(cuid())
  tenantId     String        @map("tenant_id")
  paymentNo    String        @map("payment_no")
  contractId   String        @map("contract_id")
  customerId   String        @map("customer_id")
  storeId      String        @map("store_id")
  amount       Int // 收款金额，最小货币单位（分）
  method       PaymentMethod @default(CASH)
  status       PaymentStatus @default(RECORDED)
  refundReason String?       @map("refund_reason") @db.Text
  remark       String?       @db.Text
  createdBy    String        @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  version      Int           @default(0)

  contract Contract @relation(fields: [contractId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  store    Store    @relation(fields: [storeId], references: [id])

  @@unique([tenantId, paymentNo])
  @@index([tenantId, contractId])
  @@index([tenantId, status])
  @@map("payments")
}

// ==================== 财务结算深化（会员账户：赠送优先扣减，见业务规则确认记录#5） ====================
// 与 Payment（强绑定 Contract 的合同收款）是两类不同性质的资金记录，不合并、不互相依赖，
// 呼应竞品"多资金池独立核算"的精神，但V1只用一个账户的"本金/赠送"两个子池覆盖核心区分。
// 余额变更（充值/消费/退款/调整）均用数据库原子 increment 保证并发安全，不要求前端传
// expectedVersion——这是高频小额记账场景，与"整单编辑"的乐观锁语义不同（详见业务规则确认记录）。

enum CustomerAccountTransactionType {
  RECHARGE
  CONSUME
  REFUND
  ADJUST
}

model CustomerAccount {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  customerId       String   @unique @map("customer_id")
  principalBalance Int      @default(0) @map("principal_balance") // 客户实付本金余额，最小货币单位（分）
  giftBalance      Int      @default(0) @map("gift_balance") // 赠送/权益余额，最小货币单位（分）
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(0)

  customer     Customer                     @relation(fields: [customerId], references: [id])
  transactions CustomerAccountTransaction[]

  @@map("customer_accounts")
}

/// 消费(CONSUME)按"赠送优先，再扣本金"顺序自动拆分 principalDelta/giftDelta（均为负数）；
/// 退款(REFUND)由操作员显式指定退回本金/赠送各多少，系统不做反查原消费记录的自动比例拆分。
model CustomerAccountTransaction {
  id             String                         @id @default(cuid())
  tenantId       String                         @map("tenant_id")
  accountId      String                         @map("account_id")
  type           CustomerAccountTransactionType
  principalDelta Int                            @default(0) @map("principal_delta") // 可正可负
  giftDelta      Int                            @default(0) @map("gift_delta") // 可正可负
  principalAfter Int                            @map("principal_after")
  giftAfter      Int                            @map("gift_after")
  sourceType     String?                        @map("source_type") // 如 MANUAL/SERVICE_APPOINTMENT/CONTRACT
  sourceId       String?                        @map("source_id")
  remark         String?                        @db.Text
  createdBy      String                         @map("created_by")
  createdAt      DateTime                       @default(now()) @map("created_at")

  account CustomerAccount @relation(fields: [accountId], references: [id])

  @@index([tenantId, accountId])
  @@map("customer_account_transactions")
}

// ==================== 护理域（母婴履约深化 P2 第一切片：表单引擎 + 档案） ====================
// 业务规则依据：docs/竞品分析-一月妈咪月子中心管理系统功能架构逆向分析.md 3.3 节
// + docs/业务规则确认记录.md #6、#7（2026-07-28 确认）。

enum CareTargetType {
  MOTHER
  BABY
}

enum CareFieldControlType {
  NUMBER
  TEXT
  TEXTAREA
  SELECT
  RADIO
}

enum CareFormDepartment {
  NURSING // 护理部
  POSTPARTUM_RECOVERY // 产康部
  MEAL // 膳食部
  CUSTOMER_SERVICE // 客服部
  MEDICAL // 医务部（本切片不做"医嘱"能力，仅保留场景分类供未来扩展）
}

enum CareFormScene {
  GENERAL // 通用
  IN_HOUSE // 所内
  HOME_VISIT // 上户
  HOSPITAL // 医院
}

/// 护理字段元数据：四层可配置表单引擎的最底层（字段→项目→方案→计划）。
/// normalMin/normalMax 用于数值型字段的正常值域判定，normalOptionValues 用于选项型
/// 字段（数组，列出哪些选项值算正常）；两者都为空表示该字段仅作记录、不参与护理异常
/// 自动判定。本期只做"超范围即异常"的单档判定，不做多级严重度（业务规则确认记录#7）。
model CareFieldDefinition {
  id                 String               @id @default(cuid())
  tenantId           String               @map("tenant_id")
  code               String
  name               String
  targetType         CareTargetType       @map("target_type")
  controlType        CareFieldControlType @map("control_type")
  unit               String?
  options            Json? // SELECT/RADIO 候选项：[{value,label}]
  normalMin          Float?               @map("normal_min")
  normalMax          Float?               @map("normal_max")
  normalOptionValues Json?                @map("normal_option_values") // 选项型字段的正常值集合：string[]
  visibleToClient    Boolean              @default(false) @map("visible_to_client")
  status             CommonStatus         @default(ACTIVE)
  createdBy          String               @map("created_by")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  version            Int                  @default(0)

  formFields    CareFormTemplateField[]
  abnormalities CareAbnormality[]

  @@unique([tenantId, code])
  @@map("care_field_definitions")
}

/// 护理项目（表单模板）：按部门+场景分类的表单容器，字段引用通过中间表携带顺序与必填。
model CareFormTemplate {
  id         String             @id @default(cuid())
  tenantId   String             @map("tenant_id")
  code       String
  name       String
  targetType CareTargetType     @map("target_type")
  department CareFormDepartment
  scene      CareFormScene      @default(GENERAL)
  status     CommonStatus       @default(ACTIVE)
  createdBy  String             @map("created_by")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  version    Int                @default(0)

  fields      CareFormTemplateField[]
  planItems   CarePlanTemplateItem[]
  planTasks   CarePlanTask[]
  careRecords CareRecord[]

  @@unique([tenantId, code])
  @@map("care_form_templates")
}

model CareFormTemplateField {
  id             String  @id @default(cuid())
  formTemplateId String  @map("form_template_id")
  fieldId        String  @map("field_id")
  sortOrder      Int     @default(0) @map("sort_order")
  required       Boolean @default(false)

  formTemplate CareFormTemplate    @relation(fields: [formTemplateId], references: [id])
  field        CareFieldDefinition @relation(fields: [fieldId], references: [id])

  @@unique([formTemplateId, fieldId])
  @@map("care_form_template_fields")
}

/// 护理方案（模板）：把多个表单模板按"入住第几天"组合成天数化方案，
/// 如"妈妈护理入住方案28天"。CarePlan 激活时据此批量生成 CarePlanTask。
model CarePlanTemplate {
  id         String         @id @default(cuid())
  tenantId   String         @map("tenant_id")
  code       String
  name       String
  targetType CareTargetType @map("target_type")
  totalDays  Int            @map("total_days")
  status     CommonStatus   @default(ACTIVE)
  createdBy  String         @map("created_by")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  version    Int            @default(0)

  items CarePlanTemplateItem[]
  plans CarePlan[]

  @@unique([tenantId, code])
  @@map("care_plan_templates")
}

model CarePlanTemplateItem {
  id             String @id @default(cuid())
  planTemplateId String @map("plan_template_id")
  dayOffset      Int    @map("day_offset") // 入住第几天，从1开始
  formTemplateId String @map("form_template_id")

  planTemplate CarePlanTemplate @relation(fields: [planTemplateId], references: [id])
  formTemplate CareFormTemplate @relation(fields: [formTemplateId], references: [id])

  @@unique([planTemplateId, dayOffset, formTemplateId])
  @@map("care_plan_template_items")
}

enum DeliveryMethod {
  VAGINAL
  CESAREAN
  UNKNOWN
}

/// 妈妈档案：一次入住/一次月子周期一条记录，不是与 Customer 一一对应——同一客户
/// "再次入住"（二胎/二次月子）时新建一条档案，历史档案与其护理记录不覆盖、不删除，
/// 呼应"离店后房间释放但护理档案保留"的验收标准（业务规则确认记录#6）。
/// 风险标签（早产/传染病/高敏/妈咪住院等）不建独立字段，复用平台 Tag/TagBinding
/// （entityType='MOTHER_PROFILE'）。
model MotherProfile {
  id                   String         @id @default(cuid())
  tenantId             String         @map("tenant_id")
  storeId              String         @map("store_id")
  customerId           String         @map("customer_id")
  occupancyId          String?        @map("occupancy_id")
  deliveryMethod       DeliveryMethod @default(UNKNOWN) @map("delivery_method")
  deliveryDate         DateTime?      @map("delivery_date")
  gestationalWeeks     Int?           @map("gestational_weeks")
  expectedDeliveryDate DateTime?      @map("expected_delivery_date")
  /// 护理要点/医嘱：护理看板卡片上展示的简短提示，与 remark（建档备注）分开维护；
  /// 后续会扩展成"护理重点概要"，现在先是一个自由文本字段。
  careNote             String?        @map("care_note") @db.Text
  /// 主责护理师（责任护士）：从员工账号里选，在母婴档案里指派/更换；护理看板、房态看板展示。
  primaryNurseId       String?        @map("primary_nurse_id")
  remark               String?        @db.Text
  /// 归档（结案）：有护理记录的档案不能删，归档后列表默认隐藏，可恢复
  archivedAt           DateTime?      @map("archived_at")
  archivedBy           String?        @map("archived_by")
  createdBy            String         @map("created_by")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  version              Int            @default(0)

  store               Store                @relation(fields: [storeId], references: [id])
  customer            Customer             @relation(fields: [customerId], references: [id])
  occupancy           RoomOccupancy?       @relation(fields: [occupancyId], references: [id])
  primaryNurse        Account?             @relation("MotherPrimaryNurse", fields: [primaryNurseId], references: [id])
  babies              BabyProfile[]
  carePlans           CarePlan[]
  careRecords         CareRecord[]
  abnormalities       CareAbnormality[]
  outreachPlans       CareOutreachPlan[]
  documents           CareDocument[]
  dailyRecords        CareDailyRecord[]
  medicationAuths     CareMedicationAuth[]
  planVersions        CarePlanVersion[]
  serviceLogs         CareServiceLog[]
  confirmLinks        CareConfirmLink[]
  admissionAssessment CareMotherAdmission?
  dischargeAssessment CareMotherDischarge?

  @@index([tenantId, customerId])
  @@index([primaryNurseId])
  @@map("mother_profiles")
}

enum BabyGender {
  MALE
  FEMALE
  UNKNOWN
}

/// 宝宝档案：多胞胎＝同一 motherProfileId 下多条记录，用 sequenceNo 区分（业务规则确认记录#6）。
model BabyProfile {
  id               String     @id @default(cuid())
  tenantId         String     @map("tenant_id")
  storeId          String     @map("store_id")
  customerId       String     @map("customer_id")
  motherProfileId  String     @map("mother_profile_id")
  sequenceNo       Int        @default(1) @map("sequence_no")
  name             String?
  gender           BabyGender @default(UNKNOWN)
  birthDate        DateTime?  @map("birth_date")
  birthWeightGrams Int?       @map("birth_weight_grams")
  apgarScore       String?    @map("apgar_score")
  remark           String?    @db.Text
  createdBy        String     @map("created_by")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  version          Int        @default(0)

  store               Store                 @relation(fields: [storeId], references: [id])
  customer            Customer              @relation(fields: [customerId], references: [id])
  motherProfile       MotherProfile         @relation(fields: [motherProfileId], references: [id])
  carePlans           CarePlan[]
  careRecords         CareRecord[]
  abnormalities       CareAbnormality[]
  documents           CareDocument[]
  dailyBabyRecords    CareDailyBabyRecord[]
  medicationAuths     CareMedicationAuth[]
  planVersions        CarePlanVersion[]
  serviceLogs         CareServiceLog[]
  growthRecords       BabyGrowthRecord[]
  growthShares        BabyGrowthShare[]
  admissionAssessment CareBabyAdmission?
  dischargeAssessment CareBabyDischarge?

  @@unique([motherProfileId, sequenceNo])
  @@index([tenantId, customerId])
  @@map("baby_profiles")
}

// ==================== 护理档案：纸质表格留档 + 单次评估（P1） ====================
// 纸质表格拍照上传后原件永久保留（CareDocument/CareDocumentFile）；需要结构化的表格，
// 识别结果先放在 CareDocument.extractData 里等人工复核，复核确认后才写入下面四张评估表，
// 没确认前不进入统计。字段说明书见 src/care/care-assessment/assessment-specs.ts。

enum CareDocType {
  MOTHER_ADMISSION // 产妇入住评估单
  BABY_ADMISSION // 新生儿入所评估
  MOTHER_DISCHARGE // 妈妈出所健康评估表
  BABY_DISCHARGE // 宝宝出所健康评估表
  DAILY_RECORD // 新生儿和产妇日常护理记录（P2）
  MEDICATION_AUTH // 新生儿用药服药喂药委托书（P3）
  CARE_PLAN // 产妇常规护理计划/护理计划（P4）
  RISK_NOTICE // 产妇及新生儿风险告知书（只留档）
  ORIENTATION // 会所入住宣教（只留档）
  CHOKING_PROTOCOL // 新生儿呛奶应急预案及处理方法（只留档）
  OTHER
}

enum CareDocStatus {
  /// 已上传/已识别，等待人工复核入库
  DRAFT
  /// 已确认（结构化数据已入库，或只留档类资料已归档）
  CONFIRMED
}

/// 一份纸质资料（可含多张照片）。妈妈和宝宝的资料都挂在妈妈档案下（宝宝资料另带 babyProfileId）。
model CareDocument {
  id              String                @id @default(cuid())
  tenantId        String                @map("tenant_id")
  storeId         String                @map("store_id")
  docType         CareDocType           @map("doc_type")
  motherProfileId String                @map("mother_profile_id")
  babyProfileId   String?               @map("baby_profile_id")
  status          CareDocStatus         @default(DRAFT)
  title           String?
  docDate         DateTime?             @map("doc_date") @db.Date
  remark          String?               @db.Text
  extractStatus   ContractExtractStatus @default(NONE) @map("extract_status")
  extractError    String?               @map("extract_error") @db.Text
  extractData     Json?                 @map("extract_data") // AI 识别出的字段（key 同评估表字段）
  extractWarnings Json?                 @map("extract_warnings") // 需要人工核对的提醒
  extractModel    String?               @map("extract_model")
  /// 识别范围：空=整张纸；BABY_FEEDING=只认宝宝单页（宝宝体征 + 24小时喂养记录单），不读妈妈栏
  extractScope    String?               @map("extract_scope")
  extractedAt     DateTime?             @map("extracted_at")
  confirmedBy     String?               @map("confirmed_by")
  confirmedAt     DateTime?             @map("confirmed_at")
  createdBy       String                @map("created_by")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  version         Int                   @default(0)

  motherProfile    MotherProfile         @relation(fields: [motherProfileId], references: [id])
  babyProfile      BabyProfile?          @relation(fields: [babyProfileId], references: [id])
  files            CareDocumentFile[]
  motherAdmission  CareMotherAdmission[]
  babyAdmission    CareBabyAdmission[]
  motherDischarge  CareMotherDischarge[]
  babyDischarge    CareBabyDischarge[]
  dailyRecords     CareDailyRecord[]     @relation("DailyRecordDocument")
  medicationAuths  CareMedicationAuth[]  @relation("MedicationAuthDocument")
  dailyBabyRecords CareDailyBabyRecord[] @relation("DailyBabyRecordDocument")

  @@index([tenantId, motherProfileId, docType])
  @@index([tenantId, status])
  @@map("care_documents")
}

model CareDocumentFile {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  documentId   String   @map("document_id")
  fileName     String   @map("file_name")
  storagePath  String   @map("storage_path") // 相对存储根目录的路径（展示/识别用的文件，HEIC 会转成 JPEG）
  originalPath String?  @map("original_path") // 上传的原始文件（和 storagePath 不同时才有，如苹果 HEIC 原图），永久保留
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  sortOrder    Int      @default(0) @map("sort_order")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  document CareDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("care_document_files")
}

/// 产妇入住评估单：一个妈妈档案一份（单次评估，可修改，修改留审计记录）。
model CareMotherAdmission {
  id                      String    @id @default(cuid())
