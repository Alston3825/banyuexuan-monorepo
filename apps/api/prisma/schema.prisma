/// 日常护理记录（妈妈那一栏）：一个妈妈档案每天一条，住几天就有几条。字段见 care-daily/daily-specs.ts。
model CareDailyRecord {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  storeId            String   @map("store_id")
  motherProfileId    String   @map("mother_profile_id")
  recordDate         DateTime @map("record_date") @db.Date
  stayDay            Int?     @map("stay_day") // 入住第几天（创建时按入住日算出，可改）
  documentId         String?  @map("document_id") // 纸质原件照片（可为空）
  motherTemperature  Float?   @map("mother_temperature") // 体温
  motherPulse        Int?     @map("mother_pulse") // 脉搏
  motherBpSystolic   Int?     @map("mother_bp_systolic") // 收缩压(高压)
  motherBpDiastolic  Int?     @map("mother_bp_diastolic") // 舒张压(低压)
  breast             Json?    @map("breast") // 乳房
  breastBody         Json?    @map("breast_body") // 乳体
  milk               String?  @map("milk") // 乳汁
  woundCesarean      Json?    @map("wound_cesarean") // 剖宫产伤口
  woundVaginal       Json?    @map("wound_vaginal") // 顺产伤口
  lochiaStatus       String?  @map("lochia_status") // 恶露状态
  lochiaColor        String?  @map("lochia_color") // 恶露颜色
  lochiaAmount       String?  @map("lochia_amount") // 恶露量
  lochiaOdor         String?  @map("lochia_odor") // 恶露气味
  bowel              String?  @map("bowel") // 大便
  urine              String?  @map("urine") // 小便
  motherPlan         String?  @map("mother_plan") @db.Text // 妈妈护理计划
  motherNurseName    String?  @map("mother_nurse_name") // 护理师签字（产妇）
  motherClientSigner String?  @map("mother_client_signer") // 客户签字（产妇）
  createdBy          String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  version            Int      @default(0)

  motherProfile MotherProfile           @relation(fields: [motherProfileId], references: [id])
  document      CareDocument?           @relation("DailyRecordDocument", fields: [documentId], references: [id])
  babies        CareDailyBabyRecord[]
  signatures    CareDailySignature[]
  confirmations CareDailyConfirmation[]

  @@unique([motherProfileId, recordDate])
  @@index([tenantId, storeId, recordDate])
  @@map("care_daily_records")
}

enum CareSignShift {
  DAY // 白班
  NIGHT // 夜班
  RELIEF // 替班/支援
}

enum CareConfirmMethod {
  SIGNATURE // 客户手写签名
  BUTTON // 客户点击确认（需长按 + 本人手机号后四位核验）
}

/// 日常护理记录的护理师签字：谁（账号）、哪个班次、什么时间、签字时的内容指纹。
/// 一个妈妈一天可以有多位护理师各签一条（1对多服务、早晚班不同人、替班都支持）；
/// 只能用自己的账号签自己的字，签字图取签字当时的快照。内容签字后被改动 → contentHash 对不上 → 页面提示“需重新签字”。
model CareDailySignature {
  id             String        @id @default(cuid())
  tenantId       String        @map("tenant_id")
  storeId        String        @map("store_id")
  dailyRecordId  String        @map("daily_record_id")
  shift          CareSignShift
  nurseAccountId String        @map("nurse_account_id")
  nurseName      String        @map("nurse_name") // 签字时的姓名快照
  signatureData  String?       @map("signature_data") @db.MediumText // 签字时的签名图快照
  contentHash    String        @map("content_hash") @db.VarChar(64)
  signedAt       DateTime      @default(now()) @map("signed_at")
  ip             String?
  deviceId       String?       @map("device_id") @db.VarChar(64)

  dailyRecord  CareDailyRecord @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  nurseAccount Account         @relation(fields: [nurseAccountId], references: [id])

  @@unique([dailyRecordId, nurseAccountId])
  @@index([tenantId, nurseAccountId])
  @@map("care_daily_signatures")
}

/// 发给客户的“护理记录确认”链接（客户用手机打开，不用登录）。链接本身只存哈希；7 天有效；
/// 打开后要先输入登记手机号后四位核验本人，输错 5 次锁 30 分钟。后期小程序复用同一套接口。
model CareConfirmLink {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  storeId         String    @map("store_id")
  motherProfileId String    @map("mother_profile_id")
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt       DateTime  @map("expires_at")
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")
  failedAttempts  Int       @default(0) @map("failed_attempts")
  lockedUntil     DateTime? @map("locked_until")
  openCount       Int       @default(0) @map("open_count")
  lastOpenedAt    DateTime? @map("last_opened_at")

  motherProfile MotherProfile           @relation(fields: [motherProfileId], references: [id])
  confirmations CareDailyConfirmation[]

  @@index([tenantId, motherProfileId])
  @@map("care_confirm_links")
}

/// 客户对某一天护理记录小结 + 满意度的确认。每次确认一条（内容被改后客户重新确认会再产生一条，取最新）。
/// 证据：链接、手机号后四位核验通过、IP/设备/浏览器、页面停留时长、长按时长、手写签名图或按钮确认、
/// 确认当时的内容指纹，以及系统判断的风险标记（如在护理师用过的设备上确认）。
model CareDailyConfirmation {
  id            String            @id @default(cuid())
  tenantId      String            @map("tenant_id")
  storeId       String            @map("store_id")
  dailyRecordId String            @map("daily_record_id")
  linkId        String            @map("link_id")
  batchId       String            @map("batch_id") @db.VarChar(40) // 一次点“确认”提交的多天共用一个
  method        CareConfirmMethod
  signatureData String?           @map("signature_data") @db.MediumText
  satisfaction  Int // 当天整体满意度 1~5
  /// 对当班各位护理师的评价：[{signatureId, nurseAccountId, nurseName, shift, score}]
  nurseRatings  Json?             @map("nurse_ratings")
  comment       String?           @db.VarChar(500)
  contentHash   String            @map("content_hash") @db.VarChar(64)
  confirmedAt   DateTime          @default(now()) @map("confirmed_at")
  ip            String?
  userAgent     String?           @map("user_agent") @db.VarChar(300)
  deviceId      String?           @map("device_id") @db.VarChar(64)
  dwellMs       Int               @map("dwell_ms") // 从看到内容到点确认的时长（服务器计时）
  holdMs        Int?              @map("hold_ms") // 长按确认键的时长（客户端上报）
  riskFlags     Json?             @map("risk_flags") // 如 ["STAFF_DEVICE"]

  dailyRecord CareDailyRecord @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  link        CareConfirmLink @relation(fields: [linkId], references: [id])

  @@index([dailyRecordId, confirmedAt])
  @@index([deviceId])
  @@map("care_daily_confirmations")
}

/// 员工登录过的设备（浏览器本地生成的随机设备号）。用来识别“客户确认是不是在护理师自己的手机上点的”。
model StaffDevice {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  deviceId    String   @map("device_id") @db.VarChar(64)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  lastIp      String?  @map("last_ip")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, deviceId])
  @@index([deviceId])
  @@map("staff_devices")
}

/// 日常护理记录里每个宝宝的那一栏（多胞胎每个宝宝一条）。
model CareDailyBabyRecord {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  storeId           String   @map("store_id")
  dailyRecordId     String   @map("daily_record_id")
  babyProfileId     String   @map("baby_profile_id")
  documentId        String?  @map("document_id")
  ageDays           Int?     @map("age_days") // 出生天数
  weightKg          Float?   @map("weight_kg") // 宝宝体重
  tempMorning       Float?   @map("temp_morning") // 体温(早)
  tempEvening       Float?   @map("temp_evening") // 体温(晚)
  eye               Json?    @map("eye") // 眼
  mouth             Json?    @map("mouth") // 口
  nose              Json?    @map("nose") // 鼻
  umbilical         Json?    @map("umbilical") // 脐带
  genitalia         Json?    @map("genitalia") // 生殖器
  skin              Json?    @map("skin") // 皮肤
  healthAssessment  String?  @map("health_assessment") // 健康评估
  jaundiceForehead  Float?   @map("jaundice_forehead") // 黄疸-前额
  jaundiceCanthus   Float?   @map("jaundice_canthus") // 黄疸-眼角
  jaundiceChest     Float?   @map("jaundice_chest") // 黄疸-前胸
  babyPlan          String?  @map("baby_plan") @db.Text // 宝宝护理计划
  dayShiftSummary   String?  @map("day_shift_summary") @db.Text // 白班护理总结
  nightShiftSummary String?  @map("night_shift_summary") @db.Text // 夜班护理总结
  dayNurseName      String?  @map("day_nurse_name") // 护理师签字（白班）
  nightNurseName    String?  @map("night_nurse_name") // 护理师签字（夜班）
  babyClientSigner  String?  @map("baby_client_signer") // 客户签字（宝宝）
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  version           Int      @default(0)

  dailyRecord CareDailyRecord    @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  babyProfile BabyProfile        @relation(fields: [babyProfileId], references: [id])
  document    CareDocument?      @relation("DailyBabyRecordDocument", fields: [documentId], references: [id])
  feedings    CareFeedingEntry[]

  @@unique([dailyRecordId, babyProfileId])
  @@index([babyProfileId])
  @@map("care_daily_baby_records")
}

/// 24 小时宝宝喂养记录单的一行（一次喂养/排泄）。
model CareFeedingEntry {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  babyDailyId   String   @map("baby_daily_id")
  sortOrder     Int      @default(0) @map("sort_order")
  time          String?  @map("time") // 时间
  directFeedMin Int?     @map("direct_feed_min") // 亲喂(分钟)
  breastMilkMl  Int?     @map("breast_milk_ml") // 母乳(ml)
  formulaMl     Int?     @map("formula_ml") // 奶粉(ml)
  medication    String?  @map("medication") // 用药
  waterMl       Int?     @map("water_ml") // 喂水(ml)
  urine         String?  @map("urine") // 小便
  stool         String?  @map("stool") // 大便
  stoolColor    String?  @map("stool_color") // 大便颜色
  stoolAmount   String?  @map("stool_amount") // 大便量
  stoolTexture  String?  @map("stool_texture") // 大便性状
  nurseName     String?  @map("nurse_name") // 责护签字
  remark        String?  @map("remark") // 备注
  createdAt     DateTime @default(now()) @map("created_at")

  babyDaily CareDailyBabyRecord @relation(fields: [babyDailyId], references: [id], onDelete: Cascade)

  @@index([babyDailyId])
  @@map("care_feeding_entries")
}

enum CareMedicationStatus {
  /// 当前有效的委托
  ACTIVE
  /// 已被一份新的变更委托替换（历史保留）
  SUPERSEDED
  /// 已停药
  STOPPED
}

/// 新生儿用药服药喂药委托书：家长委托护理师给宝宝按要求服药。一份委托书一条记录（含多种药品行），
/// 住店期间病情变化需要调整时新签一份（previousAuthId 指向上一份，旧的自动变成"已替换"），
/// 这样每一次委托的内容、家属签字（原件照片）都完整保留，用来分清责任。
model CareMedicationAuth {
  id              String               @id @default(cuid())
  tenantId        String               @map("tenant_id")
  storeId         String               @map("store_id")
  motherProfileId String               @map("mother_profile_id")
  babyProfileId   String               @map("baby_profile_id")
  previousAuthId  String?              @map("previous_auth_id")
  status          CareMedicationStatus @default(ACTIVE)
  authDate        DateTime?            @map("auth_date") @db.Date // 委托日期
  medicationStart DateTime?            @map("medication_start") @db.Date // 用药日期
  signerName      String?              @map("signer_name") // 宝妈或家属签字（姓名）
  nurseName       String?              @map("nurse_name") // 护理师签字（姓名）
  changeNote      String?              @map("change_note") @db.Text // 这一份相对上一份变了什么
  remark          String?              @db.Text
  stoppedAt       DateTime?            @map("stopped_at")
  stoppedBy       String?              @map("stopped_by")
  stopNote        String?              @map("stop_note") @db.Text
  documentId      String?              @map("document_id") // 家属签字的纸质原件照片
  createdBy       String               @map("created_by")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  version         Int                  @default(0)

  motherProfile MotherProfile        @relation(fields: [motherProfileId], references: [id])
  babyProfile   BabyProfile          @relation(fields: [babyProfileId], references: [id])
  previous      CareMedicationAuth?  @relation("MedicationChain", fields: [previousAuthId], references: [id])
  next          CareMedicationAuth[] @relation("MedicationChain")
  document      CareDocument?        @relation("MedicationAuthDocument", fields: [documentId], references: [id])
  items         CareMedicationItem[]

  @@index([tenantId, babyProfileId, status])
  @@index([tenantId, motherProfileId])
  @@map("care_medication_auths")
}

/// 委托书里的一行药品。
model CareMedicationItem {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  authId       String    @map("auth_id")
  sortOrder    Int       @default(0) @map("sort_order")
  drugName     String    @map("drug_name")
  route        String? // ORAL 内服 / EXTERNAL 外用
  times        Json? // ["MORNING","NOON","EVENING"]
  dose         String? // 剂量（纸质表上没有这一栏，系统里补）
  courseDays   Int?      @map("course_days") // 疗程天数
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  notes        String?   @db.Text // 用药注意事项（饭前饭后、间隔时长等）
  familySigned String?   @map("family_signed") // 家长签名栏是否已签：YES

  auth CareMedicationAuth @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([authId])
  @@map("care_medication_items")
}

enum CareLevel {
  LEVEL1 // 一级（重点）
  LEVEL2 // 二级
  LEVEL3 // 三级（常规）
}

enum CarePlanVersionStatus {
  DRAFT // 护理长编辑中
  PENDING_REVIEW // 已提交，等护理主任审核
  ACTIVE // 当前生效的版本
  SUPERSEDED // 已被新版本替换（历史只读）
  REJECTED // 被驳回，等修改后再提交
}

enum CarePlanSource {
  INITIAL // 入所首次制定
  REGULAR_REVIEW // 每 7 天的定期评审（护理长）
  DIRECTOR_ROUND // 护理主任查房时调整
}

/// 个人化护理计划（版本制）：入所评估后由护理长制定，护理主任审核后生效；之后每 7 天护理长评审一次
/// （写上阶段执行结果 + 调整后的新计划），护理主任查房可随时调整。每次调整都是一个新版本，
/// 旧版本只读保留，完整记录"护理计划是怎么一步步调整的"。babyProfileId 为空表示妈妈的计划，
/// 有值表示这个宝宝的计划；同一个对象同一时间只有一个 ACTIVE 版本（应用层保证）。
/// 注意：和旧的按模板生成任务的 CarePlan 是两回事，旧的保留不动。
model CarePlanVersion {
  id                String                @id @default(cuid())
  tenantId          String                @map("tenant_id")
  storeId           String                @map("store_id")
  motherProfileId   String                @map("mother_profile_id")
  babyProfileId     String?               @map("baby_profile_id")
  versionNo         Int                   @map("version_no")
  status            CarePlanVersionStatus @default(DRAFT)
  level             CareLevel
  source            CarePlanSource        @default(INITIAL)
  assessmentSummary String?               @map("assessment_summary") @db.Text // 评估依据/当前主要问题
  focusPoints       String?               @map("focus_points") @db.Text // 重点关注（护理看板“医嘱”取这里）
  measures          Json? // 具体措施 [{title, content, frequency}]
  progressNote      String?               @map("progress_note") @db.Text // 上阶段执行结果（评审时写）
  adjustReason      String?               @map("adjust_reason") @db.Text // 调整原因
  previousVersionId String?               @map("previous_version_id")
  createdBy         String                @map("created_by")
  createdByName     String?               @map("created_by_name")
  submittedAt       DateTime?             @map("submitted_at")
  reviewerId        String?               @map("reviewer_id")
  reviewerName      String?               @map("reviewer_name")
  reviewedAt        DateTime?             @map("reviewed_at")
  reviewComment     String?               @map("review_comment") @db.Text
  effectiveAt       DateTime?             @map("effective_at")
  nextReviewDue     DateTime?             @map("next_review_due") @db.Date
  endedAt           DateTime?             @map("ended_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  version           Int                   @default(0)

  motherProfile MotherProfile @relation(fields: [motherProfileId], references: [id])
  babyProfile   BabyProfile?  @relation(fields: [babyProfileId], references: [id])

  @@index([tenantId, motherProfileId, status])
  @@index([tenantId, status, nextReviewDue])
  @@map("care_plan_versions")
}

/// 服务执行记录：对应纸质《产妇常规护理计划》——会阴护理、理疗、按摩子宫、各类查房、中药洗头泡脚、床品更换，
/// 以及宣教项目（带护理员/客户签名）每做一次记一条；"共 N 次"由系统数出来，不用手填。
/// serviceCode 见 care-plan-version/care-standards.ts；宝宝的项目带 babyProfileId。
model CareServiceLog {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  storeId         String   @map("store_id")
  motherProfileId String   @map("mother_profile_id")
  babyProfileId   String?  @map("baby_profile_id")
  serviceCode     String   @map("service_code")
  doneDate        DateTime @map("done_date") @db.Date
  doneTime        String?  @map("done_time") @db.VarChar(5) // 做的时间 HH:mm（旧记录没有）
  systolic        Int? // 测量类项目：收缩压 mmHg（产妇血压）
  diastolic       Int? // 舒张压 mmHg
  heartRate       Int?     @map("heart_rate") // 心率 次/分（测血压时一起测）
  weightKg        Decimal? @map("weight_kg") @db.Decimal(5, 2) // 测量类项目：体重 kg（产妇体重）
  doneByName      String?  @map("done_by_name") // 护理员/查房人
  clientSigned    Boolean  @default(false) @map("client_signed") // 客户已签字（宣教项目）
  note            String?
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  motherProfile MotherProfile @relation(fields: [motherProfileId], references: [id])
  babyProfile   BabyProfile?  @relation(fields: [babyProfileId], references: [id])

  @@index([tenantId, motherProfileId, serviceCode])
  @@map("care_service_logs")
}

enum CarePlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  TERMINATED
}

/// 护理计划：motherProfileId/babyProfileId 二选一（应用层保证，Prisma 无数据库级 XOR 约束）。
/// 激活时按 CarePlanTemplateItem 批量生成 CarePlanTask（每日任务卡片）。
model CarePlan {
  id              String         @id @default(cuid())
  tenantId        String         @map("tenant_id")
  storeId         String         @map("store_id")
  planNo          String         @map("plan_no")
  planTemplateId  String         @map("plan_template_id")
  motherProfileId String?        @map("mother_profile_id")
  babyProfileId   String?        @map("baby_profile_id")
  startDate       DateTime       @map("start_date") // 通常=入住日，方案第1天对应此日期
  status          CarePlanStatus @default(DRAFT)
  terminateReason String?        @map("terminate_reason") @db.Text
  createdBy       String         @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  version         Int            @default(0)

  store         Store            @relation(fields: [storeId], references: [id])
  planTemplate  CarePlanTemplate @relation(fields: [planTemplateId], references: [id])
  motherProfile MotherProfile?   @relation(fields: [motherProfileId], references: [id])
  babyProfile   BabyProfile?     @relation(fields: [babyProfileId], references: [id])
  tasks         CarePlanTask[]

  @@unique([tenantId, planNo])
  @@index([tenantId, motherProfileId])
  @@index([tenantId, babyProfileId])
  @@map("care_plans")
}

enum CarePlanTaskStatus {
  PENDING
  COMPLETED
  MISSED
}

/// 每日任务卡片：由 CarePlan 激活时按模板批量生成。careRecordId 在任务完成（护理记录提交）时回填。
model CarePlanTask {
  id             String             @id @default(cuid())
  carePlanId     String             @map("care_plan_id")
  dayOffset      Int                @map("day_offset")
  scheduledDate  DateTime           @map("scheduled_date")
  formTemplateId String             @map("form_template_id")
  status         CarePlanTaskStatus @default(PENDING)
  careRecordId   String?            @unique @map("care_record_id")

  carePlan     CarePlan         @relation(fields: [carePlanId], references: [id])
  formTemplate CareFormTemplate @relation(fields: [formTemplateId], references: [id])
  careRecord   CareRecord?      @relation("TaskCareRecord", fields: [careRecordId], references: [id])

  @@index([carePlanId, scheduledDate])
  @@map("care_plan_tasks")
}

// ==================== 离店后关怀跟踪（P5"会员体系/大健康延伸"切片，见业务规则确认记录"离店后关怀跟踪模块实现中"） ====================
// 具体关怀节点的天数/内容不由AI预设，只搭建可配置框架；由店长/护理人员手动为已离店的妈妈档案生成计划
// （不随房态离店流程自动触发），是结构上完全独立于CarePlan(住院期间护理方案)的运营型回访工具。

enum CareOutreachPlanStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

enum CareOutreachTaskStatus {
  PENDING
  COMPLETED
  SKIPPED
}

/// 关怀模板：总部统一定义关怀节点框架，同 care.plan-template/care.form-template 口径仅
/// SUPER_ADMIN维护。具体第几天提醒什么内容由用户/护理团队自行配置，不预设任何医学随访规则。
model CareOutreachTemplate {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  code      String
  name      String
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  items CareOutreachTemplateItem[]
  plans CareOutreachPlan[]

  @@unique([tenantId, code])
  @@map("care_outreach_templates")
}

model CareOutreachTemplateItem {
  id         String  @id @default(cuid())
  templateId String  @map("template_id")
  dayOffset  Int     @map("day_offset") // 离店日之后第几天，0=离店当天
  title      String
  content    String? @db.Text // 提醒要点/话术，自由文本，由用户/护理团队自行填写

  template CareOutreachTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, dayOffset, title])
  @@map("care_outreach_template_items")
}

/// 关怀计划：由店长/护理人员在母婴档案页手动选择模板生成（不随RoomOccupancy离店流程自动
/// 触发，避免侵入已充分测试的核心状态机，也便于按客户情况灵活选择模板）。
model CareOutreachPlan {
  id              String                 @id @default(cuid())
  tenantId        String                 @map("tenant_id")
  storeId         String                 @map("store_id")
  planNo          String                 @map("plan_no")
  templateId      String                 @map("template_id")
  motherProfileId String                 @map("mother_profile_id")
  checkedOutAt    DateTime               @map("checked_out_at") // 生成计划时锚定的离店日期，节点日期=此日期+dayOffset天
  status          CareOutreachPlanStatus @default(ACTIVE)
  terminateReason String?                @map("terminate_reason") @db.Text
  createdBy       String                 @map("created_by")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  version         Int                    @default(0)

  store         Store                @relation(fields: [storeId], references: [id])
  template      CareOutreachTemplate @relation(fields: [templateId], references: [id])
  motherProfile MotherProfile        @relation(fields: [motherProfileId], references: [id])
  tasks         CareOutreachTask[]

  @@unique([tenantId, planNo])
  @@index([tenantId, motherProfileId])
  @@map("care_outreach_plans")
}

/// 关怀任务：完成方式是简单打卡+备注（同AiSuggestion.accept/dismiss模式），不复用
/// CareFormTemplate/CareRecord的结构化临床记录引擎——回访提醒与住院期间规范化护理记录性质不同。
model CareOutreachTask {
  id             String                 @id @default(cuid())
  tenantId       String                 @map("tenant_id")
  storeId        String                 @map("store_id")
  planId         String                 @map("plan_id")
  dayOffset      Int                    @map("day_offset")
  scheduledDate  DateTime               @map("scheduled_date")
  title          String
  content        String?                @db.Text
  status         CareOutreachTaskStatus @default(PENDING)
  completedById  String?                @map("completed_by_id")
  completedAt    DateTime?              @map("completed_at")
  completionNote String?                @map("completion_note") @db.Text

  plan        CareOutreachPlan @relation(fields: [planId], references: [id])
  completedBy Account?         @relation(fields: [completedById], references: [id])
  store       Store            @relation(fields: [storeId], references: [id])

  @@index([tenantId, planId])
  @@index([tenantId, storeId, scheduledDate])
  @@map("care_outreach_tasks")
}

/// 护理执行记录：一旦提交不可编辑（原记录不可变）。当天遗漏的记录通过"补录"提交
/// （isBackfilled=true 且必须填 backfillReason）；对已提交记录的修正通过"更正"提交一条
/// 新记录（correctionOfId 指向原记录），原记录保留、新增更正记录，配合 AuditLog 留痕
/// （业务规则确认记录#7）。values 是字段值的快照（{fieldCode: value}），字段定义变更
/// 不影响历史记录内容。
model CareRecord {
  id              String         @id @default(cuid())
  tenantId        String         @map("tenant_id")
  storeId         String         @map("store_id")
  recordNo        String         @map("record_no")
  formTemplateId  String         @map("form_template_id")
  targetType      CareTargetType @map("target_type")
  motherProfileId String?        @map("mother_profile_id")
  babyProfileId   String?        @map("baby_profile_id")
  occurredAt      DateTime       @map("occurred_at") // 护理行为实际发生时间（如所属班次时段）
  values          Json // {fieldCode: value} 快照
  isBackfilled    Boolean        @default(false) @map("is_backfilled")
  backfillReason  String?        @map("backfill_reason") @db.Text
  correctionOfId  String?        @map("correction_of_id")
  submittedBy     String         @map("submitted_by")
  createdAt       DateTime       @default(now()) @map("created_at")

  store         Store             @relation(fields: [storeId], references: [id])
  formTemplate  CareFormTemplate  @relation(fields: [formTemplateId], references: [id])
  motherProfile MotherProfile?    @relation(fields: [motherProfileId], references: [id])
  babyProfile   BabyProfile?      @relation(fields: [babyProfileId], references: [id])
  correctionOf  CareRecord?       @relation("RecordCorrection", fields: [correctionOfId], references: [id])
  corrections   CareRecord[]      @relation("RecordCorrection")
  planTask      CarePlanTask?     @relation("TaskCareRecord")
  abnormalities CareAbnormality[]

  @@unique([tenantId, recordNo])
  @@index([tenantId, motherProfileId])
  @@index([tenantId, babyProfileId])
  @@map("care_records")
}

enum CareAbnormalityStatus {
  OPEN
  FOLLOWING
  RESOLVED
  IGNORED
}

/// 护理异常：由 CareRecord 提交时按字段定义的正常值域自动生成（单档判定，不做多级严重度，
/// 业务规则确认记录#7）。跟进复用平台通用的 FollowUpRecord（businessType='CARE_ABNORMALITY'），
/// 不新建独立跟进表。状态机：OPEN -> FOLLOWING -> RESOLVED；OPEN/FOLLOWING -> IGNORED。
model CareAbnormality {
  id              String                @id @default(cuid())
  tenantId        String                @map("tenant_id")
  storeId         String                @map("store_id")
  careRecordId    String                @map("care_record_id")
  fieldId         String                @map("field_id")
  targetType      CareTargetType        @map("target_type")
  motherProfileId String?               @map("mother_profile_id")
  babyProfileId   String?               @map("baby_profile_id")
  occurredAt      DateTime              @map("occurred_at")
  fieldValue      Json                  @map("field_value") // 触发异常的原始值快照
  status          CareAbnormalityStatus @default(OPEN)
  resolvedBy      String?               @map("resolved_by")
  resolvedAt      DateTime?             @map("resolved_at")
  resolveNote     String?               @map("resolve_note") @db.Text
  createdBy       String                @map("created_by")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  version         Int                   @default(0)

  store         Store               @relation(fields: [storeId], references: [id])
  careRecord    CareRecord          @relation(fields: [careRecordId], references: [id])
  field         CareFieldDefinition @relation(fields: [fieldId], references: [id])
  motherProfile MotherProfile?      @relation(fields: [motherProfileId], references: [id])
  babyProfile   BabyProfile?        @relation(fields: [babyProfileId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, motherProfileId])
  @@index([tenantId, babyProfileId])
  @@map("care_abnormalities")
}

// ==================== 住店运营细化（呼叫/外出/客房服务领用） ====================

enum RoomCallStatus {
  PENDING
  HANDLED
}

model RoomCall {
  id          String         @id @default(cuid())
  tenantId    String         @map("tenant_id")
  storeId     String         @map("store_id")
  occupancyId String         @map("occupancy_id")
  reason      String
  status      RoomCallStatus @default(PENDING)
  calledAt    DateTime       @default(now()) @map("called_at")
  handledAt   DateTime?      @map("handled_at")
  handledBy   String?        @map("handled_by")
  remark      String?        @db.Text
  createdBy   String         @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")

  store     Store         @relation(fields: [storeId], references: [id])
  occupancy RoomOccupancy @relation(fields: [occupancyId], references: [id])

  @@index([tenantId, status])
  @@map("room_calls")
}

enum RoomOutingStatus {
  PLANNED
  OUT
  RETURNED
  CANCELLED
}

/// 外出管理：PLANNED -(签出)-> OUT -(签回)-> RETURNED；PLANNED -> CANCELLED。
model RoomOuting {
  id            String           @id @default(cuid())
  tenantId      String           @map("tenant_id")
  storeId       String           @map("store_id")
  occupancyId   String           @map("occupancy_id")
  plannedOutAt  DateTime         @map("planned_out_at")
  plannedBackAt DateTime         @map("planned_back_at")
  actualOutAt   DateTime?        @map("actual_out_at")
  actualBackAt  DateTime?        @map("actual_back_at")
  riskNote      String?          @map("risk_note") @db.Text
  status        RoomOutingStatus @default(PLANNED)
  cancelReason  String?          @map("cancel_reason") @db.Text
  createdBy     String           @map("created_by")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  version       Int              @default(0)

  store     Store         @relation(fields: [storeId], references: [id])
  occupancy RoomOccupancy @relation(fields: [occupancyId], references: [id])

  @@index([tenantId, status])
  @@map("room_outings")
}

enum RoomRequisitionStatus {
  REQUESTED
  FULFILLED
}

/// 客房服务领用：本期不接库存域（P3 才有真实进销存单据），itemName 为自由文本登记，
/// 不与任何库存表联动扣减，待 P3 库存域落地后再补出库单联动。
model RoomServiceRequisition {
  id          String                @id @default(cuid())
  tenantId    String                @map("tenant_id")
  storeId     String                @map("store_id")
  occupancyId String                @map("occupancy_id")
  itemName    String                @map("item_name")
  quantity    Int                   @default(1)
  status      RoomRequisitionStatus @default(REQUESTED)
  requestedAt DateTime              @default(now()) @map("requested_at")
  fulfilledAt DateTime?             @map("fulfilled_at")
  fulfilledBy String?               @map("fulfilled_by")
  remark      String?               @db.Text
  createdBy   String                @map("created_by")
  createdAt   DateTime              @default(now()) @map("created_at")

  store     Store         @relation(fields: [storeId], references: [id])
  occupancy RoomOccupancy @relation(fields: [occupancyId], references: [id])

  @@index([tenantId, status])
  @@map("room_service_requisitions")
}

// ==================== 月子餐（膳食域） ====================
// 业务规则依据：docs/竞品分析-一月妈咪月子中心管理系统功能架构逆向分析.md 3.6 节。
// 预算→采购/出库联动（与库存打通）本期不做，待 P3 库存域落地后再接入。

enum MealPlanType {
  MONTH_MEAL // 月子餐
  MINI_MONTH // 小月子
  TRIAL // 试吃
  DELIVERY // 外送餐
  VIP
}

enum MealSlot {
  BREAKFAST
  MORNING_SNACK
  LUNCH
  AFTERNOON_SNACK
  DINNER
  NIGHT_SNACK
}

/// 膳食计划模板：phases 仅作阶段化展示用（如"7-7-7-7"对应产褥期分阶段营养需求），
/// 真正驱动每日排餐的是 MealPlanTemplateItem（dayOffset+slot -> 默认菜品）。
model MealPlanTemplate {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  code      String
  name      String
  planType  MealPlanType @map("plan_type")
  totalDays Int          @map("total_days")
  phases    Json? // 展示用：[{name,days}]
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  items         MealPlanTemplateItem[]
  dinerProfiles DinerProfile[]

  @@unique([tenantId, code])
  @@map("meal_plan_templates")
}

/// 菜品：ingredientTags 用于与"食材类禁忌"做冲突匹配（DietaryRestriction.category=INGREDIENT）。
model MealItem {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  code           String
  name           String
  defaultSlot    MealSlot     @map("default_slot")
  ingredientTags Json? // string[]
  status         CommonStatus @default(ACTIVE)
  createdBy      String       @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  version        Int          @default(0)

  planItems           MealPlanTemplateItem[]
  mealRecordsDefault  MealRecord[]           @relation("DefaultMealItem")
  mealRecordsSelected MealRecord[]           @relation("SelectedMealItem")

  @@unique([tenantId, code])
  @@map("meal_items")
}

model MealPlanTemplateItem {
  id             String   @id @default(cuid())
  planTemplateId String   @map("plan_template_id")
  dayOffset      Int      @map("day_offset")
  slot           MealSlot
  mealItemId     String   @map("meal_item_id")

  planTemplate MealPlanTemplate @relation(fields: [planTemplateId], references: [id])
  mealItem     MealItem         @relation(fields: [mealItemId], references: [id])

  @@unique([planTemplateId, dayOffset, slot])
  @@map("meal_plan_template_items")
}

enum DietaryRestrictionCategory {
  INGREDIENT // 食材类：忌鸡蛋/忌牛肉等
  MEDICAL // 病理性：妊娠高血压/妊娠糖尿病等
}

model DietaryRestriction {
  id        String                     @id @default(cuid())
  tenantId  String                     @map("tenant_id")
  code      String
  name      String
  category  DietaryRestrictionCategory
  status    CommonStatus               @default(ACTIVE)
  createdBy String                     @map("created_by")
  createdAt DateTime                   @default(now()) @map("created_at")
  updatedAt DateTime                   @updatedAt @map("updated_at")
  version   Int                        @default(0)

  dinerRestrictions DinerRestriction[]

  @@unique([tenantId, code])
  @@map("dietary_restrictions")
}

enum DinerProfileStatus {
  ACTIVE
  ENDED
}

/// 用膳人：客户绑定膳食计划模板的一段用膳周期，startDate/endDate 由 totalDays 推算。
/// 创建时按 MealPlanTemplateItem 批量生成 MealRecord（同 CarePlan 生成 CarePlanTask 的模式）。
model DinerProfile {
  id                 String             @id @default(cuid())
  tenantId           String             @map("tenant_id")
  storeId            String             @map("store_id")
  customerId         String             @map("customer_id")
  mealPlanTemplateId String             @map("meal_plan_template_id")
  occupancyId        String?            @map("occupancy_id")
  startDate          DateTime           @map("start_date")
  endDate            DateTime           @map("end_date")
  status             DinerProfileStatus @default(ACTIVE)
  createdBy          String             @map("created_by")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  version            Int                @default(0)

  store            Store              @relation(fields: [storeId], references: [id])
  customer         Customer           @relation(fields: [customerId], references: [id])
  mealPlanTemplate MealPlanTemplate   @relation(fields: [mealPlanTemplateId], references: [id])
  occupancy        RoomOccupancy?     @relation(fields: [occupancyId], references: [id])
  restrictions     DinerRestriction[]
  mealRecords      MealRecord[]

  @@index([tenantId, customerId])
  @@map("diner_profiles")
}

model DinerRestriction {
  id             String @id @default(cuid())
  dinerProfileId String @map("diner_profile_id")
  restrictionId  String @map("restriction_id")

  dinerProfile DinerProfile       @relation(fields: [dinerProfileId], references: [id])
  restriction  DietaryRestriction @relation(fields: [restrictionId], references: [id])

  @@unique([dinerProfileId, restrictionId])
  @@map("diner_restrictions")
}

enum MealRecordStatus {
  PLANNED
  SERVED
  CANCELLED
}

/// 每日排餐记录：defaultMealItemId 来自方案排期，isCustomSelected 标记客户"自选餐"覆盖了
/// 默认菜品（早餐/早点不可当日自选、当日9点后不可自选，见 MealRecordService 注释）。
model MealRecord {
  id                 String           @id @default(cuid())
  tenantId           String           @map("tenant_id")
  storeId            String           @map("store_id")
  dinerProfileId     String           @map("diner_profile_id")
  scheduledDate      DateTime         @map("scheduled_date")
  slot               MealSlot
  defaultMealItemId  String           @map("default_meal_item_id")
  isCustomSelected   Boolean          @default(false) @map("is_custom_selected")
  selectedMealItemId String?          @map("selected_meal_item_id")
  selectedAt         DateTime?        @map("selected_at")
  status             MealRecordStatus @default(PLANNED)
  servedAt           DateTime?        @map("served_at")
  servedBy           String?          @map("served_by")
  rating             Int?
  comment            String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  version            Int              @default(0)

  store            Store        @relation(fields: [storeId], references: [id])
  dinerProfile     DinerProfile @relation(fields: [dinerProfileId], references: [id])
  defaultMealItem  MealItem     @relation("DefaultMealItem", fields: [defaultMealItemId], references: [id])
  selectedMealItem MealItem?    @relation("SelectedMealItem", fields: [selectedMealItemId], references: [id])

  @@index([tenantId, dinerProfileId, scheduledDate])
  @@map("meal_records")
}

// ==================== 产康服务（服务域） ====================
// 业务规则依据：docs/竞品分析-一月妈咪月子中心管理系统功能架构逆向分析.md 3.4 节。
// 本期不做：跨店服务通兑、双销售人分成、优惠审批、物料出库联动——均待后续切片/P3库存域补上。

model ServiceProduct {
  id              String       @id @default(cuid())
  tenantId        String       @map("tenant_id")
  code            String
  name            String
  durationMinutes Int?         @map("duration_minutes")
  unitPrice       Int?         @map("unit_price") // 最小货币单位，可空——仅按套餐消耗、不单卖的项目可不设散卖价
  status          CommonStatus @default(ACTIVE)
  createdBy       String       @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  version         Int          @default(0)

  appointments ServiceAppointment[]

  @@unique([tenantId, code])
  @@map("service_products")
}

/// 服务包：购买时不预先绑定具体项目，执行时才临时消耗额度（"按需项目机制"，竞品分析3.4）。
model ServicePackage {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  code          String
  name          String
  totalSessions Int          @map("total_sessions")
  price         Int // 最小货币单位
  status        CommonStatus @default(ACTIVE)
  createdBy     String       @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  version       Int          @default(0)

  customerPackages CustomerServicePackage[]

  @@unique([tenantId, code])
  @@map("service_packages")
}

enum CustomerServicePackageStatus {
  ACTIVE
  EXHAUSTED
}

model CustomerServicePackage {
  id                String                       @id @default(cuid())
  tenantId          String                       @map("tenant_id")
  storeId           String                       @map("store_id")
  customerId        String                       @map("customer_id")
  packageId         String                       @map("package_id")
  remainingSessions Int                          @map("remaining_sessions")
  amount            Int
  status            CustomerServicePackageStatus @default(ACTIVE)
  purchasedAt       DateTime                     @default(now()) @map("purchased_at")
  createdBy         String                       @map("created_by")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  version           Int                          @default(0)

  store        Store                @relation(fields: [storeId], references: [id])
  customer     Customer             @relation(fields: [customerId], references: [id])
  package      ServicePackage       @relation(fields: [packageId], references: [id])
  appointments ServiceAppointment[]

  @@index([tenantId, customerId])
  @@map("customer_service_packages")
}

model Therapist {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  storeId   String       @map("store_id")
  name      String
  phone     String?
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  store        Store                @relation(fields: [storeId], references: [id])
  appointments ServiceAppointment[]

  @@index([tenantId, storeId])
  @@map("therapists")
}

enum ServiceAppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// 预约：BOOKED -(完成)-> COMPLETED（若 sourcePackageId 存在则扣减套餐剩余次数）；
/// BOOKED -> CANCELLED/NO_SHOW。完成即视为执行+消项（本期不拆独立执行记录表）。
model ServiceAppointment {
  id              String                   @id @default(cuid())
  tenantId        String                   @map("tenant_id")
  storeId         String                   @map("store_id")
  appointmentNo   String                   @map("appointment_no")
  customerId      String                   @map("customer_id")
  productId       String                   @map("product_id")
  therapistId     String?                  @map("therapist_id")
  sourcePackageId String?                  @map("source_package_id")
  scheduledAt     DateTime                 @map("scheduled_at")
  durationMinutes Int                      @map("duration_minutes")
  status          ServiceAppointmentStatus @default(BOOKED)
  completedAt     DateTime?                @map("completed_at")
  cancelReason    String?                  @map("cancel_reason") @db.Text
  rating          Int?
  comment         String?                  @db.Text
  createdBy       String                   @map("created_by")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  version         Int                      @default(0)

  store         Store                   @relation(fields: [storeId], references: [id])
  customer      Customer                @relation(fields: [customerId], references: [id])
  product       ServiceProduct          @relation(fields: [productId], references: [id])
  therapist     Therapist?              @relation(fields: [therapistId], references: [id])
  sourcePackage CustomerServicePackage? @relation(fields: [sourcePackageId], references: [id])

  @@unique([tenantId, appointmentNo])
  @@index([tenantId, customerId])
  @@index([tenantId, therapistId, scheduledAt])
  @@map("service_appointments")
}

// ==================== 库存（进销存全链路，交易与供应域） ====================
// 业务规则依据：docs/竞品分析-一月妈咪月子中心管理系统功能架构逆向分析.md 3.7 节
// + docs/伴月轩月子中心管理系统_新系统开发文档_V1.0.docx 第9章"后勤管理"（复用同一套模型）。
// 单据状态机审批复用通用工作流引擎，采用与 Contract/Payment 完全相同的
// "reconcileStatus() 懒同步"模式（见各 Service 注释），不侵入 WorkflowEngineModule。
// 范围收窄（记录供后续参考）：
//   - 采购单(PurchaseOrder)始终走审批，不受仓库"免审批"配置影响（花钱承诺，风险等级不同于仓内操作）；
//     入库单若挂在已审批的采购单下则跳过自身审批（视为已获授权），未挂采购单的临时入库仍按
//     仓库 requiresApproval 配置决定是否需要审批；出库/领用/调拨/盘点同样按仓库配置决定。
//   - 调拨单以"源仓库"的 requiresApproval 配置为准（源头承担风险方）。
//   - 不做采购单"收货进度/超收校验"，入库数量与采购数量的对比只做展示，不做强校验。
//   - 服务物料桥梁（护理/产康服务核销后自动生成待出库列表）、备料包（套餐→物料清单自动关联）
//     本期不做，待后续切片把 P2 的护理/产康/月子餐模块反向接入库存域时再设计。
//   - 移动加权平均法核算成本；批次(StockBatch)只追踪数量与效期，用于"先到期先出"(FEFO)扣减与
//     过期预警，不做批次级FIFO成本核算（成本核算只在 WarehouseStock 汇总层做加权平均）。

enum WarehousePurpose {
  OPERATING // 经营性库存（食材、服务耗材等）
  LOGISTICS // 后勤库房（P3后勤管理模块复用同一套模型，仅用本字段隔离）
}

model Supplier {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  code        String
  name        String
  contactName String?      @map("contact_name")
  phone       String?
  remark      String?      @db.Text
  status      CommonStatus @default(ACTIVE)
  createdBy   String       @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  version     Int          @default(0)

  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@map("suppliers")
}

/// 仓库：requiresApproval=false 时该仓库的入库/出库/领用/盘点单跳过工作流审批，直接
/// DRAFT->APPROVED（"仓库级免审批"配置，竞品分析3.7）。
model Warehouse {
  id               String           @id @default(cuid())
  tenantId         String           @map("tenant_id")
  storeId          String           @map("store_id")
  code             String
  name             String
  purpose          WarehousePurpose @default(OPERATING)
  requiresApproval Boolean          @default(true) @map("requires_approval")
  status           CommonStatus     @default(ACTIVE)
  createdBy        String           @map("created_by")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  version          Int              @default(0)

  store          Store            @relation(fields: [storeId], references: [id])
  stocks         WarehouseStock[]
  batches        StockBatch[]
  goodsReceipts  GoodsReceipt[]
  stockIssues    StockIssue[]
  transfersOut   StockTransfer[]  @relation("TransferFrom")
  transfersIn    StockTransfer[]  @relation("TransferTo")
  stockCounts    StockCount[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@map("warehouses")
}

model InventoryItem {
  id                   String           @id @default(cuid())
  tenantId             String           @map("tenant_id")
  code                 String
  name                 String
  unit                 String // 计量单位，如"件"/"kg"/"箱"
  category             String?
  spec                 String?          @db.VarChar(200) // 规格/型号/尺寸（如“100*120”“27卷/箱”）
  brand                String?          @db.VarChar(100) // 品牌
  referencePrice       Decimal?         @map("reference_price") @db.Decimal(12, 4) // 参考单价（最近一次采购价，按“单位”计），仅供申购参考
  purpose              WarehousePurpose @default(OPERATING)
  safetyStockThreshold Int?             @map("safety_stock_threshold") // 低于此数量触发低库存预警，空=不预警
  shelfLifeDays        Int?             @map("shelf_life_days") // 保质期天数，空=不追踪效期
  status               CommonStatus     @default(ACTIVE)
  createdBy            String           @map("created_by")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  version              Int              @default(0)

  stocks               WarehouseStock[]
  batches              StockBatch[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseRequestItems PurchaseRequestItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  stockIssueItems      StockIssueItem[]
  stockTransferItems   StockTransferItem[]
  stockCountItems      StockCountItem[]

  @@unique([tenantId, code])
  @@map("inventory_items")
}

/// 库存汇总层：每个仓库+物品的当前数量与移动加权平均成本，只能被各单据的 execute() 更新，
/// 不提供直接编辑接口（保证所有变动都有单据留痕）。
model WarehouseStock {
  id          String   @id @default(cuid())
  warehouseId String   @map("warehouse_id")
  itemId      String   @map("item_id")
  quantity    Int      @default(0)
  avgCost     Int      @default(0) @map("avg_cost") // 移动加权平均单位成本，最小货币单位
  version     Int      @default(0) // 乐观锁：quantity/avgCost 是"读旧值算新值再写回"，并发入出库
  // 必须靠这个字段做重试保护，纯 increment/decrement 不足以保护成本这类需要重新计算的字段
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  item      InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([warehouseId, itemId])
  @@map("warehouse_stocks")
}

/// 批次层：追踪效期用于 FEFO（先到期先出）扣减与过期预警，不做批次级成本核算。
/// sourceType/sourceId 追溯批次的产生来源（入库单/调拨单/盘点盈余）。
model StockBatch {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  warehouseId String    @map("warehouse_id")
  itemId      String    @map("item_id")
  batchNo     String    @map("batch_no")
  quantity    Int // 该批次剩余数量
  unitCost    Int       @map("unit_cost") // 该批次入库时的单位成本，仅供追溯展示
  receivedAt  DateTime  @map("received_at")
  expiresAt   DateTime? @map("expires_at") // 空=不追踪效期（item.shelfLifeDays 未配置）
  sourceType  String    @map("source_type") // GOODS_RECEIPT / STOCK_TRANSFER / STOCK_COUNT
  sourceId    String    @map("source_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  item      InventoryItem @relation(fields: [itemId], references: [id])

  @@index([warehouseId, itemId, expiresAt])
  @@map("stock_batches")
}

enum InventoryDocStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  /// 采购单：采购员已完成采购，等货到（已自动生成待收货的入库单）
  PURCHASED
  /// 入库单：等快递到货，客服逐项确认收货
  PENDING_RECEIPT
  /// 采购单/入库单：已有部分货品到货入库，还有没到的
  PARTIALLY_RECEIVED
}

/// 申购单类型：DEPARTMENT=部门申购单（部门负责人填，提交后自动出现在客服的“待汇总”里，本身不走审批）；
/// SUMMARY=汇总申购单（客服汇总各部门申购单生成，或沿用 Excel 导入的整张申购表；提交店长审批）
enum PurchaseRequestKind {
  SUMMARY
  DEPARTMENT
}

enum PurchaseRequestStatus {
  DRAFT // 草稿（刚导入/刚建，可改数量单价）
  PENDING_APPROVAL // 审批中
  APPROVED // 已批准（可生成采购单）
  REJECTED // 已驳回
  CANCELLED // 已取消
  ORDERED // 已生成采购单
  SUBMITTED // 部门申购单：已提交，等客服汇总
  COLLECTED // 部门申购单：已被客服汇总进某张汇总申购单
}

/// 申购单(SG)：各部门每月提交的采购申请（对应公司现在用的《申购表》Excel：申请部门、申请人、物品、数量、单价、用途）。
/// 流程：导入/新建(DRAFT) → 提交审批(PENDING_APPROVAL，走通用工作流，店长审批) → APPROVED → 选供应商和仓库“生成采购单”(ORDERED)。
/// 金额用元（小数），生成采购单时单价四舍五入到分。
model PurchaseRequest {
  id               String                @id @default(cuid())
  tenantId         String                @map("tenant_id")
  storeId          String                @map("store_id")
  requestNo        String                @map("request_no")
  requestDate      DateTime              @map("request_date") @db.Date // 申购日期（表头里的日期，如 2026.8.25）
  status           PurchaseRequestStatus @default(DRAFT)
  totalAmount      Decimal               @default(0) @map("total_amount") @db.Decimal(14, 2) // 冗余汇总，元
  sourceFileName   String?               @map("source_file_name") // Excel 导入时的文件名
  remark           String?               @db.Text
  cancelReason     String?               @map("cancel_reason") @db.Text
  purchaseOrderId  String?               @map("purchase_order_id") // 已生成的采购单
  kind             PurchaseRequestKind   @default(SUMMARY)
  departmentName   String?               @map("department_name") // 部门申购单：申请部门
  summaryRequestId String?               @map("summary_request_id") // 部门申购单被汇总进的汇总申购单
  createdBy        String                @map("created_by")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  version          Int                   @default(0)

  store          Store                 @relation(fields: [storeId], references: [id])
  purchaseOrder  PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  items          PurchaseRequestItem[]
  summaryRequest PurchaseRequest?      @relation("RequestCollect", fields: [summaryRequestId], references: [id])
  collected      PurchaseRequest[]     @relation("RequestCollect")

  @@unique([tenantId, requestNo])
  @@index([tenantId, storeId, requestDate])
  @@index([tenantId, status])
  @@index([tenantId, kind, status])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String   @id @default(cuid())
  purchaseRequestId String   @map("purchase_request_id")
  sortNo            Int      @map("sort_no") // 在表里的先后顺序
  itemId            String?  @map("item_id") // 对应的物品资料（没对上时为空，生成采购单前要补）
  name              String // 物品名称（申购时的快照）
  spec              String?  @db.VarChar(200)
  brand             String?  @db.VarChar(100)
  unit              String?
  quantity          Int
  unitPrice         Decimal? @map("unit_price") @db.Decimal(12, 4) // 元；没填 = 待询价
  subtotal          Decimal  @default(0) @db.Decimal(14, 2) // quantity * unitPrice，没单价时为 0
  department        String? // 申请部门
  requester         String? // 申请人
  purpose           String? // 用途
  remark            String?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  item            InventoryItem?  @relation(fields: [itemId], references: [id])

  @@index([purchaseRequestId])
  @@map("purchase_request_items")
}

/// 采购单(CG)：DRAFT -(提交)-> PENDING_APPROVAL -(工作流审批)-> APPROVED/REJECTED；
/// APPROVED 后可据此创建入库单（收货数量与采购数量的对比只做展示，不做强校验，见 schema 顶部范围收窄说明）。
model PurchaseOrder {
  id            String             @id @default(cuid())
  tenantId      String             @map("tenant_id")
  storeId       String             @map("store_id")
  warehouseId   String             @map("warehouse_id")
  supplierId    String             @map("supplier_id")
  orderNo       String             @map("order_no")
  status        InventoryDocStatus @default(DRAFT)
  totalAmount   Int                @default(0) @map("total_amount") // 冗余汇总，最小货币单位
  remark        String?            @db.Text
  cancelReason  String?            @map("cancel_reason") @db.Text
  /// 采购员点“确认采购”的时间/人、运单号与备注（确认采购会自动生成待收货的入库单）
  purchasedAt   DateTime?          @map("purchased_at")
  purchasedById String?            @map("purchased_by_id")
  expressNo     String?            @map("express_no")
  purchaseNote  String?            @map("purchase_note") @db.Text
  createdBy     String             @map("created_by")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  version       Int                @default(0)

  store            Store               @relation(fields: [storeId], references: [id])
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id])
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  items            PurchaseOrderItem[]
  goodsReceipts    GoodsReceipt[]
  purchaseRequests PurchaseRequest[]

  @@unique([tenantId, orderNo])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String @map("purchase_order_id")
  itemId          String @map("item_id")
  quantity        Int
  unitPrice       Int    @map("unit_price") // 最小货币单位
  subtotal        Int // quantity * unitPrice，创建时算好落库，避免每次读取重复计算

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  item          InventoryItem @relation(fields: [itemId], references: [id])

  @@map("purchase_order_items")
}

/// 入库单(RK)：执行(execute)时更新 WarehouseStock（移动加权平均法重算成本）并生成 StockBatch。
/// 完成后不可变，需要冲正时创建一张新的入库单/出库单反向操作，不修改已完成单据本身。
model GoodsReceipt {
  id              String             @id @default(cuid())
  tenantId        String             @map("tenant_id")
  storeId         String             @map("store_id")
  warehouseId     String             @map("warehouse_id")
  purchaseOrderId String?            @map("purchase_order_id") // 挂在已审批采购单下则跳过自身审批
  receiptNo       String             @map("receipt_no")
  status          InventoryDocStatus @default(DRAFT)
  remark          String?            @db.Text
  cancelReason    String?            @map("cancel_reason") @db.Text
  completedAt     DateTime?          @map("completed_at")
  /// 逐项收货的入库单（由“确认采购”自动生成）：货品陆续到，客服每次确认到了哪几项、各多少，立即入库；
  /// 不走“提交→执行”。老的手工入库单 tracked=false，行为不变。
  tracked         Boolean            @default(false)
  shortClosedNote String?            @map("short_closed_note") @db.Text // 结束收货时登记的“未到货原因”
  createdBy       String             @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  version         Int                @default(0)

  store         Store                      @relation(fields: [storeId], references: [id])
  warehouse     Warehouse                  @relation(fields: [warehouseId], references: [id])
  purchaseOrder PurchaseOrder?             @relation(fields: [purchaseOrderId], references: [id])
  items         GoodsReceiptItem[]
  confirmations GoodsReceiptConfirmation[]

  @@unique([tenantId, receiptNo])
  @@index([tenantId, status])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id               String @id @default(cuid())
  goodsReceiptId   String @map("goods_receipt_id")
  itemId           String @map("item_id")
  quantity         Int // 老入库单：本次入库数量；逐项收货的入库单：采购数量（应到）
  unitCost         Int    @map("unit_cost") // 最小货币单位，用于移动加权平均法与批次成本
  receivedQuantity Int    @default(0) @map("received_quantity") // 逐项收货的入库单：已到货入库的累计数量

  goodsReceipt      GoodsReceipt                   @relation(fields: [goodsReceiptId], references: [id])
  item              InventoryItem                  @relation(fields: [itemId], references: [id])
  confirmationLines GoodsReceiptConfirmationLine[]

  @@map("goods_receipt_items")
}

/// 收货确认记录：每次快递到货，客服确认收到了哪几项、各多少，对应一次库存入账。
model GoodsReceiptConfirmation {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  goodsReceiptId String   @map("goods_receipt_id")
  confirmedById  String   @map("confirmed_by_id")
  confirmedAt    DateTime @default(now()) @map("confirmed_at")
  expressNo      String?  @map("express_no") // 这一批的快递单号
  note           String?  @db.Text

  goodsReceipt GoodsReceipt                   @relation(fields: [goodsReceiptId], references: [id])
  lines        GoodsReceiptConfirmationLine[]

  @@index([goodsReceiptId, confirmedAt])
  @@map("goods_receipt_confirmations")
}

model GoodsReceiptConfirmationLine {
  id                 String    @id @default(cuid())
  confirmationId     String    @map("confirmation_id")
  goodsReceiptItemId String    @map("goods_receipt_item_id")
  quantity           Int
  expiresAt          DateTime? @map("expires_at") // 这批货的到期日（不填则按物品保质期推算）
  note               String? // 如：外包装破损、少 1 件

  confirmation GoodsReceiptConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  receiptItem  GoodsReceiptItem         @relation(fields: [goodsReceiptItemId], references: [id])

  @@index([confirmationId])
  @@map("goods_receipt_confirmation_lines")
}

enum StockIssueType {
  ISSUE // 一般出库
  REQUISITION // 部门领用（对应竞品分析的"领用单(LY)"，用途/部门在 remark 里登记）
  LOSS // 报损
}

/// 出库/领用单(CK/LY 合一，用 issueType 区分)：执行时按 FEFO 扣减 StockBatch，
/// WarehouseStock.avgCost 不变（出库不改变剩余库存的加权平均成本）。
model StockIssue {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  storeId      String             @map("store_id")
  warehouseId  String             @map("warehouse_id")
  issueNo      String             @map("issue_no")
  issueType    StockIssueType     @default(ISSUE) @map("issue_type")
  status       InventoryDocStatus @default(DRAFT)
  remark       String?            @db.Text
  cancelReason String?            @map("cancel_reason") @db.Text
  completedAt  DateTime?          @map("completed_at")
  createdBy    String             @map("created_by")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  version      Int                @default(0)

  store     Store            @relation(fields: [storeId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  items     StockIssueItem[]

  @@unique([tenantId, issueNo])
  @@index([tenantId, status])
  @@map("stock_issues")
}

model StockIssueItem {
  id           String @id @default(cuid())
  stockIssueId String @map("stock_issue_id")
  itemId       String @map("item_id")
  quantity     Int
  unitCost     Int?   @map("unit_cost") // 执行时按当前 avgCost 快照写入，用于成本报表，创建时为空

  stockIssue StockIssue    @relation(fields: [stockIssueId], references: [id])
  item       InventoryItem @relation(fields: [itemId], references: [id])

  @@map("stock_issue_items")
}

/// 调拨单(DB，含跨店)：以源仓库(fromWarehouse)的 requiresApproval 配置决定是否需要审批。
/// 执行时源仓库按 FEFO 扣减、批次"搬家"到目标仓库（沿用原 receivedAt/expiresAt），
/// 目标仓库按移动加权平均法用源仓库当前 avgCost 重算成本。
model StockTransfer {
  id              String             @id @default(cuid())
  tenantId        String             @map("tenant_id")
  fromWarehouseId String             @map("from_warehouse_id")
  toWarehouseId   String             @map("to_warehouse_id")
  transferNo      String             @map("transfer_no")
  status          InventoryDocStatus @default(DRAFT)
  remark          String?            @db.Text
  cancelReason    String?            @map("cancel_reason") @db.Text
  completedAt     DateTime?          @map("completed_at")
  createdBy       String             @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  version         Int                @default(0)

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items         StockTransferItem[]

  @@unique([tenantId, transferNo])
  @@index([tenantId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id              String @id @default(cuid())
  stockTransferId String @map("stock_transfer_id")
  itemId          String @map("item_id")
  quantity        Int

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id])
  item          InventoryItem @relation(fields: [itemId], references: [id])

  @@map("stock_transfer_items")
}

/// 盘点单(PD)：创建时快照系统当前数量(systemQuantity)，执行时把 WarehouseStock.quantity
/// 直接修正为盘点数(countedQuantity)，盈亏差额(diffQuantity)通过批次调整留痕
/// （盘盈生成新批次、盘亏按FEFO消耗批次），avgCost 不变。
model StockCount {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  storeId      String             @map("store_id")
  warehouseId  String             @map("warehouse_id")
  countNo      String             @map("count_no")
  status       InventoryDocStatus @default(DRAFT)
  remark       String?            @db.Text
  cancelReason String?            @map("cancel_reason") @db.Text
  completedAt  DateTime?          @map("completed_at")
  createdBy    String             @map("created_by")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  version      Int                @default(0)

  store     Store            @relation(fields: [storeId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  items     StockCountItem[]

  @@unique([tenantId, countNo])
  @@index([tenantId, status])
  @@map("stock_counts")
}

model StockCountItem {
  id              String @id @default(cuid())
  stockCountId    String @map("stock_count_id")
  itemId          String @map("item_id")
  systemQuantity  Int    @map("system_quantity") // 创建盘点单时快照的系统账面数量
  countedQuantity Int    @map("counted_quantity") // 实际盘点数量
  diffQuantity    Int    @map("diff_quantity") // countedQuantity - systemQuantity，创建时算好落库

  stockCount StockCount    @relation(fields: [stockCountId], references: [id])
  item       InventoryItem @relation(fields: [itemId], references: [id])

  @@map("stock_count_items")
}

// ==================== 人事（组织与治理域） ====================
// 业务规则依据：docs/竞品分析-一月妈咪月子中心管理系统功能架构逆向分析.md 3.9 节
// + docs/业务规则确认记录.md「2026-07-29 P3人事排班薪酬启动」章节的范围收窄记录。
// 提成/薪资审批复用通用工作流引擎，采用与 Contract/Payment/Inventory 完全相同的
// "reconcileStatus() 懒同步"模式。
// 范围收窄（记录供后续参考）：
//   - 员工档案是 Account 的 1:1 HR 扩展，不重开一套身份信息。
//   - 业绩提成(三级分账)与手工费(三人分摊)统一成一个 CommissionRecord+Allocation 模型，
//     角色用自由文本而非写死的三级/三人枚举。
//   - 业绩目标三级分配、变更管理自动冲正、排班冲突检测/自动排班建议、到期提醒的自动推送——
//     本期均不做。

enum EmploymentType {
  EMPLOYEE // 员工制
  NON_EMPLOYEE // 非员工制（如按次结算的兼职/合作人员）
}

enum EmployeeGender {
  MALE
  FEMALE
}

/// 员工合同类型（对应员工信息表“合同类型”列）
enum EmployeeContractType {
  LABOR // 劳动合同
  PROBATION // 试用期合同
  SERVICE // 劳务合同
  OVERAGE // 用工协议（超龄）
  PENDING_SIGN // 待签
}

/// 社保缴纳（对应员工信息表“社保缴纳”列：参保 / “/”）
enum SocialInsuranceStatus {
  ENROLLED // 参保
  NOT_ENROLLED // 未参保
}

enum EmployeeProfileStatus {
  ACTIVE // 在职
  ON_LEAVE // 休假中
  TERMINATED // 已离职
}

/// 员工档案：Account 的 1:1 HR 扩展（姓名/门店/部门/团队/职位等身份信息已在 Account 上，
/// 这里只存 HR 特有字段），accountId 唯一。
model EmployeeProfile {
  id                       String                 @id @default(cuid())
  tenantId                 String                 @map("tenant_id")
  accountId                String                 @unique @map("account_id")
  employeeNo               String                 @map("employee_no") // 工号（归档后仍保留，用于历史查询）
  /// 占用中的工号：在册员工 = employeeNo；离职归档后置空 → 工号释放，可回收给新员工。唯一约束建在这一列上。
  activeEmployeeNo         String?                @map("active_employee_no")
  /// 离职归档时间；归档后档案只读、账号停用、工号释放
  archivedAt               DateTime?              @map("archived_at")
  hireDate                 DateTime               @map("hire_date")
  employmentType           EmploymentType         @default(EMPLOYEE) @map("employment_type")
  healthCertExpiresAt      DateTime?              @map("health_cert_expires_at")
  contractExpiresAt        DateTime?              @map("contract_expires_at")
  probationEndsAt          DateTime?              @map("probation_ends_at")
  terminationDate          DateTime?              @map("termination_date")
  terminationReason        String?                @map("termination_reason") // 离职原因
  status                   EmployeeProfileStatus  @default(ACTIVE)
  // —— 员工信息表里的字段 ——
  contractType             EmployeeContractType?  @map("contract_type") // 合同类型
  socialInsurance          SocialInsuranceStatus? @map("social_insurance") // 社保缴纳
  idCardNo                 String?                @map("id_card_no") @db.VarChar(18) // 身份证号（敏感，按权限掩码）
  gender                   EmployeeGender? // 性别（填身份证号时自动识别）
  birthDate                DateTime?              @map("birth_date") @db.Date // 出生日期（填身份证号时自动识别）
  bankAccountNo            String?                @map("bank_account_no") @db.VarChar(32) // 工资卡账号（敏感，按权限掩码）
  bankName                 String?                @map("bank_name") @db.VarChar(100) // 开户行
  emergencyContactName     String?                @map("emergency_contact_name") // 紧急联系人
  emergencyContactPhone    String?                @map("emergency_contact_phone")
  emergencyContactRelation String?                @map("emergency_contact_relation") // 与员工关系
  address                  String?                @db.VarChar(255) // 现住址
  remark                   String?                @db.Text
  createdBy                String                 @map("created_by")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  version                  Int                    @default(0)

  account               Account                @relation(fields: [accountId], references: [id])
  scheduleEntries       ScheduleEntry[]
  commissionAllocations CommissionAllocation[]
  payrollRecords        PayrollRecord[]
  leaveRequests         LeaveRequest[]

  @@unique([tenantId, activeEmployeeNo])
  @@unique([tenantId, idCardNo])
  @@index([tenantId, employeeNo])
  @@map("employee_profiles")
}

/// 班次定义：门店级可配置（不同门店班次时段可能不同），如白班/中班/晚班/夜班/护士早班。
model ShiftDefinition {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  storeId   String       @map("store_id")
  code      String
  name      String
  startTime String       @map("start_time") // "HH:mm"，跨零点的班次（如夜班22:00-06:00）由前端按 startTime>endTime 判断显示
  endTime   String       @map("end_time")
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  store           Store           @relation(fields: [storeId], references: [id])
  scheduleEntries ScheduleEntry[]

  @@unique([tenantId, storeId, code])
  @@map("shift_definitions")
}

/// 排班记录：一名员工一天一条（本期不支持一天拆分多班次）。
model ScheduleEntry {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  storeId           String   @map("store_id")
  employeeProfileId String   @map("employee_profile_id")
  workDate          DateTime @map("work_date")
  shiftDefinitionId String   @map("shift_definition_id")
  remark            String?  @db.Text
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  version           Int      @default(0)

  store           Store           @relation(fields: [storeId], references: [id])
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id])
  shiftDefinition ShiftDefinition @relation(fields: [shiftDefinitionId], references: [id])

  @@unique([employeeProfileId, workDate])
  @@index([tenantId, storeId, workDate])
  @@map("schedule_entries")
}

enum CommissionType {
  SALES // 业绩提成：基于签约/续签/服务包/项目/服务卡等"回款"触发
  LABOR // 手工费：基于护理/产康具体服务项目触发
}

enum CommissionRecordStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

/// 提成记录：DRAFT -(提交)-> PENDING_APPROVAL -(工作流审批)-> APPROVED/REJECTED。
/// sourceType/sourceId 追溯触发单据（如 PAYMENT/SERVICE_APPOINTMENT/CUSTOMER_SERVICE_PACKAGE），
/// 不做外键约束（跨模块泛化引用，同 WorkflowInstance.businessType/businessId 的设计）。
model CommissionRecord {
  id           String                 @id @default(cuid())
  tenantId     String                 @map("tenant_id")
  storeId      String                 @map("store_id")
  type         CommissionType
  sourceType   String                 @map("source_type")
  sourceId     String                 @map("source_id")
  totalAmount  Int                    @map("total_amount") // 最小货币单位，等于各分配明细之和
  status       CommissionRecordStatus @default(DRAFT)
  remark       String?                @db.Text
  cancelReason String?                @map("cancel_reason") @db.Text
  createdBy    String                 @map("created_by")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  version      Int                    @default(0)

  store       Store                  @relation(fields: [storeId], references: [id])
  allocations CommissionAllocation[]

  @@index([tenantId, storeId, status])
  @@index([tenantId, sourceType, sourceId])
  @@map("commission_records")
}

/// 分配明细：roleLabel 用自由文本（如"销售"/"主管"/"店长"/"第一服务人"），
/// 不写死三级/三人的固定结构，一笔业绩可按需拆给任意多名员工。
model CommissionAllocation {
  id                 String @id @default(cuid())
  commissionRecordId String @map("commission_record_id")
  employeeProfileId  String @map("employee_profile_id")
  roleLabel          String @map("role_label")
  basisPoints        Int    @map("basis_points") // 万分比，0-10000 代表 0.00%-100.00%
  amount             Int // totalAmount * basisPoints / 10000，创建时算好落库

  commissionRecord CommissionRecord @relation(fields: [commissionRecordId], references: [id])
  employeeProfile  EmployeeProfile  @relation(fields: [employeeProfileId], references: [id])

  @@index([employeeProfileId])
  @@map("commission_allocations")
}

enum PayrollRecordStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  PAID
}

/// 薪资单：DRAFT -(提交)-> PENDING_APPROVAL -(2级审批：店长初审->超管终审)-> APPROVED
/// -(标记发放)-> PAID。commissionTotal 是创建时对该员工当期已批准 CommissionAllocation 的
/// 快照汇总，之后提成再变化不会回溯影响已生成的薪资单。
model PayrollRecord {
  id                String              @id @default(cuid())
  tenantId          String              @map("tenant_id")
  storeId           String              @map("store_id")
  employeeProfileId String              @map("employee_profile_id")
  period            String // "YYYY-MM"
  baseSalary        Int                 @map("base_salary")
  commissionTotal   Int                 @default(0) @map("commission_total")
  deductions        Int                 @default(0)
  netAmount         Int                 @map("net_amount") // baseSalary + commissionTotal - deductions，创建时算好落库
  status            PayrollRecordStatus @default(DRAFT)
  paidAt            DateTime?           @map("paid_at")
  remark            String?             @db.Text
  cancelReason      String?             @map("cancel_reason") @db.Text
  createdBy         String              @map("created_by")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  version           Int                 @default(0)

  store           Store           @relation(fields: [storeId], references: [id])
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id])

  @@unique([tenantId, employeeProfileId, period])
  @@index([tenantId, storeId, status])
  @@map("payroll_records")
}

// ==================== 办公审批（固定几种常用单据类型，不做自定义表单引擎，见业务规则确认记录#13） ====================
// 三种单据共用同一状态机 OfficeApprovalStatus，均为单级店长审批，完全复用通用工作流引擎，
// reconcileStatus() 懒同步模式与 CommissionRecord/PayrollRecord 完全同构。
// 范围收窄：物品申领已由库存域 StockIssue(issueType=REQUISITION) 覆盖、退款已由
// Payment.requestRefund 覆盖，均不在此重复建模；请假是HR域明确延后的"请假管理"在此补上；
// 日常签呈(GeneralMemo)是标题+正文自由文本的兜底通用审批入口。

enum OfficeApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  SICK
  PERSONAL
  ANNUAL
  OTHER
}

model LeaveRequest {
  id                String               @id @default(cuid())
  tenantId          String               @map("tenant_id")
  storeId           String               @map("store_id")
  employeeProfileId String               @map("employee_profile_id")
  leaveType         LeaveType            @map("leave_type")
  startDate         DateTime             @map("start_date")
  endDate           DateTime             @map("end_date")
  reason            String               @db.Text
  status            OfficeApprovalStatus @default(DRAFT)
  cancelReason      String?              @map("cancel_reason") @db.Text
  createdBy         String               @map("created_by")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  version           Int                  @default(0)

  store           Store           @relation(fields: [storeId], references: [id])
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id])

  @@index([tenantId, storeId, status])
  @@map("leave_requests")
}

model ExpenseClaim {
  id           String               @id @default(cuid())
  tenantId     String               @map("tenant_id")
  storeId      String               @map("store_id")
  applicantId  String               @map("applicant_id")
  amount       Int // 最小货币单位（分）
  category     String // 自由文本，如 差旅/办公用品/招待
  reason       String               @db.Text
  status       OfficeApprovalStatus @default(DRAFT)
  cancelReason String?              @map("cancel_reason") @db.Text
  createdBy    String               @map("created_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  version      Int                  @default(0)

  store     Store   @relation(fields: [storeId], references: [id])
  applicant Account @relation(fields: [applicantId], references: [id])

  @@index([tenantId, storeId, status])
  @@map("expense_claims")
}

/// 兜底的通用审批入口：标题+正文自由文本，覆盖"以上都不是"的长尾审批需求。
model GeneralMemo {
  id           String               @id @default(cuid())
  tenantId     String               @map("tenant_id")
  storeId      String               @map("store_id")
  applicantId  String               @map("applicant_id")
  title        String
  content      String               @db.Text
  status       OfficeApprovalStatus @default(DRAFT)
  cancelReason String?              @map("cancel_reason") @db.Text
  createdBy    String               @map("created_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  version      Int                  @default(0)

  store     Store   @relation(fields: [storeId], references: [id])
  applicant Account @relation(fields: [applicantId], references: [id])

  @@index([tenantId, storeId, status])
  @@map("general_memos")
}

// ==================== 后勤管理（见业务规则确认记录#14/15/16） ====================
// 后勤仓库/物料复用 P3 库存域已有的 Warehouse/InventoryItem（purpose=LOGISTICS 区分），
// 不在此重复建模。本节只新增两块全新领域：车辆调度（集团层统一调度池+占用冲突检测）、
// 水电费登记（门店级运营费用，不做分摊）。

enum VehicleStatus {
  AVAILABLE
  MAINTENANCE
  RETIRED
}

/// 车辆不归属单一门店，任意门店可申请使用（集团层统一调度池，见#15）。
model Vehicle {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  plateNumber String        @map("plate_number")
  model       String
  status      VehicleStatus @default(AVAILABLE)
  remark      String?       @db.Text
  createdBy   String        @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  version     Int           @default(0)

  bookings VehicleBooking[]

  @@unique([tenantId, plateNumber])
  @@map("vehicles")
}

enum VehicleBookingStatus {
  BOOKED
  CANCELLED
}

/// 使用申请：仅做占用冲突检测（同一车辆的 [startTime, endTime) 不可与其他 BOOKED 记录重叠），
/// 不接入通用审批工作流——冲突检测本身就是唯一的准入门槛，呼应"集团层统一调度池"的定位。
model VehicleBooking {
  id           String               @id @default(cuid())
  tenantId     String               @map("tenant_id")
  vehicleId    String               @map("vehicle_id")
  storeId      String               @map("store_id")
  applicantId  String               @map("applicant_id")
  purpose      String               @db.Text
  startTime    DateTime             @map("start_time")
  endTime      DateTime             @map("end_time")
  status       VehicleBookingStatus @default(BOOKED)
  cancelReason String?              @map("cancel_reason") @db.Text
  createdBy    String               @map("created_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  version      Int                  @default(0)

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  store     Store   @relation(fields: [storeId], references: [id])
  applicant Account @relation(fields: [applicantId], references: [id])

  @@index([tenantId, vehicleId, status])
  @@map("vehicle_bookings")
}

enum UtilityExpenseType {
  ELECTRICITY
  WATER
  GAS
  PROPERTY_MANAGEMENT
  OTHER
}

/// 门店级运营费用登记，不做分摊到客户房费成本核算（见#16）。
model UtilityExpense {
  id          String             @id @default(cuid())
  tenantId    String             @map("tenant_id")
  storeId     String             @map("store_id")
  period      String // "YYYY-MM"
  expenseType UtilityExpenseType @map("expense_type")
  amount      Int // 最小货币单位（分）
  remark      String?            @db.Text
  createdBy   String             @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  version     Int                @default(0)

  store Store @relation(fields: [storeId], references: [id])

  @@unique([tenantId, storeId, period, expenseType])
  @@map("utility_expenses")
}

// ==================== AI / Agent 接入（P4，见《新系统开发文档》3.3节 + 业务规则确认记录#9/#10） ====================
// 首批2个Agent场景：智能客服/线索首触、护理异常预警建议。均由 NestJS 侧预先组装业务上下文后
// 调用 apps/ai-service 的模型网关做文本生成，不做自主多步工具调用（范围收窄见业务规则确认记录）。
// AI 只生成建议，不直接写业务库；护理场景强制人工确认后才写入正式护理记录，不支持一键采纳。

enum AiSuggestionScenario {
  CUSTOMER_SERVICE
  CARE_ABNORMALITY
  BUSINESS_ANALYTICS
}

enum AiSuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

/// 每次 Agent 调用的留痕审计记录：输入、输出、所用模型、耗时、是否被人工采纳，满足合规留痕要求。
model AiSuggestion {
  id            String               @id @default(cuid())
  tenantId      String               @map("tenant_id")
  storeId       String               @map("store_id")
  scenario      AiSuggestionScenario
  businessType  String               @map("business_type") // 如 LEAD/CUSTOMER/CARE_ABNORMALITY
  businessId    String               @map("business_id")
  inputText     String               @map("input_text") @db.Text // 发送给模型的完整上下文（脱敏后）
  outputText    String               @map("output_text") @db.Text
  modelProvider String               @map("model_provider") // volcengine/minimax
  modelName     String               @map("model_name")
  usedFallback  Boolean              @default(false) @map("used_fallback")
  latencyMs     Int                  @map("latency_ms")
  escalate      Boolean              @default(false) // 智能客服场景：是否建议转人工
  status        AiSuggestionStatus   @default(PENDING)
  acceptedById  String?              @map("accepted_by_id")
  acceptedAt    DateTime?            @map("accepted_at")
  createdBy     String               @map("created_by")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  version       Int                  @default(0)

  store      Store    @relation(fields: [storeId], references: [id])
  acceptedBy Account? @relation(fields: [acceptedById], references: [id])

  @@index([tenantId, storeId, scenario])
  @@index([tenantId, businessType, businessId])
  @@map("ai_suggestions")
}

// ==================== RAG 知识库（P4第二切片，见业务规则确认记录"P4 RAG知识库接入中"） ====================
// 只做"手动创建知识库文档"通用入口，不自动从ContractTemplate/CareFormTemplate等业务表同步。
// 不引入独立向量数据库：KnowledgeChunk.embedding 存为 JSON 数组，检索时应用层(NestJS)对该
// 租户全部chunk做暴力余弦相似度计算取top-K，量级小(V1几十到上百篇文档)下性能足够。
// 两个Agent场景（智能客服、护理异常预警建议）都会在生成前检索并把命中片段加入prompt。

/// 知识库文档：标题+正文，创建/更新时按固定长度分段并调用模型网关生成embedding写入KnowledgeChunk。
model KnowledgeDocument {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  title     String
  content   String       @db.Text
  category  String? // 自由文本分类，如 合同模板说明/护理规范/常见问题
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  chunks KnowledgeChunk[]

  @@index([tenantId, status])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  documentId String   @map("document_id")
  chunkIndex Int      @map("chunk_index")
  content    String   @db.Text
  embedding  Json // float[]，由模型网关的 /embeddings/create 生成
  createdAt  DateTime @default(now()) @map("created_at")

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@map("knowledge_chunks")
}

// ==================== IoT 设备网关（P4遗留补齐，见业务规则确认记录"P4遗留IoT设备网关框架补齐"） ====================
// V1不采购真实硬件，只搭建"设备网关"架构（设备台账 + Device Shadow期望态/上报态 + 事件流水 + 连接审计），
// 用前端"模拟设备事件"面板代替真实MQTT网关触发事件上报，验证"上报→业务记录自动生成"链路。
// 本轮只把两类设备事件接入真实业务表：呼叫/客房服务(CALL_SERVICE -> RoomCall)、
// 能耗计量(UTILITY_METER -> UtilityExpense按"门店+月份+费用类型"覆盖登记，语义是替代人工登记而非叠加流水)；
// 其余5类设备类别（体征监测/安防看护/门禁出入/身份结算/打印）本轮只做台账登记与事件留痕，不触发业务表写入。

enum DeviceCategory {
  VITAL_SIGN // 体征监测
  SECURITY // 安防看护
  ACCESS_CONTROL // 门禁出入
  CALL_SERVICE // 呼叫/客房服务
  IDENTITY_SETTLEMENT // 身份结算
  PRINTING // 打印
  UTILITY_METER // 能耗计量
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  DISABLED
}

enum DeviceConnectionLogType {
  ONLINE
  OFFLINE
  COMMAND_ISSUED
  COMMAND_CONFIRMED
}

/// 设备类型：协议/品类主数据，总部制定，同 room.type/care.field 口径不开放给 STORE_MANAGER。
model DeviceType {
  id                          String         @id @default(cuid())
  tenantId                    String         @map("tenant_id")
  category                    DeviceCategory
  name                        String
  protocol                    String // 自由文本，如 "MQTT"/"RTSP/MQTT"/"串口转HTTP"，对应开发文档接入协议列
  requiresCommandConfirmation Boolean        @default(false) @map("requires_command_confirmation") // 门禁/监控等敏感设备下发指令需二次确认
  status                      CommonStatus   @default(ACTIVE)
  createdBy                   String         @map("created_by")
  createdAt                   DateTime       @default(now()) @map("created_at")
  updatedAt                   DateTime       @updatedAt @map("updated_at")
  version                     Int            @default(0)

  devices Device[]

  @@unique([tenantId, name])
  @@map("device_types")
}

/// 设备台账：门店级物理设备实例，店长可自行登记维护（同 room.room/warehouse 口径）。
model Device {
  id           String       @id @default(cuid())
  tenantId     String       @map("tenant_id")
  storeId      String       @map("store_id")
  deviceTypeId String       @map("device_type_id")
  code         String // 设备编号
  name         String
  roomId       String?      @map("room_id") // 呼叫器/门禁等绑定具体房间；能耗计量总表等可不绑定
  status       DeviceStatus @default(OFFLINE)
  lastSeenAt   DateTime?    @map("last_seen_at")
  createdBy    String       @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  version      Int          @default(0)

  store          Store                 @relation(fields: [storeId], references: [id])
  deviceType     DeviceType            @relation(fields: [deviceTypeId], references: [id])
  room           Room?                 @relation(fields: [roomId], references: [id])
  shadow         DeviceShadow?
  events         DeviceEvent[]
  connectionLogs DeviceConnectionLog[]

  @@unique([tenantId, storeId, code])
  @@index([tenantId, storeId])
  @@map("devices")
}

/// Device Shadow：设备期望态(desired，网关下发指令写入)与上报态(reported，设备确认后写入)分离存储，
/// 网络不稳定时指令先存desired，设备恢复连接后再同步，核心业务不因设备离线中断（开发文档3.4节设计要点）。
model DeviceShadow {
  id              String    @id @default(cuid())
  deviceId        String    @unique @map("device_id")
  desiredState    Json?     @map("desired_state")
  desiredVersion  Int       @default(0) @map("desired_version")
  reportedState   Json?     @map("reported_state")
  reportedVersion Int       @default(0) @map("reported_version")
  lastCommandAt   DateTime? @map("last_command_at")
  lastReportedAt  DateTime? @map("last_reported_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_shadows")
}

/// 设备事件流水：模拟/真实网关上报的原始事件；processedAt/businessRefType/businessRefId记录是否
/// 及如何转换为正式业务记录，processingError记录转换失败原因（不静默丢弃，便于排查）。
model DeviceEvent {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  storeId         String    @map("store_id")
  deviceId        String    @map("device_id")
  eventType       String    @map("event_type")
  payload         Json
  occurredAt      DateTime  @default(now()) @map("occurred_at")
  processedAt     DateTime? @map("processed_at")
  businessRefType String?   @map("business_ref_type")
  businessRefId   String?   @map("business_ref_id")
  processingError String?   @map("processing_error") @db.Text
  createdBy       String    @map("created_by") // 本轮为模拟面板操作人；接入真实网关后可改为系统账号
  createdAt       DateTime  @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id])
  store  Store  @relation(fields: [storeId], references: [id])

  @@index([tenantId, deviceId])
  @@index([tenantId, storeId, occurredAt])
  @@map("device_events")
}

/// 设备接入审计：上下线、指令下发/确认记录留痕（开发文档"设备接入审计"要求）。
model DeviceConnectionLog {
  id        String                  @id @default(cuid())
  tenantId  String                  @map("tenant_id")
  storeId   String                  @map("store_id")
  deviceId  String                  @map("device_id")
  logType   DeviceConnectionLogType @map("log_type")
  detail    Json?
  createdBy String?                 @map("created_by")
  createdAt DateTime                @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id])
  store  Store  @relation(fields: [storeId], references: [id])

  @@index([tenantId, deviceId])
  @@map("device_connection_logs")
}

// ==================== 员工培训与考核（P5切片，见业务规则确认记录"员工培训与考核模块启动前"） ====================
// 完全是员工内部工具，不涉及客户端/小程序（对应"商城与知识库自建vs对接评估报告"里知识库-对内的结论）。
// 试卷/题目为总部统一培训标准，仅SUPER_ADMIN维护；参加考试对全体员工开放；简答题批阅由店长一步给分完成，
// 不接入通用工作流引擎。不做"我要学习"打卡审计，不限制重考次数。

enum TrainingExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExamQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum ExamAttemptStatus {
  PENDING_GRADING // 含简答题，等待人工批阅
  COMPLETED // 全部客观题或简答题已批阅完毕
}

/// 试卷：总部统一培训标准，studyMaterial为自由文本学习资料（不新建独立文档系统）。
model TrainingExam {
  id            String             @id @default(cuid())
  tenantId      String             @map("tenant_id")
  title         String
  studyMaterial String?            @map("study_material") @db.Text
  passScore     Int?               @map("pass_score") // 及格分数线，可选
  status        TrainingExamStatus @default(DRAFT)
  createdBy     String             @map("created_by")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  version       Int                @default(0)

  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@map("training_exams")
}

/// 题目：单选/多选/判断题程序自动判分，简答题固定人工批阅。
model ExamQuestion {
  id            String           @id @default(cuid())
  tenantId      String           @map("tenant_id")
  examId        String           @map("exam_id")
  order         Int
  type          ExamQuestionType
  content       String           @db.Text
  options       Json? // 选择题用：[{ key: 'A', text: '...' }, ...]；判断题/简答题为 null
  correctAnswer Json?            @map("correct_answer") // 选择题存正确选项key数组；判断题存 true/false；简答题为 null（人工判分）
  score         Int // 该题分值

  exam    TrainingExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]

  @@index([tenantId, examId])
  @@map("exam_questions")
}

/// 员工一次作答：answers/autoScore由提交时程序计算，manualScore/gradedBy由批阅时人工填写。
model ExamAttempt {
  id          String            @id @default(cuid())
  tenantId    String            @map("tenant_id")
  examId      String            @map("exam_id")
  accountId   String            @map("account_id")
  autoScore   Int               @default(0) @map("auto_score")
  manualScore Int?              @map("manual_score")
  totalScore  Int?              @map("total_score") // 全部判分完成后写入（autoScore+manualScore之和）
  status      ExamAttemptStatus @default(PENDING_GRADING)
  submittedAt DateTime          @default(now()) @map("submitted_at")
  gradedById  String?           @map("graded_by_id")
  gradedAt    DateTime?         @map("graded_at")
  createdBy   String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  version     Int               @default(0)

  exam     TrainingExam @relation(fields: [examId], references: [id])
  account  Account      @relation("ExamAttemptAccount", fields: [accountId], references: [id])
  gradedBy Account?     @relation("ExamAttemptGradedBy", fields: [gradedById], references: [id])
  answers  ExamAnswer[]

  @@index([tenantId, examId])
  @@index([tenantId, accountId])
  @@map("exam_attempts")
}

/// 单题作答：selectedKeys为选择题答案；textAnswer为简答题答案；isCorrect/score为该题判分结果。
model ExamAnswer {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  attemptId    String   @map("attempt_id")
  questionId   String   @map("question_id")
  selectedKeys Json?    @map("selected_keys") // 选择题/判断题答案
  textAnswer   String?  @map("text_answer") @db.Text // 简答题答案
  isCorrect    Boolean? @map("is_correct") // 客观题自动判分结果；简答题人工批阅后填写
  score        Int      @default(0) // 该题得分

  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id])

  @@index([tenantId, attemptId])
  @@map("exam_answers")
}

/// 回收站：删除客户/母婴档案时，把它和名下所有数据存成一份快照（保留30天），期内可原样还原；到期自动清除
model RecycleBinItem {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  entityType String    @map("entity_type") // CUSTOMER / MOTHER_PROFILE
  entityId   String    @map("entity_id")
  title      String // 显示名，如客户姓名
  summary    String?   @db.Text // 一并删除了什么，如“2 份合同、1 笔收款”
  payload    String    @db.LongText // 快照（JSON 文本）：各表被删除的行 + 被置空的关联
  fileDocIds Json?     @map("file_doc_ids") // 到期清除时要一并删掉磁盘文件的资料 id
  reason     String? // 删除原因 / 来源（如 合并客户）
  deletedBy  String    @map("deleted_by")
  deletedAt  DateTime  @default(now()) @map("deleted_at")
  expiresAt  DateTime  @map("expires_at")

  @@index([tenantId, entityType, expiresAt])
  @@map("recycle_bin_items")
}

/// 宝宝生长测量记录（身长/体重/头围）：定期测量，和《7岁以下儿童生长标准》WS/T 423-2022 的百分位对比、生成曲线图。
/// 日常护理记录里的体重也会自动并入曲线（不用重复录）；身长、头围只来自这里。
model BabyGrowthRecord {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  storeId         String   @map("store_id")
  motherProfileId String   @map("mother_profile_id")
  babyProfileId   String   @map("baby_profile_id")
  measuredAt      DateTime @map("measured_at") @db.Date
  weightKg        Float?   @map("weight_kg")
  lengthCm        Float?   @map("length_cm")
  headCm          Float?   @map("head_cm")
  measuredByName  String?  @map("measured_by_name")
  note            String?
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  baby BabyProfile @relation(fields: [babyProfileId], references: [id])

  @@index([tenantId, babyProfileId, measuredAt])
  @@map("baby_growth_records")
}

/// 发给客户看的“生长曲线”链接：凭不可猜的随机链接打开（只读，随记录更新），可随时作废。
model BabyGrowthShare {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  babyProfileId String    @map("baby_profile_id")
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt     DateTime  @map("expires_at")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  revokedAt     DateTime? @map("revoked_at")
  openCount     Int       @default(0) @map("open_count")
  lastOpenedAt  DateTime? @map("last_opened_at")

  baby BabyProfile @relation(fields: [babyProfileId], references: [id])

  @@index([tenantId, babyProfileId])
  @@map("baby_growth_shares")
}
