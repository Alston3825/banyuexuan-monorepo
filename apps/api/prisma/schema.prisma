// 伴月轩月子中心管理系统 — P0 平台底座数据模型
// 命名约定：Prisma 侧用 camelCase，通过 @map/@@map 落到 snake_case 列名，
// 遵循《新系统开发文档》"关键原则"：tenant_id/store_id/created_by/created_at/updated_at/version。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 平台域 ====================

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// 租户：伴月轩当前只有一个租户，不建管理 CRUD API，仅由 seed 脚本创建。
model Tenant {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  @@map("tenants")
}

enum CommonStatus {
  ACTIVE
  INACTIVE
}

model Region {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  code      String
  name      String
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  stores Store[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("regions")
}

enum StoreStatus {
  PENDING
  ACTIVE
  CLOSED
}

model Store {
  id        String      @id @default(cuid())
  tenantId  String      @map("tenant_id")
  regionId  String      @map("region_id")
  code      String
  name      String
  address   String?
  status    StoreStatus @default(PENDING)
  createdBy String      @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  version   Int         @default(0)

  region                  Region                   @relation(fields: [regionId], references: [id])
  departments             Department[]
  teams                   Team[]
  accounts                Account[]
  customers               Customer[]
  leads                   Lead[]
  contracts               Contract[]
  rooms                   Room[]
  roomOccupancies         RoomOccupancy[]
  payments                Payment[]
  motherProfiles          MotherProfile[]
  babyProfiles            BabyProfile[]
  carePlans               CarePlan[]
  careRecords             CareRecord[]
  careAbnormalities       CareAbnormality[]
  roomCalls               RoomCall[]
  roomOutings             RoomOuting[]
  roomServiceRequisitions RoomServiceRequisition[]
  dinerProfiles           DinerProfile[]
  mealRecords             MealRecord[]
  customerServicePackages CustomerServicePackage[]
  therapists              Therapist[]
  serviceAppointments     ServiceAppointment[]
  warehouses              Warehouse[]
  purchaseOrders          PurchaseOrder[]
  goodsReceipts           GoodsReceipt[]
  stockIssues             StockIssue[]
  stockCounts             StockCount[]
  shiftDefinitions        ShiftDefinition[]
  scheduleEntries         ScheduleEntry[]
  commissionRecords       CommissionRecord[]
  payrollRecords          PayrollRecord[]
  leaveRequests           LeaveRequest[]
  expenseClaims           ExpenseClaim[]
  generalMemos            GeneralMemo[]
  vehicleBookings         VehicleBooking[]
  utilityExpenses         UtilityExpense[]
  aiSuggestions           AiSuggestion[]
  devices                 Device[]
  deviceEvents            DeviceEvent[]
  deviceConnectionLogs    DeviceConnectionLog[]

  @@unique([tenantId, code])
  @@index([tenantId, regionId])
  @@map("stores")
}

model Department {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  storeId   String?      @map("store_id") // null = 总部/跨店部门
  parentId  String?      @map("parent_id")
  code      String
  name      String
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  store    Store?       @relation(fields: [storeId], references: [id])
  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children Department[] @relation("DeptTree")
  teams    Team[]
  accounts Account[]

  @@unique([tenantId, code])
  @@index([tenantId, storeId])
  @@map("departments")
}

model Team {
  id           String       @id @default(cuid())
  tenantId     String       @map("tenant_id")
  storeId      String?      @map("store_id") // 从部门冗余，便于按店查询
  departmentId String       @map("department_id")
  code         String
  name         String
  status       CommonStatus @default(ACTIVE)
  createdBy    String       @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  version      Int          @default(0)

  store      Store?     @relation(fields: [storeId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  accounts   Account[]

  @@unique([departmentId, code])
  @@index([tenantId, storeId])
  @@map("teams")
}

model Position {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  code      String
  name      String
  rank      Int?
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  accounts Account[]

  @@unique([tenantId, code])
  @@map("positions")
}

enum AccountStatus {
  ACTIVE
  DISABLED
  LOCKED
}

model Account {
  id           String        @id @default(cuid())
  tenantId     String        @map("tenant_id")
  storeId      String?       @map("store_id") // 主门店，总部账号可为空
  departmentId String?       @map("department_id")
  teamId       String?       @map("team_id")
  positionId   String?       @map("position_id")
  username     String
  phone        String? // 敏感字段，见 FieldMaskInterceptor
  email        String?
  passwordHash String        @map("password_hash")
  realName     String        @map("real_name")
  status       AccountStatus @default(ACTIVE)
  lastLoginAt  DateTime?     @map("last_login_at")
  createdBy    String        @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  version      Int           @default(0)

  store                 Store?                  @relation(fields: [storeId], references: [id])
  department            Department?             @relation(fields: [departmentId], references: [id])
  team                  Team?                   @relation(fields: [teamId], references: [id])
  position              Position?               @relation(fields: [positionId], references: [id])
  roleAssignments       AccountRoleAssignment[]
  refreshTokens         RefreshToken[]
  assignedCustomers     Customer[]
  assignedLeads         Lead[]
  assignedOpportunities SalesOpportunity[]
  employeeProfile       EmployeeProfile?
  expenseClaims         ExpenseClaim[]
  generalMemos          GeneralMemo[]
  vehicleBookings       VehicleBooking[]
  acceptedAiSuggestions AiSuggestion[]

  @@unique([tenantId, username])
  @@index([tenantId, storeId])
  @@map("accounts")
}

model Role {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  code        String
  name        String
  description String?
  isSystem    Boolean      @default(false) @map("is_system") // 内置角色不可删除
  status      CommonStatus @default(ACTIVE)
  createdBy   String       @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  version     Int          @default(0)

  permissions RoleOnPermission[]
  assignments AccountRoleAssignment[]

  @@unique([tenantId, code])
  @@map("roles")
}

enum PermissionPointType {
  MODULE
  PAGE
  BUTTON
  FIELD
}

/// RBAC 四级权限目录：模块/页面/按钮/字段，全局系统目录（非租户隔离），由 seed 脚本维护。
model PermissionPoint {
  id            String              @id @default(cuid())
  applicationId String?             @map("application_id")
  parentId      String?             @map("parent_id")
  type          PermissionPointType
  code          String              @unique
  name          String
  isSensitive   Boolean             @default(false) @map("is_sensitive")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  application Application?       @relation(fields: [applicationId], references: [id])
  parent      PermissionPoint?   @relation("PermTree", fields: [parentId], references: [id])
  children    PermissionPoint[]  @relation("PermTree")
  roles       RoleOnPermission[]

  @@map("permission_points")
}

model RoleOnPermission {
  id                String   @id @default(cuid())
  roleId            String   @map("role_id")
  permissionPointId String   @map("permission_point_id")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  role            Role            @relation(fields: [roleId], references: [id])
  permissionPoint PermissionPoint @relation(fields: [permissionPointId], references: [id])

  @@unique([roleId, permissionPointId])
  @@map("role_permissions")
}

enum DataScopeType {
  TENANT
  REGION
  STORE
  DEPARTMENT
  TEAM
  SELF
}

/// 数据范围授权：账号-角色绑定携带 scope，跨店查询/执行需要独立的一条授权记录。
model AccountRoleAssignment {
  id        String        @id @default(cuid())
  tenantId  String        @map("tenant_id")
  accountId String        @map("account_id")
  roleId    String        @map("role_id")
  scopeType DataScopeType @map("scope_type")
  scopeId   String?       @map("scope_id") // TENANT/SELF 时为空
  grantedBy String        @map("granted_by")
  grantedAt DateTime      @default(now()) @map("granted_at")
  expiresAt DateTime?     @map("expires_at")
  revokedAt DateTime?     @map("revoked_at")

  account Account @relation(fields: [accountId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@index([accountId])
  @@index([tenantId, scopeType, scopeId])
  @@map("account_role_assignments")
}

enum ApplicationType {
  WEB
  MOBILE
  OPENAPI
}

model Application {
  id        String          @id @default(cuid())
  tenantId  String?         @map("tenant_id") // null = 平台级应用
  code      String          @unique
  name      String
  type      ApplicationType
  status    CommonStatus    @default(ACTIVE)
  createdBy String          @map("created_by")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  version   Int             @default(0)

  permissionPoints PermissionPoint[]

  @@map("applications")
}

model Tag {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  color     String?
  category  String?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(0)

  bindings TagBinding[]

  @@unique([tenantId, name])
  @@map("tags")
}

/// 多态挂接：标签可打在任意未来实体上（entityType + entityId）。
model TagBinding {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tagId      String   @map("tag_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  tag Tag @relation(fields: [tagId], references: [id])

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("tag_bindings")
}

enum ParameterValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model Parameter {
  id          String             @id @default(cuid())
  tenantId    String?            @map("tenant_id") // null = 全局系统默认值
  storeId     String?            @map("store_id") // 非空覆盖到店级
  key         String
  value       String             @db.Text
  valueType   ParameterValueType @default(STRING) @map("value_type")
  description String?
  isSystem    Boolean            @default(false) @map("is_system")
  createdBy   String             @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  version     Int                @default(0)

  // 注意：MySQL 唯一索引中 NULL 不互斥，(tenantId=X, storeId=NULL, key=K) 理论上可重复插入；
  // ParameterService 在应用层做"先查后插"兜底校验，不完全依赖数据库唯一约束。
  @@unique([tenantId, storeId, key])
  @@map("parameters")
}

// ==================== 审计 ====================

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  CREATE
  UPDATE
  DELETE
  VOID
  STATE_TRANSITION
  APPROVE
  REJECT
  WITHDRAW
  REASSIGN
  ADD_APPROVER
  CC
  ARCHIVE
  SENSITIVE_QUERY
  EXPORT
  PRINT
}

/// 只增不改：不提供 update/delete 方法，关键记录只允许冲正/作废，符合审计总则。
model AuditLog {
  id            String      @id @default(cuid())
  tenantId      String?     @map("tenant_id") // 登录失败等无租户上下文场景可为空
  storeId       String?     @map("store_id")
  accountId     String?     @map("account_id")
  action        AuditAction
  entityType    String      @map("entity_type")
  entityId      String?     @map("entity_id")
  beforeData    Json?       @map("before_data")
  afterData     Json?       @map("after_data")
  changedFields Json?       @map("changed_fields")
  ip            String?
  userAgent     String?     @map("user_agent")
  requestId     String?     @map("request_id")
  result        String      @default("SUCCESS")
  remark        String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([accountId, createdAt])
  @@map("audit_logs")
}

// ==================== 工作流引擎骨架 ====================

enum WorkflowDefStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

model WorkflowDefinition {
  id        String            @id @default(cuid())
  tenantId  String            @map("tenant_id")
  code      String // 业务场景 key，如 "DEMO_APPROVAL"
  name      String
  version   Int               @default(1)
  status    WorkflowDefStatus @default(PUBLISHED)
  createdBy String            @map("created_by")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  nodes     WorkflowNode[]
  instances WorkflowInstance[]

  @@unique([tenantId, code, version])
  @@map("workflow_definitions")
}

enum WorkflowNodeApproverType {
  ROLE
  ACCOUNT
}

/// 顺序审批节点定义。
model WorkflowNode {
  id                   String                   @id @default(cuid())
  workflowDefinitionId String                   @map("workflow_definition_id")
  seq                  Int
  name                 String
  approverType         WorkflowNodeApproverType @map("approver_type")
  approverRoleId       String?                  @map("approver_role_id")
  approverAccountId    String?                  @map("approver_account_id")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  definition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])

  @@unique([workflowDefinitionId, seq])
  @@map("workflow_nodes")
}

enum WorkflowInstanceStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  ARCHIVED
}

/// businessType/businessId 泛化挂接任意业务单据，P1+ 真实单据复用同一引擎无需改动。
model WorkflowInstance {
  id                   String                 @id @default(cuid())
  tenantId             String                 @map("tenant_id")
  storeId              String?                @map("store_id")
  workflowDefinitionId String                 @map("workflow_definition_id")
  businessType         String                 @map("business_type")
  businessId           String                 @map("business_id")
  title                String
  status               WorkflowInstanceStatus @default(DRAFT)
  currentNodeSeq       Int?                   @map("current_node_seq")
  initiatorId          String                 @map("initiator_id")
  submittedAt          DateTime?              @map("submitted_at")
  finishedAt           DateTime?              @map("finished_at")
  createdBy            String                 @map("created_by")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  version              Int                    @default(0)

  definition WorkflowDefinition         @relation(fields: [workflowDefinitionId], references: [id])
  approvers  WorkflowInstanceApprover[]
  actions    WorkflowActionLog[]

  @@index([tenantId, businessType, businessId])
  @@index([status])
  @@map("workflow_instances")
}

enum WorkflowApproverRole {
  APPROVER
  ADDED_APPROVER
  CC
}

enum WorkflowApproverStatus {
  PENDING
  APPROVED
  REJECTED
  REASSIGNED
  SKIPPED
  NOTIFIED
}

/// 单表覆盖：普通审批人 / 加签 / 抄送 / 转交链（reassignedFromId 指向被转交的原记录）。
model WorkflowInstanceApprover {
  id                 String                 @id @default(cuid())
  workflowInstanceId String                 @map("workflow_instance_id")
  nodeSeq            Int                    @map("node_seq")
  accountId          String                 @map("account_id")
  role               WorkflowApproverRole   @default(APPROVER)
  status             WorkflowApproverStatus @default(PENDING)
  comment            String?                @db.Text
  actedAt            DateTime?              @map("acted_at")
  reassignedFromId   String?                @map("reassigned_from_id")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  instance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id])

  @@index([workflowInstanceId, nodeSeq])
  @@index([accountId, status])
  @@map("workflow_instance_approvers")
}

enum WorkflowAction {
  SUBMIT
  APPROVE
  REJECT
  WITHDRAW
  REASSIGN
  ADD_APPROVER
  CC
  ARCHIVE
}

/// 审批时间线，供后续 UI 展示；每次动作同时写一份摘要进 AuditLog。
model WorkflowActionLog {
  id                 String         @id @default(cuid())
  workflowInstanceId String         @map("workflow_instance_id")
  nodeSeq            Int?           @map("node_seq")
  actorId            String         @map("actor_id")
  action             WorkflowAction
  comment            String?        @db.Text
  createdAt          DateTime       @default(now()) @map("created_at")

  instance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id])

  @@index([workflowInstanceId, createdAt])
  @@map("workflow_action_logs")
}

// ==================== 认证 ====================

model RefreshToken {
  id        String    @id @default(cuid())
  accountId String    @map("account_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("refresh_tokens")
}

// ==================== 工作流引擎示例业务实体 ====================

/// P0 专用最小审批业务实体，仅用于验证工作流引擎骨架端到端可用；
/// P1+ 真实单据（合同/收款等）复用同一 WorkflowEngineService，不需要为每种业务再写一套状态机。
model DemoApprovalRequest {
  id          String                 @id @default(cuid())
  tenantId    String                 @map("tenant_id")
  storeId     String?                @map("store_id")
  title       String
  content     String                 @db.Text
  amount      Int? // 最小货币单位（分）
  applicantId String                 @map("applicant_id")
  status      WorkflowInstanceStatus @default(DRAFT)
  createdBy   String                 @map("created_by")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  version     Int                    @default(0)

  @@map("demo_approval_requests")
}

// ==================== CRM：客户与线索管理 ====================

enum CustomerSource {
  WALK_IN // 自然到店
  REFERRAL // 转介绍
  ONLINE_AD // 线上广告投放
  SOCIAL_MEDIA // 社交媒体/私域
  PARTNER // 渠道合作
  OTHER
}

enum LeadStatus {
  NEW
  ASSIGNED
  FOLLOWING
  CONVERTED
  LOST
}

enum OpportunityStage {
  FOLLOWING
  QUOTED
  WON
  LOST
}

enum FollowUpType {
  PHONE_CALL
  WECHAT
  SMS
  ON_SITE_VISIT
  INVITATION // 邀约到店
  OTHER
}

/// 客户主数据：租户全局共享，不做门店级数据隔离（已与业务方确认）。
/// primaryStoreId 仅用于展示/报表（首次建档门店），不参与任何权限范围过滤。
/// 字段保持最小化——合同/收款/房态预订等 P1 后续切片会引用 Customer.id，
/// 但不因为它们而预先在这里加字段，那些模块的专属数据放在各自的表里。
model Customer {
  id             String         @id @default(cuid())
  tenantId       String         @map("tenant_id")
  customerNo     String         @map("customer_no")
  name           String
  phone          String // 敏感字段，见 FieldMaskInterceptor + SENSITIVE_FIELD_REGISTRY.Customer
  source         CustomerSource @default(WALK_IN)
  primaryStoreId String?        @map("primary_store_id") // 首次建档门店，仅展示/报表用途
  assignedToId   String?        @map("assigned_to_id") // 当前归属销售，无保护期/锁定机制
  remark         String?        @db.Text
  createdBy      String         @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  version        Int            @default(0)

  primaryStore            Store?                   @relation(fields: [primaryStoreId], references: [id])
  assignedTo              Account?                 @relation(fields: [assignedToId], references: [id])
  leads                   Lead[]
  opportunities           SalesOpportunity[]
  contracts               Contract[]
  roomOccupancies         RoomOccupancy[]
  payments                Payment[]
  motherProfiles          MotherProfile[]
  babyProfiles            BabyProfile[]
  dinerProfiles           DinerProfile[]
  customerServicePackages CustomerServicePackage[]
  serviceAppointments     ServiceAppointment[]
  account                 CustomerAccount?

  @@unique([tenantId, customerNo])
  @@index([tenantId, assignedToId])
  @@index([tenantId, primaryStoreId])
  @@index([tenantId, phone])
  @@map("customers")
}

/// 线索：NEW -> ASSIGNED -> FOLLOWING -> CONVERTED；LOST 可从 NEW/ASSIGNED/FOLLOWING 到达。
model Lead {
  id           String         @id @default(cuid())
  tenantId     String         @map("tenant_id")
  leadNo       String         @map("lead_no")
  name         String
  phone        String
  source       CustomerSource @default(WALK_IN)
  storeId      String?        @map("store_id") // 线索录入门店，仅展示用途，不做范围过滤
  status       LeadStatus     @default(NEW)
  assignedToId String?        @map("assigned_to_id")
  customerId   String?        @map("customer_id") // 转化后回填，转化前为空
  lostReason   String?        @map("lost_reason") @db.Text
  remark       String?        @db.Text
  createdBy    String         @map("created_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  version      Int            @default(0)

  store         Store?             @relation(fields: [storeId], references: [id])
  assignedTo    Account?           @relation(fields: [assignedToId], references: [id])
  customer      Customer?          @relation(fields: [customerId], references: [id])
  opportunities SalesOpportunity[]

  @@unique([tenantId, leadNo])
  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@index([tenantId, storeId])
  @@map("leads")
}

/// 销售机会：FOLLOWING -> QUOTED -> WON；LOST 可从 FOLLOWING/QUOTED 到达，WON 为终态不可转 LOST。
/// leadId 可空——允许无原始线索的机会（如老客户加购/转介绍直接开单）。
model SalesOpportunity {
  id            String           @id @default(cuid())
  tenantId      String           @map("tenant_id")
  opportunityNo String           @map("opportunity_no")
  customerId    String           @map("customer_id")
  leadId        String?          @map("lead_id")
  stage         OpportunityStage @default(FOLLOWING)
  amount        Int? // 意向金额，最小货币单位（分）
  assignedToId  String?          @map("assigned_to_id")
  lostReason    String?          @map("lost_reason") @db.Text
  remark        String?          @db.Text
  createdBy     String           @map("created_by")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  version       Int              @default(0)

  customer   Customer   @relation(fields: [customerId], references: [id])
  lead       Lead?      @relation(fields: [leadId], references: [id])
  assignedTo Account?   @relation(fields: [assignedToId], references: [id])
  contracts  Contract[]

  @@unique([tenantId, opportunityNo])
  @@index([tenantId, stage])
  @@index([tenantId, customerId])
  @@index([tenantId, assignedToId])
  @@map("sales_opportunities")
}

/// 跟进/邀约记录：多态挂接（businessType/businessId），镜像 WorkflowInstance 的
/// businessType/businessId 命名与设计——不建三个可空外键，未来新增可跟进的实体
/// （如合同回访）无需改表结构。这是只增不改的日志类实体（没有 version/updatedAt），
/// 与 WorkflowActionLog 保持同一建模风格，而非套用"每个业务模型都有 version"的模板。
model FollowUpRecord {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  businessType   String       @map("business_type") // 'LEAD' | 'OPPORTUNITY' | 'CUSTOMER'
  businessId     String       @map("business_id")
  type           FollowUpType
  content        String       @db.Text
  nextFollowUpAt DateTime?    @map("next_follow_up_at")
  createdBy      String       @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([tenantId, businessType, businessId])
  @@index([tenantId, createdAt])
  @@map("follow_up_records")
}

// ==================== 合同管理 ====================

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  VOIDED
}

/// 合同模板：法律文本相关主数据，正常可编辑（不像合同本身那样"签了就锁定"），
/// 不做占位符替换引擎——content 是纯文本，套用模板时由前端把内容复制进合同表单，
/// 由人编辑后再提交，符合"AI 只做技术实现、模板文本人工终审"的原则。
model ContractTemplate {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  code      String
  name      String
  content   String       @db.Text
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  contracts Contract[]

  @@unique([tenantId, code])
  @@map("contract_templates")
}

/// 合同：租户全局可见，不做门店级数据隔离（同 Customer，一份合同背后是一个全局客户）。
/// 状态机：DRAFT -(签署)-> 内容锁定 -(提交)-> PENDING_APPROVAL -(通用工作流引擎审批)-> ACTIVE/REJECTED；
/// ACTIVE/DRAFT 可 VOIDED。PENDING_APPROVAL 阶段的状态推进由 ContractRecordService 在读取时
/// 懒同步自 WorkflowInstance（见 ContractRecordService.reconcileStatus），不侵入通用工作流引擎本身。
/// 续签＝新建一条 Contract（renewalOfContractId 指回原合同），原合同不做任何修改。
model Contract {
  id                  String         @id @default(cuid())
  tenantId            String         @map("tenant_id")
  contractNo          String         @map("contract_no")
  customerId          String         @map("customer_id")
  opportunityId       String?        @map("opportunity_id")
  templateId          String?        @map("template_id")
  storeId             String         @map("store_id")
  title               String
  content             String         @db.Text
  amount              Int // 合同总金额，最小货币单位（分）
  startDate           DateTime       @map("start_date")
  endDate             DateTime       @map("end_date")
  status              ContractStatus @default(DRAFT)
  signedByCustomerAt  DateTime?      @map("signed_by_customer_at")
  signedByCustomerIp  String?        @map("signed_by_customer_ip")
  renewalOfContractId String?        @map("renewal_of_contract_id")
  voidReason          String?        @map("void_reason") @db.Text
  createdBy           String         @map("created_by")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  version             Int            @default(0)

  customer        Customer          @relation(fields: [customerId], references: [id])
  opportunity     SalesOpportunity? @relation(fields: [opportunityId], references: [id])
  template        ContractTemplate? @relation(fields: [templateId], references: [id])
  store           Store             @relation(fields: [storeId], references: [id])
  renewalOf       Contract?         @relation("ContractRenewal", fields: [renewalOfContractId], references: [id])
  renewals        Contract[]        @relation("ContractRenewal")
  roomOccupancies RoomOccupancy[]
  payments        Payment[]

  @@unique([tenantId, contractNo])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("contracts")
}

// ==================== 房态预订（住店运营域） ====================

enum RoomOccupancyStatus {
  RESERVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model RoomType {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  code          String
  name          String
  description   String?      @db.Text
  standardPrice Int?         @map("standard_price") // 参考价，最小货币单位（分），可空——非强制定价
  status        CommonStatus @default(ACTIVE)
  createdBy     String       @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  version       Int          @default(0)

  rooms Room[]

  @@unique([tenantId, code])
  @@map("room_types")
}

/// 房间：不存房态枚举，房态由 RoomOccupancy 实时计算得出（见 RoomService.computeStatus）。
/// underMaintenance/needsCleaning 是独立于占用记录的标志位（沿用开发文档"维修为独立标志"的设计）。
model Room {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  storeId          String   @map("store_id")
  roomTypeId       String   @map("room_type_id")
  roomNo           String   @map("room_no")
  floor            String // 允许 "1F"/"B1" 等标签，不做纯数字假设
  underMaintenance Boolean  @default(false) @map("under_maintenance")
  maintenanceNote  String?  @map("maintenance_note") @db.Text
  needsCleaning    Boolean  @default(false) @map("needs_cleaning")
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(0)

  store       Store           @relation(fields: [storeId], references: [id])
  roomType    RoomType        @relation(fields: [roomTypeId], references: [id])
  occupancies RoomOccupancy[]
  devices     Device[]

  @@unique([tenantId, storeId, roomNo])
  @@index([tenantId, storeId])
  @@map("rooms")
}

/// 占房记录：预订/入住/离店/取消的状态机主体。合同可选（弱关联，仿照 Contract.opportunityId）。
model RoomOccupancy {
  id               String              @id @default(cuid())
  tenantId         String              @map("tenant_id")
  occupancyNo      String              @map("occupancy_no")
  roomId           String              @map("room_id")
  storeId          String              @map("store_id") // 冗余存储，便于按店过滤，仿照 Contract.storeId
  customerId       String              @map("customer_id")
  contractId       String?             @map("contract_id")
  status           RoomOccupancyStatus @default(RESERVED)
  plannedCheckIn   DateTime            @map("planned_check_in")
  plannedCheckOut  DateTime            @map("planned_check_out")
  actualCheckInAt  DateTime?           @map("actual_check_in_at")
  actualCheckOutAt DateTime?           @map("actual_check_out_at")
  cancelReason     String?             @map("cancel_reason") @db.Text
  remark           String?             @db.Text
  createdBy        String              @map("created_by")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  version          Int                 @default(0)

  room                    Room                     @relation(fields: [roomId], references: [id])
  store                   Store                    @relation(fields: [storeId], references: [id])
  customer                Customer                 @relation(fields: [customerId], references: [id])
  contract                Contract?                @relation(fields: [contractId], references: [id])
  motherProfiles          MotherProfile[]
  roomCalls               RoomCall[]
  roomOutings             RoomOuting[]
  roomServiceRequisitions RoomServiceRequisition[]
  dinerProfiles           DinerProfile[]

  @@unique([tenantId, occupancyNo])
  @@index([tenantId, roomId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("room_occupancies")
}

// ==================== 收款管理（交易与供应域） ====================

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  WECHAT
  ALIPAY
  POS_CARD
  OTHER
}

enum PaymentStatus {
  RECORDED
  PENDING_REFUND
  REFUNDED
}

/// 收款记录：只做"收款"（客户付钱给中心），不做应付/付款。
/// 退款不新增独立冲正单据，是同一条记录上的状态迁移（见 PaymentRecordService 注释），
/// 与 Contract.void() 的处理口径一致，为控制本轮范围做的取舍。
model Payment {
  id           String        @id @default(cuid())
  tenantId     String        @map("tenant_id")
  paymentNo    String        @map("payment_no")
  contractId   String        @map("contract_id")
  customerId   String        @map("customer_id")
  storeId      String        @map("store_id")
  amount       Int // 收款金额，最小货币单位（分）
  method       PaymentMethod @default(CASH)
  status       PaymentStatus @default(RECORDED)
  refundReason String?       @map("refund_reason") @db.Text
  remark       String?       @db.Text
  createdBy    String        @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  version      Int           @default(0)

  contract Contract @relation(fields: [contractId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  store    Store    @relation(fields: [storeId], references: [id])

  @@unique([tenantId, paymentNo])
  @@index([tenantId, contractId])
  @@index([tenantId, status])
  @@map("payments")
}

// ==================== 财务结算深化（会员账户：赠送优先扣减，见业务规则确认记录#5） ====================
// 与 Payment（强绑定 Contract 的合同收款）是两类不同性质的资金记录，不合并、不互相依赖，
// 呼应竞品"多资金池独立核算"的精神，但V1只用一个账户的"本金/赠送"两个子池覆盖核心区分。
// 余额变更（充值/消费/退款/调整）均用数据库原子 increment 保证并发安全，不要求前端传
// expectedVersion——这是高频小额记账场景，与"整单编辑"的乐观锁语义不同（详见业务规则确认记录）。

enum CustomerAccountTransactionType {
  RECHARGE
  CONSUME
  REFUND
  ADJUST
}

model CustomerAccount {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  customerId       String   @unique @map("customer_id")
  principalBalance Int      @default(0) @map("principal_balance") // 客户实付本金余额，最小货币单位（分）
  giftBalance      Int      @default(0) @map("gift_balance") // 赠送/权益余额，最小货币单位（分）
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(0)

  customer     Customer                     @relation(fields: [customerId], references: [id])
  transactions CustomerAccountTransaction[]

  @@map("customer_accounts")
}

/// 消费(CONSUME)按"赠送优先，再扣本金"顺序自动拆分 principalDelta/giftDelta（均为负数）；
/// 退款(REFUND)由操作员显式指定退回本金/赠送各多少，系统不做反查原消费记录的自动比例拆分。
model CustomerAccountTransaction {
  id             String                         @id @default(cuid())
  tenantId       String                         @map("tenant_id")
  accountId      String                         @map("account_id")
  type           CustomerAccountTransactionType
  principalDelta Int                            @default(0) @map("principal_delta") // 可正可负
  giftDelta      Int                            @default(0) @map("gift_delta") // 可正可负
  principalAfter Int                            @map("principal_after")
  giftAfter      Int                            @map("gift_after")
  sourceType     String?                        @map("source_type") // 如 MANUAL/SERVICE_APPOINTMENT/CONTRACT
  sourceId       String?                        @map("source_id")
  remark         String?                        @db.Text
  createdBy      String                         @map("created_by")
  createdAt      DateTime                       @default(now()) @map("created_at")

  account CustomerAccount @relation(fields: [accountId], references: [id])

  @@index([tenantId, accountId])
  @@map("customer_account_transactions")
}

// ==================== 护理域（母婴履约深化 P2 第一切片：表单引擎 + 档案） ====================
// 业务规则依据：docs/竞品分析-一月妈咪月子中心管理系统功能架构逆向分析.md 3.3 节
// + docs/业务规则确认记录.md #6、#7（2026-07-28 确认）。

enum CareTargetType {
  MOTHER
  BABY
}

enum CareFieldControlType {
  NUMBER
  TEXT
  TEXTAREA
  SELECT
  RADIO
}

enum CareFormDepartment {
  NURSING // 护理部
  POSTPARTUM_RECOVERY // 产康部
  MEAL // 膳食部
  CUSTOMER_SERVICE // 客服部
  MEDICAL // 医务部（本切片不做"医嘱"能力，仅保留场景分类供未来扩展）
}

enum CareFormScene {
  GENERAL // 通用
  IN_HOUSE // 所内
  HOME_VISIT // 上户
  HOSPITAL // 医院
}

/// 护理字段元数据：四层可配置表单引擎的最底层（字段→项目→方案→计划）。
/// normalMin/normalMax 用于数值型字段的正常值域判定，normalOptionValues 用于选项型
/// 字段（数组，列出哪些选项值算正常）；两者都为空表示该字段仅作记录、不参与护理异常
/// 自动判定。本期只做"超范围即异常"的单档判定，不做多级严重度（业务规则确认记录#7）。
model CareFieldDefinition {
  id                 String               @id @default(cuid())
  tenantId           String               @map("tenant_id")
  code               String
  name               String
  targetType         CareTargetType       @map("target_type")
  controlType        CareFieldControlType @map("control_type")
  unit               String?
  options            Json? // SELECT/RADIO 候选项：[{value,label}]
  normalMin          Float?               @map("normal_min")
  normalMax          Float?               @map("normal_max")
  normalOptionValues Json?                @map("normal_option_values") // 选项型字段的正常值集合：string[]
  visibleToClient    Boolean              @default(false) @map("visible_to_client")
  status             CommonStatus         @default(ACTIVE)
  createdBy          String               @map("created_by")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  version            Int                  @default(0)

  formFields    CareFormTemplateField[]
  abnormalities CareAbnormality[]

  @@unique([tenantId, code])
  @@map("care_field_definitions")
}

/// 护理项目（表单模板）：按部门+场景分类的表单容器，字段引用通过中间表携带顺序与必填。
model CareFormTemplate {
  id         String             @id @default(cuid())
  tenantId   String             @map("tenant_id")
  code       String
  name       String
  targetType CareTargetType     @map("target_type")
  department CareFormDepartment
  scene      CareFormScene      @default(GENERAL)
  status     CommonStatus       @default(ACTIVE)
  createdBy  String             @map("created_by")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  version    Int                @default(0)

  fields      CareFormTemplateField[]
  planItems   CarePlanTemplateItem[]
  planTasks   CarePlanTask[]
  careRecords CareRecord[]

  @@unique([tenantId, code])
  @@map("care_form_templates")
}

model CareFormTemplateField {
  id             String  @id @default(cuid())
  formTemplateId String  @map("form_template_id")
  fieldId        String  @map("field_id")
  sortOrder      Int     @default(0) @map("sort_order")
  required       Boolean @default(false)

  formTemplate CareFormTemplate    @relation(fields: [formTemplateId], references: [id])
  field        CareFieldDefinition @relation(fields: [fieldId], references: [id])

  @@unique([formTemplateId, fieldId])
  @@map("care_form_template_fields")
}

/// 护理方案（模板）：把多个表单模板按"入住第几天"组合成天数化方案，
/// 如"妈妈护理入住方案28天"。CarePlan 激活时据此批量生成 CarePlanTask。
model CarePlanTemplate {
  id         String         @id @default(cuid())
  tenantId   String         @map("tenant_id")
  code       String
  name       String
  targetType CareTargetType @map("target_type")
  totalDays  Int            @map("total_days")
  status     CommonStatus   @default(ACTIVE)
  createdBy  String         @map("created_by")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  version    Int            @default(0)

  items CarePlanTemplateItem[]
  plans CarePlan[]

  @@unique([tenantId, code])
  @@map("care_plan_templates")
}

model CarePlanTemplateItem {
  id             String @id @default(cuid())
  planTemplateId String @map("plan_template_id")
  dayOffset      Int    @map("day_offset") // 入住第几天，从1开始
  formTemplateId String @map("form_template_id")

  planTemplate CarePlanTemplate @relation(fields: [planTemplateId], references: [id])
  formTemplate CareFormTemplate @relation(fields: [formTemplateId], references: [id])

  @@unique([planTemplateId, dayOffset, formTemplateId])
  @@map("care_plan_template_items")
}

enum DeliveryMethod {
  VAGINAL
  CESAREAN
  UNKNOWN
}

/// 妈妈档案：一次入住/一次月子周期一条记录，不是与 Customer 一一对应——同一客户
/// "再次入住"（二胎/二次月子）时新建一条档案，历史档案与其护理记录不覆盖、不删除，
/// 呼应"离店后房间释放但护理档案保留"的验收标准（业务规则确认记录#6）。
/// 风险标签（早产/传染病/高敏/妈咪住院等）不建独立字段，复用平台 Tag/TagBinding
/// （entityType='MOTHER_PROFILE'）。
model MotherProfile {
  id                   String         @id @default(cuid())
  tenantId             String         @map("tenant_id")
  storeId              String         @map("store_id")
  customerId           String         @map("customer_id")
  occupancyId          String?        @map("occupancy_id")
  deliveryMethod       DeliveryMethod @default(UNKNOWN) @map("delivery_method")
  deliveryDate         DateTime?      @map("delivery_date")
  gestationalWeeks     Int?           @map("gestational_weeks")
  expectedDeliveryDate DateTime?      @map("expected_delivery_date")
  remark               String?        @db.Text
  createdBy            String         @map("created_by")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  version              Int            @default(0)

  store         Store             @relation(fields: [storeId], references: [id])
  customer      Customer          @relation(fields: [customerId], references: [id])
  occupancy     RoomOccupancy?    @relation(fields: [occupancyId], references: [id])
  babies        BabyProfile[]
  carePlans     CarePlan[]
  careRecords   CareRecord[]
  abnormalities CareAbnormality[]

  @@index([tenantId, customerId])
  @@map("mother_profiles")
}

enum BabyGender {
  MALE
  FEMALE
  UNKNOWN
}

/// 宝宝档案：多胞胎＝同一 motherProfileId 下多条记录，用 sequenceNo 区分（业务规则确认记录#6）。
model BabyProfile {
  id               String     @id @default(cuid())
  tenantId         String     @map("tenant_id")
  storeId          String     @map("store_id")
  customerId       String     @map("customer_id")
  motherProfileId  String     @map("mother_profile_id")
  sequenceNo       Int        @default(1) @map("sequence_no")
  name             String?
  gender           BabyGender @default(UNKNOWN)
  birthDate        DateTime?  @map("birth_date")
  birthWeightGrams Int?       @map("birth_weight_grams")
  apgarScore       String?    @map("apgar_score")
  remark           String?    @db.Text
  createdBy        String     @map("created_by")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  version          Int        @default(0)

  store         Store             @relation(fields: [storeId], references: [id])
  customer      Customer          @relation(fields: [customerId], references: [id])
  motherProfile MotherProfile     @relation(fields: [motherProfileId], references: [id])
  carePlans     CarePlan[]
  careRecords   CareRecord[]
  abnormalities CareAbnormality[]

  @@unique([motherProfileId, sequenceNo])
  @@index([tenantId, customerId])
  @@map("baby_profiles")
}

enum CarePlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  TERMINATED
}

/// 护理计划：motherProfileId/babyProfileId 二选一（应用层保证，Prisma 无数据库级 XOR 约束）。
/// 激活时按 CarePlanTemplateItem 批量生成 CarePlanTask（每日任务卡片）。
model CarePlan {
  id              String         @id @default(cuid())
  tenantId        String         @map("tenant_id")
  storeId         String         @map("store_id")
  planNo          String         @map("plan_no")
  planTemplateId  String         @map("plan_template_id")
  motherProfileId String?        @map("mother_profile_id")
  babyProfileId   String?        @map("baby_profile_id")
  startDate       DateTime       @map("start_date") // 通常=入住日，方案第1天对应此日期
  status          CarePlanStatus @default(DRAFT)
  terminateReason String?        @map("terminate_reason") @db.Text
  createdBy       String         @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  version         Int            @default(0)

  store         Store            @relation(fields: [storeId], references: [id])
  planTemplate  CarePlanTemplate @relation(fields: [planTemplateId], references: [id])
  motherProfile MotherProfile?   @relation(fields: [motherProfileId], references: [id])
  babyProfile   BabyProfile?     @relation(fields: [babyProfileId], references: [id])
  tasks         CarePlanTask[]

  @@unique([tenantId, planNo])
  @@index([tenantId, motherProfileId])
  @@index([tenantId, babyProfileId])
  @@map("care_plans")
}

enum CarePlanTaskStatus {
  PENDING
  COMPLETED
  MISSED
}

/// 每日任务卡片：由 CarePlan 激活时按模板批量生成。careRecordId 在任务完成（护理记录提交）时回填。
model CarePlanTask {
  id             String             @id @default(cuid())
  carePlanId     String             @map("care_plan_id")
  dayOffset      Int                @map("day_offset")
  scheduledDate  DateTime           @map("scheduled_date")
  formTemplateId String             @map("form_template_id")
  status         CarePlanTaskStatus @default(PENDING)
  careRecordId   String?            @unique @map("care_record_id")

  carePlan     CarePlan         @relation(fields: [carePlanId], references: [id])
  formTemplate CareFormTemplate @relation(fields: [formTemplateId], references: [id])
  careRecord   CareRecord?      @relation("TaskCareRecord", fields: [careRecordId], references: [id])

  @@index([carePlanId, scheduledDate])
  @@map("care_plan_tasks")
}

/// 护理执行记录：一旦提交不可编辑（原记录不可变）。当天遗漏的记录通过"补录"提交
/// （isBackfilled=true 且必须填 backfillReason）；对已提交记录的修正通过"更正"提交一条
/// 新记录（correctionOfId 指向原记录），原记录保留、新增更正记录，配合 AuditLog 留痕
/// （业务规则确认记录#7）。values 是字段值的快照（{fieldCode: value}），字段定义变更
/// 不影响历史记录内容。
model CareRecord {
  id              String         @id @default(cuid())
  tenantId        String         @map("tenant_id")
  storeId         String         @map("store_id")
  recordNo        String         @map("record_no")
  formTemplateId  String         @map("form_template_id")
  targetType      CareTargetType @map("target_type")
  motherProfileId String?        @map("mother_profile_id")
  babyProfileId   String?        @map("baby_profile_id")
  occurredAt      DateTime       @map("occurred_at") // 护理行为实际发生时间（如所属班次时段）
  values          Json // {fieldCode: value} 快照
  isBackfilled    Boolean        @default(false) @map("is_backfilled")
  backfillReason  String?        @map("backfill_reason") @db.Text
  correctionOfId  String?        @map("correction_of_id")
  submittedBy     String         @map("submitted_by")
  createdAt       DateTime       @default(now()) @map("created_at")

  store         Store             @relation(fields: [storeId], references: [id])
  formTemplate  CareFormTemplate  @relation(fields: [formTemplateId], references: [id])
  motherProfile MotherProfile?    @relation(fields: [motherProfileId], references: [id])
  babyProfile   BabyProfile?      @relation(fields: [babyProfileId], references: [id])
  correctionOf  CareRecord?       @relation("RecordCorrection", fields: [correctionOfId], references: [id])
  corrections   CareRecord[]      @relation("RecordCorrection")
  planTask      CarePlanTask?     @relation("TaskCareRecord")
  abnormalities CareAbnormality[]

  @@unique([tenantId, recordNo])
  @@index([tenantId, motherProfileId])
  @@index([tenantId, babyProfileId])
  @@map("care_records")
}

enum CareAbnormalityStatus {
  OPEN
  FOLLOWING
  RESOLVED
  IGNORED
}

/// 护理异常：由 CareRecord 提交时按字段定义的正常值域自动生成（单档判定，不做多级严重度，
/// 业务规则确认记录#7）。跟进复用平台通用的 FollowUpRecord（businessType='CARE_ABNORMALITY'），
/// 不新建独立跟进表。状态机：OPEN -> FOLLOWING -> RESOLVED；OPEN/FOLLOWING -> IGNORED。
model CareAbnormality {
  id              String                @id @default(cuid())
  tenantId        String                @map("tenant_id")
  storeId         String                @map("store_id")
  careRecordId    String                @map("care_record_id")
  fieldId         String                @map("field_id")
  targetType      CareTargetType        @map("target_type")
  motherProfileId String?               @map("mother_profile_id")
  babyProfileId   String?               @map("baby_profile_id")
  occurredAt      DateTime              @map("occurred_at")
  fieldValue      Json                  @map("field_value") // 触发异常的原始值快照
  status          CareAbnormalityStatus @default(OPEN)
  resolvedBy      String?               @map("resolved_by")
  resolvedAt      DateTime?             @map("resolved_at")
  resolveNote     String?               @map("resolve_note") @db.Text
  createdBy       String                @map("created_by")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  version         Int                   @default(0)

  store         Store               @relation(fields: [storeId], references: [id])
  careRecord    CareRecord          @relation(fields: [careRecordId], references: [id])
  field         CareFieldDefinition @relation(fields: [fieldId], references: [id])
  motherProfile MotherProfile?      @relation(fields: [motherProfileId], references: [id])
  babyProfile   BabyProfile?        @relation(fields: [babyProfileId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, motherProfileId])
  @@index([tenantId, babyProfileId])
  @@map("care_abnormalities")
}

// ==================== 住店运营细化（呼叫/外出/客房服务领用） ====================

enum RoomCallStatus {
  PENDING
  HANDLED
}

model RoomCall {
  id          String         @id @default(cuid())
  tenantId    String         @map("tenant_id")
  storeId     String         @map("store_id")
  occupancyId String         @map("occupancy_id")
  reason      String
  status      RoomCallStatus @default(PENDING)
  calledAt    DateTime       @default(now()) @map("called_at")
  handledAt   DateTime?      @map("handled_at")
  handledBy   String?        @map("handled_by")
  remark      String?        @db.Text
  createdBy   String         @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")

  store     Store         @relation(fields: [storeId], references: [id])
  occupancy RoomOccupancy @relation(fields: [occupancyId], references: [id])

  @@index([tenantId, status])
  @@map("room_calls")
}

enum RoomOutingStatus {
  PLANNED
  OUT
  RETURNED
  CANCELLED
}

/// 外出管理：PLANNED -(签出)-> OUT -(签回)-> RETURNED；PLANNED -> CANCELLED。
model RoomOuting {
  id            String           @id @default(cuid())
  tenantId      String           @map("tenant_id")
  storeId       String           @map("store_id")
  occupancyId   String           @map("occupancy_id")
  plannedOutAt  DateTime         @map("planned_out_at")
  plannedBackAt DateTime         @map("planned_back_at")
  actualOutAt   DateTime?        @map("actual_out_at")
  actualBackAt  DateTime?        @map("actual_back_at")
  riskNote      String?          @map("risk_note") @db.Text
  status        RoomOutingStatus @default(PLANNED)
  cancelReason  String?          @map("cancel_reason") @db.Text
  createdBy     String           @map("created_by")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  version       Int              @default(0)

  store     Store         @relation(fields: [storeId], references: [id])
  occupancy RoomOccupancy @relation(fields: [occupancyId], references: [id])

  @@index([tenantId, status])
  @@map("room_outings")
}

enum RoomRequisitionStatus {
  REQUESTED
  FULFILLED
}

/// 客房服务领用：本期不接库存域（P3 才有真实进销存单据），itemName 为自由文本登记，
/// 不与任何库存表联动扣减，待 P3 库存域落地后再补出库单联动。
model RoomServiceRequisition {
  id          String                @id @default(cuid())
  tenantId    String                @map("tenant_id")
  storeId     String                @map("store_id")
  occupancyId String                @map("occupancy_id")
  itemName    String                @map("item_name")
  quantity    Int                   @default(1)
  status      RoomRequisitionStatus @default(REQUESTED)
  requestedAt DateTime              @default(now()) @map("requested_at")
  fulfilledAt DateTime?             @map("fulfilled_at")
  fulfilledBy String?               @map("fulfilled_by")
  remark      String?               @db.Text
  createdBy   String                @map("created_by")
  createdAt   DateTime              @default(now()) @map("created_at")

  store     Store         @relation(fields: [storeId], references: [id])
  occupancy RoomOccupancy @relation(fields: [occupancyId], references: [id])

  @@index([tenantId, status])
  @@map("room_service_requisitions")
}

// ==================== 月子餐（膳食域） ====================
// 业务规则依据：docs/竞品分析-一月妈咪月子中心管理系统功能架构逆向分析.md 3.6 节。
// 预算→采购/出库联动（与库存打通）本期不做，待 P3 库存域落地后再接入。

enum MealPlanType {
  MONTH_MEAL // 月子餐
  MINI_MONTH // 小月子
  TRIAL // 试吃
  DELIVERY // 外送餐
  VIP
}

enum MealSlot {
  BREAKFAST
  MORNING_SNACK
  LUNCH
  AFTERNOON_SNACK
  DINNER
  NIGHT_SNACK
}

/// 膳食计划模板：phases 仅作阶段化展示用（如"7-7-7-7"对应产褥期分阶段营养需求），
/// 真正驱动每日排餐的是 MealPlanTemplateItem（dayOffset+slot -> 默认菜品）。
model MealPlanTemplate {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  code      String
  name      String
  planType  MealPlanType @map("plan_type")
  totalDays Int          @map("total_days")
  phases    Json? // 展示用：[{name,days}]
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  items         MealPlanTemplateItem[]
  dinerProfiles DinerProfile[]

  @@unique([tenantId, code])
  @@map("meal_plan_templates")
}

/// 菜品：ingredientTags 用于与"食材类禁忌"做冲突匹配（DietaryRestriction.category=INGREDIENT）。
model MealItem {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  code           String
  name           String
  defaultSlot    MealSlot     @map("default_slot")
  ingredientTags Json? // string[]
  status         CommonStatus @default(ACTIVE)
  createdBy      String       @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  version        Int          @default(0)

  planItems           MealPlanTemplateItem[]
  mealRecordsDefault  MealRecord[]           @relation("DefaultMealItem")
  mealRecordsSelected MealRecord[]           @relation("SelectedMealItem")

  @@unique([tenantId, code])
  @@map("meal_items")
}

model MealPlanTemplateItem {
  id             String   @id @default(cuid())
  planTemplateId String   @map("plan_template_id")
  dayOffset      Int      @map("day_offset")
  slot           MealSlot
  mealItemId     String   @map("meal_item_id")

  planTemplate MealPlanTemplate @relation(fields: [planTemplateId], references: [id])
  mealItem     MealItem         @relation(fields: [mealItemId], references: [id])

  @@unique([planTemplateId, dayOffset, slot])
  @@map("meal_plan_template_items")
}

enum DietaryRestrictionCategory {
  INGREDIENT // 食材类：忌鸡蛋/忌牛肉等
  MEDICAL // 病理性：妊娠高血压/妊娠糖尿病等
}

model DietaryRestriction {
  id        String                     @id @default(cuid())
  tenantId  String                     @map("tenant_id")
  code      String
  name      String
  category  DietaryRestrictionCategory
  status    CommonStatus               @default(ACTIVE)
  createdBy String                     @map("created_by")
  createdAt DateTime                   @default(now()) @map("created_at")
  updatedAt DateTime                   @updatedAt @map("updated_at")
  version   Int                        @default(0)

  dinerRestrictions DinerRestriction[]

  @@unique([tenantId, code])
  @@map("dietary_restrictions")
}

enum DinerProfileStatus {
  ACTIVE
  ENDED
}

/// 用膳人：客户绑定膳食计划模板的一段用膳周期，startDate/endDate 由 totalDays 推算。
/// 创建时按 MealPlanTemplateItem 批量生成 MealRecord（同 CarePlan 生成 CarePlanTask 的模式）。
model DinerProfile {
  id                 String             @id @default(cuid())
  tenantId           String             @map("tenant_id")
  storeId            String             @map("store_id")
  customerId         String             @map("customer_id")
  mealPlanTemplateId String             @map("meal_plan_template_id")
  occupancyId        String?            @map("occupancy_id")
  startDate          DateTime           @map("start_date")
  endDate            DateTime           @map("end_date")
  status             DinerProfileStatus @default(ACTIVE)
  createdBy          String             @map("created_by")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  version            Int                @default(0)

  store            Store              @relation(fields: [storeId], references: [id])
  customer         Customer           @relation(fields: [customerId], references: [id])
  mealPlanTemplate MealPlanTemplate   @relation(fields: [mealPlanTemplateId], references: [id])
  occupancy        RoomOccupancy?     @relation(fields: [occupancyId], references: [id])
  restrictions     DinerRestriction[]
  mealRecords      MealRecord[]

  @@index([tenantId, customerId])
  @@map("diner_profiles")
}

model DinerRestriction {
  id             String @id @default(cuid())
  dinerProfileId String @map("diner_profile_id")
  restrictionId  String @map("restriction_id")

  dinerProfile DinerProfile       @relation(fields: [dinerProfileId], references: [id])
  restriction  DietaryRestriction @relation(fields: [restrictionId], references: [id])

  @@unique([dinerProfileId, restrictionId])
  @@map("diner_restrictions")
}

enum MealRecordStatus {
  PLANNED
  SERVED
  CANCELLED
}

/// 每日排餐记录：defaultMealItemId 来自方案排期，isCustomSelected 标记客户"自选餐"覆盖了
/// 默认菜品（早餐/早点不可当日自选、当日9点后不可自选，见 MealRecordService 注释）。
model MealRecord {
  id                 String           @id @default(cuid())
  tenantId           String           @map("tenant_id")
  storeId            String           @map("store_id")
  dinerProfileId     String           @map("diner_profile_id")
  scheduledDate      DateTime         @map("scheduled_date")
  slot               MealSlot
  defaultMealItemId  String           @map("default_meal_item_id")
  isCustomSelected   Boolean          @default(false) @map("is_custom_selected")
  selectedMealItemId String?          @map("selected_meal_item_id")
  selectedAt         DateTime?        @map("selected_at")
  status             MealRecordStatus @default(PLANNED)
  servedAt           DateTime?        @map("served_at")
  servedBy           String?          @map("served_by")
  rating             Int?
  comment            String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  version            Int              @default(0)

  store            Store        @relation(fields: [storeId], references: [id])
  dinerProfile     DinerProfile @relation(fields: [dinerProfileId], references: [id])
  defaultMealItem  MealItem     @relation("DefaultMealItem", fields: [defaultMealItemId], references: [id])
  selectedMealItem MealItem?    @relation("SelectedMealItem", fields: [selectedMealItemId], references: [id])

  @@index([tenantId, dinerProfileId, scheduledDate])
  @@map("meal_records")
}

// ==================== 产康服务（服务域） ====================
// 业务规则依据：docs/竞品分析-一月妈咪月子中心管理系统功能架构逆向分析.md 3.4 节。
// 本期不做：跨店服务通兑、双销售人分成、优惠审批、物料出库联动——均待后续切片/P3库存域补上。

model ServiceProduct {
  id              String       @id @default(cuid())
  tenantId        String       @map("tenant_id")
  code            String
  name            String
  durationMinutes Int?         @map("duration_minutes")
  unitPrice       Int?         @map("unit_price") // 最小货币单位，可空——仅按套餐消耗、不单卖的项目可不设散卖价
  status          CommonStatus @default(ACTIVE)
  createdBy       String       @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  version         Int          @default(0)

  appointments ServiceAppointment[]

  @@unique([tenantId, code])
  @@map("service_products")
}

/// 服务包：购买时不预先绑定具体项目，执行时才临时消耗额度（"按需项目机制"，竞品分析3.4）。
model ServicePackage {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  code          String
  name          String
  totalSessions Int          @map("total_sessions")
  price         Int // 最小货币单位
  status        CommonStatus @default(ACTIVE)
  createdBy     String       @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  version       Int          @default(0)

  customerPackages CustomerServicePackage[]

  @@unique([tenantId, code])
  @@map("service_packages")
}

enum CustomerServicePackageStatus {
  ACTIVE
  EXHAUSTED
}

model CustomerServicePackage {
  id                String                       @id @default(cuid())
  tenantId          String                       @map("tenant_id")
  storeId           String                       @map("store_id")
  customerId        String                       @map("customer_id")
  packageId         String                       @map("package_id")
  remainingSessions Int                          @map("remaining_sessions")
  amount            Int
  status            CustomerServicePackageStatus @default(ACTIVE)
  purchasedAt       DateTime                     @default(now()) @map("purchased_at")
  createdBy         String                       @map("created_by")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  version           Int                          @default(0)

  store        Store                @relation(fields: [storeId], references: [id])
  customer     Customer             @relation(fields: [customerId], references: [id])
  package      ServicePackage       @relation(fields: [packageId], references: [id])
  appointments ServiceAppointment[]

  @@index([tenantId, customerId])
  @@map("customer_service_packages")
}

model Therapist {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  storeId   String       @map("store_id")
  name      String
  phone     String?
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  store        Store                @relation(fields: [storeId], references: [id])
  appointments ServiceAppointment[]

  @@index([tenantId, storeId])
  @@map("therapists")
}

enum ServiceAppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// 预约：BOOKED -(完成)-> COMPLETED（若 sourcePackageId 存在则扣减套餐剩余次数）；
/// BOOKED -> CANCELLED/NO_SHOW。完成即视为执行+消项（本期不拆独立执行记录表）。
model ServiceAppointment {
  id              String                   @id @default(cuid())
  tenantId        String                   @map("tenant_id")
  storeId         String                   @map("store_id")
  appointmentNo   String                   @map("appointment_no")
  customerId      String                   @map("customer_id")
  productId       String                   @map("product_id")
  therapistId     String?                  @map("therapist_id")
  sourcePackageId String?                  @map("source_package_id")
  scheduledAt     DateTime                 @map("scheduled_at")
  durationMinutes Int                      @map("duration_minutes")
  status          ServiceAppointmentStatus @default(BOOKED)
  completedAt     DateTime?                @map("completed_at")
  cancelReason    String?                  @map("cancel_reason") @db.Text
  rating          Int?
  comment         String?                  @db.Text
  createdBy       String                   @map("created_by")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  version         Int                      @default(0)

  store         Store                   @relation(fields: [storeId], references: [id])
  customer      Customer                @relation(fields: [customerId], references: [id])
  product       ServiceProduct          @relation(fields: [productId], references: [id])
  therapist     Therapist?              @relation(fields: [therapistId], references: [id])
  sourcePackage CustomerServicePackage? @relation(fields: [sourcePackageId], references: [id])

  @@unique([tenantId, appointmentNo])
  @@index([tenantId, customerId])
  @@index([tenantId, therapistId, scheduledAt])
  @@map("service_appointments")
}

// ==================== 库存（进销存全链路，交易与供应域） ====================
// 业务规则依据：docs/竞品分析-一月妈咪月子中心管理系统功能架构逆向分析.md 3.7 节
// + docs/伴月轩月子中心管理系统_新系统开发文档_V1.0.docx 第9章"后勤管理"（复用同一套模型）。
// 单据状态机审批复用通用工作流引擎，采用与 Contract/Payment 完全相同的
// "reconcileStatus() 懒同步"模式（见各 Service 注释），不侵入 WorkflowEngineModule。
// 范围收窄（记录供后续参考）：
//   - 采购单(PurchaseOrder)始终走审批，不受仓库"免审批"配置影响（花钱承诺，风险等级不同于仓内操作）；
//     入库单若挂在已审批的采购单下则跳过自身审批（视为已获授权），未挂采购单的临时入库仍按
//     仓库 requiresApproval 配置决定是否需要审批；出库/领用/调拨/盘点同样按仓库配置决定。
//   - 调拨单以"源仓库"的 requiresApproval 配置为准（源头承担风险方）。
//   - 不做采购单"收货进度/超收校验"，入库数量与采购数量的对比只做展示，不做强校验。
//   - 服务物料桥梁（护理/产康服务核销后自动生成待出库列表）、备料包（套餐→物料清单自动关联）
//     本期不做，待后续切片把 P2 的护理/产康/月子餐模块反向接入库存域时再设计。
//   - 移动加权平均法核算成本；批次(StockBatch)只追踪数量与效期，用于"先到期先出"(FEFO)扣减与
//     过期预警，不做批次级FIFO成本核算（成本核算只在 WarehouseStock 汇总层做加权平均）。

enum WarehousePurpose {
  OPERATING // 经营性库存（食材、服务耗材等）
  LOGISTICS // 后勤库房（P3后勤管理模块复用同一套模型，仅用本字段隔离）
}

model Supplier {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  code        String
  name        String
  contactName String?      @map("contact_name")
  phone       String?
  remark      String?      @db.Text
  status      CommonStatus @default(ACTIVE)
  createdBy   String       @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  version     Int          @default(0)

  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@map("suppliers")
}

/// 仓库：requiresApproval=false 时该仓库的入库/出库/领用/盘点单跳过工作流审批，直接
/// DRAFT->APPROVED（"仓库级免审批"配置，竞品分析3.7）。
model Warehouse {
  id               String           @id @default(cuid())
  tenantId         String           @map("tenant_id")
  storeId          String           @map("store_id")
  code             String
  name             String
  purpose          WarehousePurpose @default(OPERATING)
  requiresApproval Boolean          @default(true) @map("requires_approval")
  status           CommonStatus     @default(ACTIVE)
  createdBy        String           @map("created_by")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  version          Int              @default(0)

  store          Store            @relation(fields: [storeId], references: [id])
  stocks         WarehouseStock[]
  batches        StockBatch[]
  goodsReceipts  GoodsReceipt[]
  stockIssues    StockIssue[]
  transfersOut   StockTransfer[]  @relation("TransferFrom")
  transfersIn    StockTransfer[]  @relation("TransferTo")
  stockCounts    StockCount[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@map("warehouses")
}

model InventoryItem {
  id                   String           @id @default(cuid())
  tenantId             String           @map("tenant_id")
  code                 String
  name                 String
  unit                 String // 计量单位，如"件"/"kg"/"箱"
  category             String?
  purpose              WarehousePurpose @default(OPERATING)
  safetyStockThreshold Int?             @map("safety_stock_threshold") // 低于此数量触发低库存预警，空=不预警
  shelfLifeDays        Int?             @map("shelf_life_days") // 保质期天数，空=不追踪效期
  status               CommonStatus     @default(ACTIVE)
  createdBy            String           @map("created_by")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  version              Int              @default(0)

  stocks             WarehouseStock[]
  batches            StockBatch[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  stockIssueItems    StockIssueItem[]
  stockTransferItems StockTransferItem[]
  stockCountItems    StockCountItem[]

  @@unique([tenantId, code])
  @@map("inventory_items")
}

/// 库存汇总层：每个仓库+物品的当前数量与移动加权平均成本，只能被各单据的 execute() 更新，
/// 不提供直接编辑接口（保证所有变动都有单据留痕）。
model WarehouseStock {
  id          String   @id @default(cuid())
  warehouseId String   @map("warehouse_id")
  itemId      String   @map("item_id")
  quantity    Int      @default(0)
  avgCost     Int      @default(0) @map("avg_cost") // 移动加权平均单位成本，最小货币单位
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  item      InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([warehouseId, itemId])
  @@map("warehouse_stocks")
}

/// 批次层：追踪效期用于 FEFO（先到期先出）扣减与过期预警，不做批次级成本核算。
/// sourceType/sourceId 追溯批次的产生来源（入库单/调拨单/盘点盈余）。
model StockBatch {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  warehouseId String    @map("warehouse_id")
  itemId      String    @map("item_id")
  batchNo     String    @map("batch_no")
  quantity    Int // 该批次剩余数量
  unitCost    Int       @map("unit_cost") // 该批次入库时的单位成本，仅供追溯展示
  receivedAt  DateTime  @map("received_at")
  expiresAt   DateTime? @map("expires_at") // 空=不追踪效期（item.shelfLifeDays 未配置）
  sourceType  String    @map("source_type") // GOODS_RECEIPT / STOCK_TRANSFER / STOCK_COUNT
  sourceId    String    @map("source_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  item      InventoryItem @relation(fields: [itemId], references: [id])

  @@index([warehouseId, itemId, expiresAt])
  @@map("stock_batches")
}

enum InventoryDocStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

/// 采购单(CG)：DRAFT -(提交)-> PENDING_APPROVAL -(工作流审批)-> APPROVED/REJECTED；
/// APPROVED 后可据此创建入库单（收货数量与采购数量的对比只做展示，不做强校验，见 schema 顶部范围收窄说明）。
model PurchaseOrder {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  storeId      String             @map("store_id")
  warehouseId  String             @map("warehouse_id")
  supplierId   String             @map("supplier_id")
  orderNo      String             @map("order_no")
  status       InventoryDocStatus @default(DRAFT)
  totalAmount  Int                @default(0) @map("total_amount") // 冗余汇总，最小货币单位
  remark       String?            @db.Text
  cancelReason String?            @map("cancel_reason") @db.Text
  createdBy    String             @map("created_by")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  version      Int                @default(0)

  store         Store               @relation(fields: [storeId], references: [id])
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id])
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([tenantId, orderNo])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String @map("purchase_order_id")
  itemId          String @map("item_id")
  quantity        Int
  unitPrice       Int    @map("unit_price") // 最小货币单位
  subtotal        Int // quantity * unitPrice，创建时算好落库，避免每次读取重复计算

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  item          InventoryItem @relation(fields: [itemId], references: [id])

  @@map("purchase_order_items")
}

/// 入库单(RK)：执行(execute)时更新 WarehouseStock（移动加权平均法重算成本）并生成 StockBatch。
/// 完成后不可变，需要冲正时创建一张新的入库单/出库单反向操作，不修改已完成单据本身。
model GoodsReceipt {
  id              String             @id @default(cuid())
  tenantId        String             @map("tenant_id")
  storeId         String             @map("store_id")
  warehouseId     String             @map("warehouse_id")
  purchaseOrderId String?            @map("purchase_order_id") // 挂在已审批采购单下则跳过自身审批
  receiptNo       String             @map("receipt_no")
  status          InventoryDocStatus @default(DRAFT)
  remark          String?            @db.Text
  cancelReason    String?            @map("cancel_reason") @db.Text
  completedAt     DateTime?          @map("completed_at")
  createdBy       String             @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  version         Int                @default(0)

  store         Store              @relation(fields: [storeId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  items         GoodsReceiptItem[]

  @@unique([tenantId, receiptNo])
  @@index([tenantId, status])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String @id @default(cuid())
  goodsReceiptId String @map("goods_receipt_id")
  itemId         String @map("item_id")
  quantity       Int
  unitCost       Int    @map("unit_cost") // 最小货币单位，用于移动加权平均法与批次成本

  goodsReceipt GoodsReceipt  @relation(fields: [goodsReceiptId], references: [id])
  item         InventoryItem @relation(fields: [itemId], references: [id])

  @@map("goods_receipt_items")
}

enum StockIssueType {
  ISSUE // 一般出库
  REQUISITION // 部门领用（对应竞品分析的"领用单(LY)"，用途/部门在 remark 里登记）
  LOSS // 报损
}

/// 出库/领用单(CK/LY 合一，用 issueType 区分)：执行时按 FEFO 扣减 StockBatch，
/// WarehouseStock.avgCost 不变（出库不改变剩余库存的加权平均成本）。
model StockIssue {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  storeId      String             @map("store_id")
  warehouseId  String             @map("warehouse_id")
  issueNo      String             @map("issue_no")
  issueType    StockIssueType     @default(ISSUE) @map("issue_type")
  status       InventoryDocStatus @default(DRAFT)
  remark       String?            @db.Text
  cancelReason String?            @map("cancel_reason") @db.Text
  completedAt  DateTime?          @map("completed_at")
  createdBy    String             @map("created_by")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  version      Int                @default(0)

  store     Store            @relation(fields: [storeId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  items     StockIssueItem[]

  @@unique([tenantId, issueNo])
  @@index([tenantId, status])
  @@map("stock_issues")
}

model StockIssueItem {
  id           String @id @default(cuid())
  stockIssueId String @map("stock_issue_id")
  itemId       String @map("item_id")
  quantity     Int
  unitCost     Int?   @map("unit_cost") // 执行时按当前 avgCost 快照写入，用于成本报表，创建时为空

  stockIssue StockIssue    @relation(fields: [stockIssueId], references: [id])
  item       InventoryItem @relation(fields: [itemId], references: [id])

  @@map("stock_issue_items")
}

/// 调拨单(DB，含跨店)：以源仓库(fromWarehouse)的 requiresApproval 配置决定是否需要审批。
/// 执行时源仓库按 FEFO 扣减、批次"搬家"到目标仓库（沿用原 receivedAt/expiresAt），
/// 目标仓库按移动加权平均法用源仓库当前 avgCost 重算成本。
model StockTransfer {
  id              String             @id @default(cuid())
  tenantId        String             @map("tenant_id")
  fromWarehouseId String             @map("from_warehouse_id")
  toWarehouseId   String             @map("to_warehouse_id")
  transferNo      String             @map("transfer_no")
  status          InventoryDocStatus @default(DRAFT)
  remark          String?            @db.Text
  cancelReason    String?            @map("cancel_reason") @db.Text
  completedAt     DateTime?          @map("completed_at")
  createdBy       String             @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  version         Int                @default(0)

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items         StockTransferItem[]

  @@unique([tenantId, transferNo])
  @@index([tenantId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id              String @id @default(cuid())
  stockTransferId String @map("stock_transfer_id")
  itemId          String @map("item_id")
  quantity        Int

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id])
  item          InventoryItem @relation(fields: [itemId], references: [id])

  @@map("stock_transfer_items")
}

/// 盘点单(PD)：创建时快照系统当前数量(systemQuantity)，执行时把 WarehouseStock.quantity
/// 直接修正为盘点数(countedQuantity)，盈亏差额(diffQuantity)通过批次调整留痕
/// （盘盈生成新批次、盘亏按FEFO消耗批次），avgCost 不变。
model StockCount {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  storeId      String             @map("store_id")
  warehouseId  String             @map("warehouse_id")
  countNo      String             @map("count_no")
  status       InventoryDocStatus @default(DRAFT)
  remark       String?            @db.Text
  cancelReason String?            @map("cancel_reason") @db.Text
  completedAt  DateTime?          @map("completed_at")
  createdBy    String             @map("created_by")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  version      Int                @default(0)

  store     Store            @relation(fields: [storeId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  items     StockCountItem[]

  @@unique([tenantId, countNo])
  @@index([tenantId, status])
  @@map("stock_counts")
}

model StockCountItem {
  id              String @id @default(cuid())
  stockCountId    String @map("stock_count_id")
  itemId          String @map("item_id")
  systemQuantity  Int    @map("system_quantity") // 创建盘点单时快照的系统账面数量
  countedQuantity Int    @map("counted_quantity") // 实际盘点数量
  diffQuantity    Int    @map("diff_quantity") // countedQuantity - systemQuantity，创建时算好落库

  stockCount StockCount    @relation(fields: [stockCountId], references: [id])
  item       InventoryItem @relation(fields: [itemId], references: [id])

  @@map("stock_count_items")
}

// ==================== 人事（组织与治理域） ====================
// 业务规则依据：docs/竞品分析-一月妈咪月子中心管理系统功能架构逆向分析.md 3.9 节
// + docs/业务规则确认记录.md「2026-07-29 P3人事排班薪酬启动」章节的范围收窄记录。
// 提成/薪资审批复用通用工作流引擎，采用与 Contract/Payment/Inventory 完全相同的
// "reconcileStatus() 懒同步"模式。
// 范围收窄（记录供后续参考）：
//   - 员工档案是 Account 的 1:1 HR 扩展，不重开一套身份信息。
//   - 业绩提成(三级分账)与手工费(三人分摊)统一成一个 CommissionRecord+Allocation 模型，
//     角色用自由文本而非写死的三级/三人枚举。
//   - 业绩目标三级分配、变更管理自动冲正、排班冲突检测/自动排班建议、到期提醒的自动推送——
//     本期均不做。

enum EmploymentType {
  EMPLOYEE // 员工制
  NON_EMPLOYEE // 非员工制（如按次结算的兼职/合作人员）
}

enum EmployeeProfileStatus {
  ACTIVE // 在职
  ON_LEAVE // 休假中
  TERMINATED // 已离职
}

/// 员工档案：Account 的 1:1 HR 扩展（姓名/门店/部门/团队/职位等身份信息已在 Account 上，
/// 这里只存 HR 特有字段），accountId 唯一。
model EmployeeProfile {
  id                  String                @id @default(cuid())
  tenantId            String                @map("tenant_id")
  accountId           String                @unique @map("account_id")
  employeeNo          String                @map("employee_no")
  hireDate            DateTime              @map("hire_date")
  employmentType      EmploymentType        @default(EMPLOYEE) @map("employment_type")
  healthCertExpiresAt DateTime?             @map("health_cert_expires_at")
  contractExpiresAt   DateTime?             @map("contract_expires_at")
  probationEndsAt     DateTime?             @map("probation_ends_at")
  terminationDate     DateTime?             @map("termination_date")
  status              EmployeeProfileStatus @default(ACTIVE)
  remark              String?               @db.Text
  createdBy           String                @map("created_by")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  version             Int                   @default(0)

  account               Account                @relation(fields: [accountId], references: [id])
  scheduleEntries       ScheduleEntry[]
  commissionAllocations CommissionAllocation[]
  payrollRecords        PayrollRecord[]
  leaveRequests         LeaveRequest[]

  @@unique([tenantId, employeeNo])
  @@map("employee_profiles")
}

/// 班次定义：门店级可配置（不同门店班次时段可能不同），如白班/中班/晚班/夜班/护士早班。
model ShiftDefinition {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  storeId   String       @map("store_id")
  code      String
  name      String
  startTime String       @map("start_time") // "HH:mm"，跨零点的班次（如夜班22:00-06:00）由前端按 startTime>endTime 判断显示
  endTime   String       @map("end_time")
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  store           Store           @relation(fields: [storeId], references: [id])
  scheduleEntries ScheduleEntry[]

  @@unique([tenantId, storeId, code])
  @@map("shift_definitions")
}

/// 排班记录：一名员工一天一条（本期不支持一天拆分多班次）。
model ScheduleEntry {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  storeId           String   @map("store_id")
  employeeProfileId String   @map("employee_profile_id")
  workDate          DateTime @map("work_date")
  shiftDefinitionId String   @map("shift_definition_id")
  remark            String?  @db.Text
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  version           Int      @default(0)

  store           Store           @relation(fields: [storeId], references: [id])
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id])
  shiftDefinition ShiftDefinition @relation(fields: [shiftDefinitionId], references: [id])

  @@unique([employeeProfileId, workDate])
  @@index([tenantId, storeId, workDate])
  @@map("schedule_entries")
}

enum CommissionType {
  SALES // 业绩提成：基于签约/续签/服务包/项目/服务卡等"回款"触发
  LABOR // 手工费：基于护理/产康具体服务项目触发
}

enum CommissionRecordStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

/// 提成记录：DRAFT -(提交)-> PENDING_APPROVAL -(工作流审批)-> APPROVED/REJECTED。
/// sourceType/sourceId 追溯触发单据（如 PAYMENT/SERVICE_APPOINTMENT/CUSTOMER_SERVICE_PACKAGE），
/// 不做外键约束（跨模块泛化引用，同 WorkflowInstance.businessType/businessId 的设计）。
model CommissionRecord {
  id           String                 @id @default(cuid())
  tenantId     String                 @map("tenant_id")
  storeId      String                 @map("store_id")
  type         CommissionType
  sourceType   String                 @map("source_type")
  sourceId     String                 @map("source_id")
  totalAmount  Int                    @map("total_amount") // 最小货币单位，等于各分配明细之和
  status       CommissionRecordStatus @default(DRAFT)
  remark       String?                @db.Text
  cancelReason String?                @map("cancel_reason") @db.Text
  createdBy    String                 @map("created_by")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  version      Int                    @default(0)

  store       Store                  @relation(fields: [storeId], references: [id])
  allocations CommissionAllocation[]

  @@index([tenantId, storeId, status])
  @@index([tenantId, sourceType, sourceId])
  @@map("commission_records")
}

/// 分配明细：roleLabel 用自由文本（如"销售"/"主管"/"店长"/"第一服务人"），
/// 不写死三级/三人的固定结构，一笔业绩可按需拆给任意多名员工。
model CommissionAllocation {
  id                 String @id @default(cuid())
  commissionRecordId String @map("commission_record_id")
  employeeProfileId  String @map("employee_profile_id")
  roleLabel          String @map("role_label")
  basisPoints        Int    @map("basis_points") // 万分比，0-10000 代表 0.00%-100.00%
  amount             Int // totalAmount * basisPoints / 10000，创建时算好落库

  commissionRecord CommissionRecord @relation(fields: [commissionRecordId], references: [id])
  employeeProfile  EmployeeProfile  @relation(fields: [employeeProfileId], references: [id])

  @@index([employeeProfileId])
  @@map("commission_allocations")
}

enum PayrollRecordStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  PAID
}

/// 薪资单：DRAFT -(提交)-> PENDING_APPROVAL -(2级审批：店长初审->超管终审)-> APPROVED
/// -(标记发放)-> PAID。commissionTotal 是创建时对该员工当期已批准 CommissionAllocation 的
/// 快照汇总，之后提成再变化不会回溯影响已生成的薪资单。
model PayrollRecord {
  id                String              @id @default(cuid())
  tenantId          String              @map("tenant_id")
  storeId           String              @map("store_id")
  employeeProfileId String              @map("employee_profile_id")
  period            String // "YYYY-MM"
  baseSalary        Int                 @map("base_salary")
  commissionTotal   Int                 @default(0) @map("commission_total")
  deductions        Int                 @default(0)
  netAmount         Int                 @map("net_amount") // baseSalary + commissionTotal - deductions，创建时算好落库
  status            PayrollRecordStatus @default(DRAFT)
  paidAt            DateTime?           @map("paid_at")
  remark            String?             @db.Text
  cancelReason      String?             @map("cancel_reason") @db.Text
  createdBy         String              @map("created_by")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  version           Int                 @default(0)

  store           Store           @relation(fields: [storeId], references: [id])
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id])

  @@unique([tenantId, employeeProfileId, period])
  @@index([tenantId, storeId, status])
  @@map("payroll_records")
}

// ==================== 办公审批（固定几种常用单据类型，不做自定义表单引擎，见业务规则确认记录#13） ====================
// 三种单据共用同一状态机 OfficeApprovalStatus，均为单级店长审批，完全复用通用工作流引擎，
// reconcileStatus() 懒同步模式与 CommissionRecord/PayrollRecord 完全同构。
// 范围收窄：物品申领已由库存域 StockIssue(issueType=REQUISITION) 覆盖、退款已由
// Payment.requestRefund 覆盖，均不在此重复建模；请假是HR域明确延后的"请假管理"在此补上；
// 日常签呈(GeneralMemo)是标题+正文自由文本的兜底通用审批入口。

enum OfficeApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  SICK
  PERSONAL
  ANNUAL
  OTHER
}

model LeaveRequest {
  id                String               @id @default(cuid())
  tenantId          String               @map("tenant_id")
  storeId           String               @map("store_id")
  employeeProfileId String               @map("employee_profile_id")
  leaveType         LeaveType            @map("leave_type")
  startDate         DateTime             @map("start_date")
  endDate           DateTime             @map("end_date")
  reason            String               @db.Text
  status            OfficeApprovalStatus @default(DRAFT)
  cancelReason      String?              @map("cancel_reason") @db.Text
  createdBy         String               @map("created_by")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  version           Int                  @default(0)

  store           Store           @relation(fields: [storeId], references: [id])
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id])

  @@index([tenantId, storeId, status])
  @@map("leave_requests")
}

model ExpenseClaim {
  id           String               @id @default(cuid())
  tenantId     String               @map("tenant_id")
  storeId      String               @map("store_id")
  applicantId  String               @map("applicant_id")
  amount       Int // 最小货币单位（分）
  category     String // 自由文本，如 差旅/办公用品/招待
  reason       String               @db.Text
  status       OfficeApprovalStatus @default(DRAFT)
  cancelReason String?              @map("cancel_reason") @db.Text
  createdBy    String               @map("created_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  version      Int                  @default(0)

  store     Store   @relation(fields: [storeId], references: [id])
  applicant Account @relation(fields: [applicantId], references: [id])

  @@index([tenantId, storeId, status])
  @@map("expense_claims")
}

/// 兜底的通用审批入口：标题+正文自由文本，覆盖"以上都不是"的长尾审批需求。
model GeneralMemo {
  id           String               @id @default(cuid())
  tenantId     String               @map("tenant_id")
  storeId      String               @map("store_id")
  applicantId  String               @map("applicant_id")
  title        String
  content      String               @db.Text
  status       OfficeApprovalStatus @default(DRAFT)
  cancelReason String?              @map("cancel_reason") @db.Text
  createdBy    String               @map("created_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  version      Int                  @default(0)

  store     Store   @relation(fields: [storeId], references: [id])
  applicant Account @relation(fields: [applicantId], references: [id])

  @@index([tenantId, storeId, status])
  @@map("general_memos")
}

// ==================== 后勤管理（见业务规则确认记录#14/15/16） ====================
// 后勤仓库/物料复用 P3 库存域已有的 Warehouse/InventoryItem（purpose=LOGISTICS 区分），
// 不在此重复建模。本节只新增两块全新领域：车辆调度（集团层统一调度池+占用冲突检测）、
// 水电费登记（门店级运营费用，不做分摊）。

enum VehicleStatus {
  AVAILABLE
  MAINTENANCE
  RETIRED
}

/// 车辆不归属单一门店，任意门店可申请使用（集团层统一调度池，见#15）。
model Vehicle {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  plateNumber String        @map("plate_number")
  model       String
  status      VehicleStatus @default(AVAILABLE)
  remark      String?       @db.Text
  createdBy   String        @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  version     Int           @default(0)

  bookings VehicleBooking[]

  @@unique([tenantId, plateNumber])
  @@map("vehicles")
}

enum VehicleBookingStatus {
  BOOKED
  CANCELLED
}

/// 使用申请：仅做占用冲突检测（同一车辆的 [startTime, endTime) 不可与其他 BOOKED 记录重叠），
/// 不接入通用审批工作流——冲突检测本身就是唯一的准入门槛，呼应"集团层统一调度池"的定位。
model VehicleBooking {
  id           String               @id @default(cuid())
  tenantId     String               @map("tenant_id")
  vehicleId    String               @map("vehicle_id")
  storeId      String               @map("store_id")
  applicantId  String               @map("applicant_id")
  purpose      String               @db.Text
  startTime    DateTime             @map("start_time")
  endTime      DateTime             @map("end_time")
  status       VehicleBookingStatus @default(BOOKED)
  cancelReason String?              @map("cancel_reason") @db.Text
  createdBy    String               @map("created_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  version      Int                  @default(0)

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  store     Store   @relation(fields: [storeId], references: [id])
  applicant Account @relation(fields: [applicantId], references: [id])

  @@index([tenantId, vehicleId, status])
  @@map("vehicle_bookings")
}

enum UtilityExpenseType {
  ELECTRICITY
  WATER
  GAS
  PROPERTY_MANAGEMENT
  OTHER
}

/// 门店级运营费用登记，不做分摊到客户房费成本核算（见#16）。
model UtilityExpense {
  id          String             @id @default(cuid())
  tenantId    String             @map("tenant_id")
  storeId     String             @map("store_id")
  period      String // "YYYY-MM"
  expenseType UtilityExpenseType @map("expense_type")
  amount      Int // 最小货币单位（分）
  remark      String?            @db.Text
  createdBy   String             @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  version     Int                @default(0)

  store Store @relation(fields: [storeId], references: [id])

  @@unique([tenantId, storeId, period, expenseType])
  @@map("utility_expenses")
}

// ==================== AI / Agent 接入（P4，见《新系统开发文档》3.3节 + 业务规则确认记录#9/#10） ====================
// 首批2个Agent场景：智能客服/线索首触、护理异常预警建议。均由 NestJS 侧预先组装业务上下文后
// 调用 apps/ai-service 的模型网关做文本生成，不做自主多步工具调用（范围收窄见业务规则确认记录）。
// AI 只生成建议，不直接写业务库；护理场景强制人工确认后才写入正式护理记录，不支持一键采纳。

enum AiSuggestionScenario {
  CUSTOMER_SERVICE
  CARE_ABNORMALITY
  BUSINESS_ANALYTICS
}

enum AiSuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

/// 每次 Agent 调用的留痕审计记录：输入、输出、所用模型、耗时、是否被人工采纳，满足合规留痕要求。
model AiSuggestion {
  id            String               @id @default(cuid())
  tenantId      String               @map("tenant_id")
  storeId       String               @map("store_id")
  scenario      AiSuggestionScenario
  businessType  String               @map("business_type") // 如 LEAD/CUSTOMER/CARE_ABNORMALITY
  businessId    String               @map("business_id")
  inputText     String               @map("input_text") @db.Text // 发送给模型的完整上下文（脱敏后）
  outputText    String               @map("output_text") @db.Text
  modelProvider String               @map("model_provider") // volcengine/minimax
  modelName     String               @map("model_name")
  usedFallback  Boolean              @default(false) @map("used_fallback")
  latencyMs     Int                  @map("latency_ms")
  escalate      Boolean              @default(false) // 智能客服场景：是否建议转人工
  status        AiSuggestionStatus   @default(PENDING)
  acceptedById  String?              @map("accepted_by_id")
  acceptedAt    DateTime?            @map("accepted_at")
  createdBy     String               @map("created_by")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  version       Int                  @default(0)

  store      Store    @relation(fields: [storeId], references: [id])
  acceptedBy Account? @relation(fields: [acceptedById], references: [id])

  @@index([tenantId, storeId, scenario])
  @@index([tenantId, businessType, businessId])
  @@map("ai_suggestions")
}

// ==================== RAG 知识库（P4第二切片，见业务规则确认记录"P4 RAG知识库接入中"） ====================
// 只做"手动创建知识库文档"通用入口，不自动从ContractTemplate/CareFormTemplate等业务表同步。
// 不引入独立向量数据库：KnowledgeChunk.embedding 存为 JSON 数组，检索时应用层(NestJS)对该
// 租户全部chunk做暴力余弦相似度计算取top-K，量级小(V1几十到上百篇文档)下性能足够。
// 两个Agent场景（智能客服、护理异常预警建议）都会在生成前检索并把命中片段加入prompt。

/// 知识库文档：标题+正文，创建/更新时按固定长度分段并调用模型网关生成embedding写入KnowledgeChunk。
model KnowledgeDocument {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  title     String
  content   String       @db.Text
  category  String? // 自由文本分类，如 合同模板说明/护理规范/常见问题
  status    CommonStatus @default(ACTIVE)
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(0)

  chunks KnowledgeChunk[]

  @@index([tenantId, status])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  documentId String   @map("document_id")
  chunkIndex Int      @map("chunk_index")
  content    String   @db.Text
  embedding  Json // float[]，由模型网关的 /embeddings/create 生成
  createdAt  DateTime @default(now()) @map("created_at")

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@map("knowledge_chunks")
}

// ==================== IoT 设备网关（P4遗留补齐，见业务规则确认记录"P4遗留IoT设备网关框架补齐"） ====================
// V1不采购真实硬件，只搭建"设备网关"架构（设备台账 + Device Shadow期望态/上报态 + 事件流水 + 连接审计），
// 用前端"模拟设备事件"面板代替真实MQTT网关触发事件上报，验证"上报→业务记录自动生成"链路。
// 本轮只把两类设备事件接入真实业务表：呼叫/客房服务(CALL_SERVICE -> RoomCall)、
// 能耗计量(UTILITY_METER -> UtilityExpense按"门店+月份+费用类型"覆盖登记，语义是替代人工登记而非叠加流水)；
// 其余5类设备类别（体征监测/安防看护/门禁出入/身份结算/打印）本轮只做台账登记与事件留痕，不触发业务表写入。

enum DeviceCategory {
  VITAL_SIGN // 体征监测
  SECURITY // 安防看护
  ACCESS_CONTROL // 门禁出入
  CALL_SERVICE // 呼叫/客房服务
  IDENTITY_SETTLEMENT // 身份结算
  PRINTING // 打印
  UTILITY_METER // 能耗计量
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  DISABLED
}

enum DeviceConnectionLogType {
  ONLINE
  OFFLINE
  COMMAND_ISSUED
  COMMAND_CONFIRMED
}

/// 设备类型：协议/品类主数据，总部制定，同 room.type/care.field 口径不开放给 STORE_MANAGER。
model DeviceType {
  id                          String         @id @default(cuid())
  tenantId                    String         @map("tenant_id")
  category                    DeviceCategory
  name                        String
  protocol                    String // 自由文本，如 "MQTT"/"RTSP/MQTT"/"串口转HTTP"，对应开发文档接入协议列
  requiresCommandConfirmation Boolean        @default(false) @map("requires_command_confirmation") // 门禁/监控等敏感设备下发指令需二次确认
  status                      CommonStatus   @default(ACTIVE)
  createdBy                   String         @map("created_by")
  createdAt                   DateTime       @default(now()) @map("created_at")
  updatedAt                   DateTime       @updatedAt @map("updated_at")
  version                     Int            @default(0)

  devices Device[]

  @@unique([tenantId, name])
  @@map("device_types")
}

/// 设备台账：门店级物理设备实例，店长可自行登记维护（同 room.room/warehouse 口径）。
model Device {
  id           String       @id @default(cuid())
  tenantId     String       @map("tenant_id")
  storeId      String       @map("store_id")
  deviceTypeId String       @map("device_type_id")
  code         String // 设备编号
  name         String
  roomId       String?      @map("room_id") // 呼叫器/门禁等绑定具体房间；能耗计量总表等可不绑定
  status       DeviceStatus @default(OFFLINE)
  lastSeenAt   DateTime?    @map("last_seen_at")
  createdBy    String       @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  version      Int          @default(0)

  store          Store                 @relation(fields: [storeId], references: [id])
  deviceType     DeviceType            @relation(fields: [deviceTypeId], references: [id])
  room           Room?                 @relation(fields: [roomId], references: [id])
  shadow         DeviceShadow?
  events         DeviceEvent[]
  connectionLogs DeviceConnectionLog[]

  @@unique([tenantId, storeId, code])
  @@index([tenantId, storeId])
  @@map("devices")
}

/// Device Shadow：设备期望态(desired，网关下发指令写入)与上报态(reported，设备确认后写入)分离存储，
/// 网络不稳定时指令先存desired，设备恢复连接后再同步，核心业务不因设备离线中断（开发文档3.4节设计要点）。
model DeviceShadow {
  id              String    @id @default(cuid())
  deviceId        String    @unique @map("device_id")
  desiredState    Json?     @map("desired_state")
  desiredVersion  Int       @default(0) @map("desired_version")
  reportedState   Json?     @map("reported_state")
  reportedVersion Int       @default(0) @map("reported_version")
  lastCommandAt   DateTime? @map("last_command_at")
  lastReportedAt  DateTime? @map("last_reported_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_shadows")
}

/// 设备事件流水：模拟/真实网关上报的原始事件；processedAt/businessRefType/businessRefId记录是否
/// 及如何转换为正式业务记录，processingError记录转换失败原因（不静默丢弃，便于排查）。
model DeviceEvent {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  storeId         String    @map("store_id")
  deviceId        String    @map("device_id")
  eventType       String    @map("event_type")
  payload         Json
  occurredAt      DateTime  @default(now()) @map("occurred_at")
  processedAt     DateTime? @map("processed_at")
  businessRefType String?   @map("business_ref_type")
  businessRefId   String?   @map("business_ref_id")
  processingError String?   @map("processing_error") @db.Text
  createdBy       String    @map("created_by") // 本轮为模拟面板操作人；接入真实网关后可改为系统账号
  createdAt       DateTime  @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id])
  store  Store  @relation(fields: [storeId], references: [id])

  @@index([tenantId, deviceId])
  @@index([tenantId, storeId, occurredAt])
  @@map("device_events")
}

/// 设备接入审计：上下线、指令下发/确认记录留痕（开发文档"设备接入审计"要求）。
model DeviceConnectionLog {
  id        String                  @id @default(cuid())
  tenantId  String                  @map("tenant_id")
  storeId   String                  @map("store_id")
  deviceId  String                  @map("device_id")
  logType   DeviceConnectionLogType @map("log_type")
  detail    Json?
  createdBy String?                 @map("created_by")
  createdAt DateTime                @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id])
  store  Store  @relation(fields: [storeId], references: [id])

  @@index([tenantId, deviceId])
  @@map("device_connection_logs")
}
