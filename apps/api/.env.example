PORT=3000

# 本地开发数据库（docker-compose 提供）。本地用 root 是因为 Prisma Migrate 需要建 shadow database
# 的权限，banyuexuan 应用账号没有；生产环境改用腾讯云数据库连接串 + 权限受限的专用账号，
# 真实值只写在部署环境变量 / GitHub Secrets 里，绝不提交到仓库
DATABASE_URL=mysql://root:root@localhost:3306/banyuexuan_dev
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL_DAYS=14

# 仅供本地 seed 脚本创建演示账号使用，不是生产凭证
SEED_DEV_PASSWORD=change-me

# apps/ai-service 模型网关地址与服务间共享密钥，需与 apps/ai-service 的 .env 保持一致
AI_GATEWAY_BASE_URL=http://localhost:8000
AI_GATEWAY_INTERNAL_API_KEY=
