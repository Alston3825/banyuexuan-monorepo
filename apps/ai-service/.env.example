PORT=8000

# apps/api 与本服务之间的共享密钥（服务间认证，见业务规则确认记录"P4模型网关"章节）。
# 需要与 apps/api 的 AI_GATEWAY_INTERNAL_API_KEY 保持一致。开发环境可留空（放行）。
INTERNAL_API_KEY=

# 主/备供应商热切换顺序，取值 volcengine / minimax / deepseek。
# 只会用到已经配了对应Key的供应商——某个供应商Key没填就自动跳过，不用两个都配全。
PRIMARY_PROVIDER=volcengine
FALLBACK_PROVIDER=deepseek

# 火山引擎方舟(Ark)：母婴健康数据不允许出境，只接入境内合规供应商，真实值只写在
# 部署环境变量 / GitHub Secrets 里，绝不提交到仓库
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_ENDPOINT_ID=
# embedding 模型的推理接入点 ID（RAG知识库检索用，控制台单独创建），不填则该供应商不支持embedding
VOLCENGINE_EMBEDDING_ENDPOINT_ID=

# MiniMax
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=abab6.5s-chat
MINIMAX_EMBEDDING_MODEL=embo-01

# DeepSeek：只提供对话模型，没有embedding接口（RAG知识库检索还是要靠火山引擎/MiniMax）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
